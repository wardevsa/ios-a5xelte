<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For every app in apps/: in /Applications, as the system's own apps, without a data container or sandbox profile.
     (boot-apps1, boot-0332b: with HeroReddit there and none of these, lsd, containermanager and usermanagerd kept
     busy for as long as the phone ran, and SpringBoard with them.) -->
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-container</key><true/>
	<key>com.apple.private.security.no-sandbox</key><true/>
</dict>
</plist>
