 	 */
 	int mode = 1;
 	PE_parse_boot_argn("herotouch", &mode, sizeof(mode));
 	ht_apm_probe();
-	if (mode != 2) {
-		printf("HEROLTE TOUCH: PMIC power-on skipped (herotouch=2 tries the batcher)\n");
-		return;
