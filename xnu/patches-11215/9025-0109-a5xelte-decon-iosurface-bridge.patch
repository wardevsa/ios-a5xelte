-/*
- * selector 6, IOMobileFramebufferSwapWait(swap id) (0216). 0 = the swap is complete: its frame was latched by the MDP and
- * the surfaces it replaced are free again. Anything else (kIOReturnBusy since 0221) = still pending; CoreAnimation then asks
- * again every 100 us until its own timeout (swap_wait_timeout), so waiting here for up to a frame only saves it
- * the polling. The wait polls the CTL flush bits (a register read) every 250 us; when it sees them clear it kicks the
- * work loop (swapFired -> zcPoll) to release the holds and records the time as a real panel vsync (fPhaseAbs) when it
- * watched the bits go from set to clear. Not in copy mode (frames are paced by sweetfb_hz there), with the display off,
- * for ids that were never swapped, or with sweetfb_swapsync=0.
- */
-/*
- * Swap `id` may be answered "complete" (0217, one frame in flight): it was latched, or (depth 2) it is the frame now
- * queued for the panel and the frame scanned before it has latched. CoreAnimation then renders N+1 while N waits for the
- * vsync. What keeps N+1 off the surfaces still in use is not this call but the in-use hold (state page +0x18, read by
- * IOSurfaceIsInUse when CoreAnimation picks its next target): every scanned surface stays held from SwapEnd until the
- * frame that replaced it has latched (zcPoll), i.e. N and the frame on the panel are both held while N+1 is drawn.
- */
-bool
-AppleCLCD::swapReady(uint32_t id)
-{
-	uint32_t done = __atomic_load_n(&fSwapDone, __ATOMIC_ACQUIRE);
-	if ((int32_t)(done - id) >= 0) {
-		return true;
-	}
-	if (fSwapDepth >= 2) {
-		uint32_t scan = __atomic_load_n(&fSwapScanID, __ATOMIC_ACQUIRE);
-		uint32_t prev = __atomic_load_n(&fSwapPrevScan, __ATOMIC_ACQUIRE);
-		return scan == id && (int32_t)(done - prev) >= 0;
-	}
-	return false;
-}
