-		uint32_t sid = get32(rec, 0x54 + 4 * i);
-		if ((mask & (1u << i)) && sid != 0 && (held[i] = sweet_surface_copy(sid)) != NULL) {
-			sweet_hold(held[i], true);
-		}
-	}
-	IOLockLock(fLock);
-	fSt.swaps++;
-	fPendFence = sweet_gpu_fence_snapshot();
-	fPendAbs = mach_absolute_time();
-	__atomic_store_n(&fSwapNewest, get32(rec, 0x50), __ATOMIC_RELEASE);
