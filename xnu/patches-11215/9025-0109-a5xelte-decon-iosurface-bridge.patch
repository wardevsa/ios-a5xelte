-/*
- * Zero-copy scanout (patch 0127). A lone layer that is the whole canvas, in a
- * surface that SweetSurface placed in the low pool (contiguous, below 4 GiB:
- * SRC0_ADDR is 32 bit), is scanned where CoreAnimation drew it; QSEED3 scales
- * canvas -> panel exactly as for the copied frames. Needs the MDP's SMMU
- * streams verified in bypass (fZcOK), else every frame is declined and copied.
- * The surface stays held (IOSurfaceClientIsInUse, state page +0x18 as 0099)
- * and referenced until the MDP has latched a later frame: fZcHeld[0..fZcCount-1],
- * the last one is the newest. A held surface cannot be freed, so its pool block
- * cannot be reused under the scan (the pool also cools freed blocks).
- */
-/* The newest frame is on the panel: flush bits clear (twice, 20 us apart, with fLatchConfirm). */
-bool
-AppleCLCD::latchedNow(void)
-{
-	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH);
-	if (*flush & fLastFlush) {
-		return false;
-	}
-	if (fLatchConfirm) {
-		IODelay(20);
-		if (*flush & fLastFlush) {
-			return false;
-		}
-	}
-	return true;
-}
-
-/* Wait (sleeping) for the queued frame's latch, up to 20 ms, so it is not overwritten (0220). False: gave up. */
-bool
-AppleCLCD::waitReplace(void)
-{
-	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH);
-	uint64_t t0 = mach_absolute_time(), limit;
-	nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &limit);
-	fSt.replaceWaits++;
-	while (*flush & fLastFlush) {
-		if (mach_absolute_time() - t0 > limit) {
-			fSt.replaceTimeouts++;
-			return false;
-		}
-		delay_for_interval(200, NSEC_PER_USEC);
-	}
-	if (!latchedNow()) {
-		return waitReplace();   /* a glitch: the bits came back */
-	}
-	if (fGuardAbs != 0) {
-		uint64_t us = sweet_abs_us(fGuardAbs);
-		delay_for_interval((uint32_t)us, NSEC_PER_USEC);
-	}
-	return true;
-}
