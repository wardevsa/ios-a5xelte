-/*
- * A frame is queued (CTL flush bits set): poll for its latch every 500 us on the work loop, so the older surfaces are
- * released (zcPoll, at the top of swapFired) within half a millisecond of the vsync and the vsync phase is learned
- * (midpoint of the polling interval) without any caller having to wait for it.
- */
-void
-AppleCLCD::latchWatch(void)
-{
-	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH);
-	uint32_t lf = fLastFlush;
-	if (lf != 0 && (*flush & lf) != 0) {
-		fWatching = true;
-		fSwapTimer->setTimeoutUS(500);
-	} else if (fWatching) {
-		fWatching = false;
-		if (fVsyncAlign) {
-			uint64_t half;
-			nanoseconds_to_absolutetime(250 * NSEC_PER_USEC, &half);
-			uint64_t now = mach_absolute_time();
-			notePhase(now > half ? now - half : now);
-		}
-	}
-}
