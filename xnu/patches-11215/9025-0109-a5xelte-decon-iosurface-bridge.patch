-void
-AppleCLCD::zcPoll(bool force)
-{
-	if (fZcCount == 0 && !fSwapSync) {
-		return;
-	}
-	if (!latchedNow()) {
-		fLatchSeenAbs = 0;
-		return;         /* the newest frame is not on the panel yet */
-	}
-	if (fGuardAbs != 0 && !force) {
-		uint64_t now = mach_absolute_time();
-		if (fLatchSeenAbs == 0) {
-			fLatchSeenAbs = now;
-		}
-		if (now - fLatchSeenAbs < fGuardAbs) {
-			if (fSwapTimer != NULL) {
-				fSwapTimer->setTimeoutUS(300);  /* come back: the older surfaces are still guarded */
-			}
-			return;
-		}
-	}
-	/* the newest scan is on the panel: everything older is free; if a copied frame
-	 * replaced the pooled one, that one is free as well */
-	uint32_t keep = fZcFront ? fZcCount - 1 : fZcCount;
-	SweetSurface *newest = fZcFront && fZcCount != 0 ? fZcHeld[fZcCount - 1] : NULL;
-	for (uint32_t i = 0; i < keep; i++) {
-		sweet_hold(fZcHeld[i], false);
-		fZcHeld[i]->release();
-		fZcHeld[i] = NULL;
-	}
-	fZcHeld[0] = newest;
-	fZcHeld[1] = fZcHeld[2] = fZcHeld[3] = NULL;
-	fZcCount = newest != NULL ? 1 : 0;
-	/* 0216: only now (latched, older surfaces handed back) is the swap complete for SwapWait */
-	uint32_t scanned = __atomic_load_n(&fSwapScanID, __ATOMIC_ACQUIRE);
-	if ((int32_t)(scanned - fSwapDone) > 0) {
-		__atomic_store_n(&fSwapDone, scanned, __ATOMIC_RELEASE);
-		if (struct sweet_fb_trace_rec *tr = sweet_fb_trace_of(scanned)) {
-			tr->done = mach_absolute_time();
-			tr->latch = fLatchSeenAbs ? fLatchSeenAbs : tr->done;
-		}
-	}
-}
