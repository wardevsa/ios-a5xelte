-/*
- * Early (direct) path: runs on the work loop right after a swap. Takes the pending
- * frame like vsyncFired does, scans it in place when it can, and otherwise puts it
- * back (unless a newer swap arrived meanwhile) for the vsync tick's copy path. Never
- * copies: a copied frame is rate limited by sweetfb_hz, a scanned one is not.
- */
-/*
- * 0229: the pending swap is taken only once the GPU work submitted before it has completed (it may be drawing that very
- * framebuffer), or after 50 ms (a stuck GPU must not stop the display). Called with fLock held.
- */
-bool
-AppleCLCD::gpuGateOpen(uint64_t now)
-{
-	if (sweet_gpu_fence_passed(fPendFence)) {
-		return true;
-	}
-	uint64_t cap;
-	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &cap);
-	if (now - fPendAbs > cap) {
-		fSt.gpuHoldTimeouts++;
-		fPendFence = 0;
-		return true;
-	}
-	fSt.gpuHolds++;
-	return false;
-}
