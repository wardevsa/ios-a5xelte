-	{ "VIG0", 0x05000, 1u << 0, true },
-	{ "VIG1", 0x07000, 1u << 1, true },
-	{ "VIG2", 0x09000, 1u << 2, true },
-	{ "VIG3", 0x0b000, 1u << 18, true },
-	{ "DMA0", 0x25000, 1u << 11, false },
-	{ "DMA1", 0x27000, 1u << 12, false },
-	{ "DMA2", 0x29000, 1u << 24, false },
-	{ "DMA3", 0x2b000, 1u << 25, false },
-};
-#define SWEET_MDP_PA            0x0ae00000u
-#define SWEET_MDP_SIZE          0x82000u
-#define SWEET_MDP_CTL0          0x02000u
-#define SWEET_MDP_CTL_FLUSH     0x18u
-#define SWEET_MDP_CTL_BIT       (1u << 17)
-#define SWEET_MDP_LM0           0x45000u
-#define SWEET_MDP_INTF1         0x6b800u
-#define SSPP_SRC_SIZE           0x00u
-#define SSPP_SRC_IMG_SIZE       0x04u
-#define SSPP_SRC_XY             0x08u
-#define SSPP_OUT_SIZE           0x0cu
-#define SSPP_OUT_XY             0x10u
-#define SSPP_SRC0_ADDR          0x14u
-#define SSPP_YSTRIDE0           0x24u
-#define SSPP_SRC_FORMAT         0x30u
-#define SSPP_OP_MODE            0x38u
-#define SSPP_PE_C0_LR           0x100u  /* SW pixel extension, rect 0: C0 (G/Y), C1C2, C3 (alpha) */
-#define SSPP_PE_C0_TB           0x104u
-#define SSPP_PE_C0_REQ          0x108u
-#define SSPP_PE_C12_LR          0x110u
-#define SSPP_PE_C12_TB          0x114u
-#define SSPP_PE_C12_REQ         0x118u
-#define SSPP_PE_C3_LR           0x120u
-#define SSPP_PE_C3_TB           0x124u
-#define SSPP_PE_C3_REQ          0x128u
-/* QSEED3 (VIG pipe + 0xa00; Linux dpu_hw_util.c QSEED3_*) */
-#define QSEED3_BASE             0xa00u
-#define QSEED3_HW_VERSION       0x00u
-#define QSEED3_OP_MODE          0x04u
-#define QSEED3_PHASE_INIT       0x0cu   /* version 0x1002 only */
-#define QSEED3_PHASE_STEP_Y_H   0x10u
-#define QSEED3_PHASE_STEP_Y_V   0x14u
-#define QSEED3_PHASE_STEP_UV_H  0x18u
-#define QSEED3_PHASE_STEP_UV_V  0x1cu
-#define QSEED3_PRELOAD          0x20u
-#define QSEED3_SRC_SIZE_Y_RGB_A 0x40u
-#define QSEED3_SRC_SIZE_UV      0x44u
-#define QSEED3_DST_SIZE         0x48u
-#define QSEED3_PHASE_INIT_Y_H   0x90u
-#define QSEED3_PHASE_INIT_Y_V   0x94u
-#define QSEED3_PHASE_INIT_UV_H  0x98u
-#define QSEED3_PHASE_INIT_UV_V  0x9cu
-#define SWEET_MDP_LM_BORDER0    0x08u   /* LM0 +0x08 / +0x10, flushed with CTL_FLUSH BIT(6) (LM_0) */
-#define SWEET_MDP_LM_BORDER1    0x10u
-#define SWEET_MDP_LM0_FLUSH     (1u << 6)
-#define SSPP_SRC_UNPACK         0x34u   /* HUD layer (patch 0213) */
-#define SSPP_DANGER_LUT         0x60u   /* DANGER, SAFE, CREQ LUTs and QOS_CTRL, cloned from the base pipe */
-#define SSPP_QOS_CTRL           0x6cu
-#define SWEET_MDP_LM_BLEND0     0x20u   /* LM0 blend block of stage 0 (sdm845 blendstage_base 0x20, 0x38, 0x50 ...) */
-#define SWEET_MDP_LM_BLEND_STRIDE 0x18u
-
-/*
- * panic: put back everything the page flipper / scaler changed, so ABL's
- * framebuffer (where the console draws) is scanned 1:1 again. A table of
- * (offset from the MDP base, boot value) filled before the first change;
- * plain MMIO writes, no locks (panic context).
- */
-#define SWEET_MDP_RESTORE_MAX   56
-static struct {
-	vm_offset_t base;
-	uint32_t    n, flush;
-	struct { uint32_t off, val; } r[SWEET_MDP_RESTORE_MAX];
-} sweet_mdp_restore;
-
-static void
-sweet_mdp_restore_apply(void)
-{
-	for (uint32_t i = 0; i < sweet_mdp_restore.n; i++) {
-		*(volatile uint32_t *)(sweet_mdp_restore.base + sweet_mdp_restore.r[i].off) =
-		    sweet_mdp_restore.r[i].val;
-	}
-}
-
-static void
-sweet_fb_restore_boot_scanout(void)
-{
-	if (sweet_mdp_restore.base == 0) {
-		return;
-	}
-	sweet_mdp_restore_apply();
-	__asm__ volatile ("dsb sy" ::: "memory");
-	*(volatile uint32_t *)(sweet_mdp_restore.base + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH) =
-	    sweet_mdp_restore.flush;
-	__asm__ volatile ("dsb sy" ::: "memory");
-}
-
-static inline void
-mdp_wr(vm_offset_t base, uint32_t off, uint32_t val)
-{
-	*(volatile uint32_t *)(base + off) = val;
-}
-
-static inline uint32_t
-mdp_rd(vm_offset_t base, uint32_t off)
-{
-	uint32_t v = *(volatile uint32_t *)(base + off);
-	__asm__ volatile ("dmb oshld" ::: "memory");
-	return v;
-}
-
-/* Read-only: which pipe scans ABL's framebuffer, and the display path state. */
-void
-AppleCLCD::mdpProbe(void)
-{
-	fMdp = ml_io_map(SWEET_MDP_PA, SWEET_MDP_SIZE);
-	if (fMdp == 0) {
-		IOLog("SWEET MDP: map failed\n");
-		return;
-	}
-	for (uint32_t i = 0; i < sizeof(sweet_mdp_pipes) / sizeof(sweet_mdp_pipes[0]); i++) {
-		vm_offset_t p = fMdp + sweet_mdp_pipes[i].off;
-		uint32_t src = mdp_rd(p, SSPP_SRC0_ADDR), stride = mdp_rd(p, SSPP_YSTRIDE0);
-		IOLog("SWEET MDP: %s src0 0x%08x stride 0x%x size 0x%08x out 0x%08x fmt 0x%08x op 0x%08x%s\n",
-		    sweet_mdp_pipes[i].name, src, stride, mdp_rd(p, SSPP_SRC_SIZE), mdp_rd(p, SSPP_OUT_SIZE),
-		    mdp_rd(p, SSPP_SRC_FORMAT), mdp_rd(p, SSPP_OP_MODE),
-		    src == (uint32_t)fPhys ? "  <- boot framebuffer" : "");
-		if (sweet_mdp_pipes[i].vig) {
-			IOLog("SWEET MDP: %s qseed3 ver 0x%08x op 0x%08x\n", sweet_mdp_pipes[i].name,
-			    mdp_rd(p, QSEED3_BASE + QSEED3_HW_VERSION), mdp_rd(p, QSEED3_BASE + QSEED3_OP_MODE));
-		}
-		if (src == (uint32_t)fPhys && fPipe < 0) {
-			fPipe = (int)i;
-			fBootSrc = src;
-			fBootStride = stride;
-		}
-	}
-	if (fPipe >= 0) {
-		vm_offset_t p = fMdp + sweet_mdp_pipes[fPipe].off;
-		fQseedVer = sweet_mdp_pipes[fPipe].vig ? mdp_rd(p, QSEED3_BASE + QSEED3_HW_VERSION) : 0;
-		IOLog("SWEET MDP: %s img 0x%08x xy 0x%08x outxy 0x%08x pe c0 %08x %08x %08x c12 %08x %08x %08x c3 %08x %08x %08x\n",
-		    sweet_mdp_pipes[fPipe].name, mdp_rd(p, SSPP_SRC_IMG_SIZE), mdp_rd(p, SSPP_SRC_XY),
-		    mdp_rd(p, SSPP_OUT_XY), mdp_rd(p, SSPP_PE_C0_LR), mdp_rd(p, SSPP_PE_C0_TB),
-		    mdp_rd(p, SSPP_PE_C0_REQ), mdp_rd(p, SSPP_PE_C12_LR), mdp_rd(p, SSPP_PE_C12_TB),
-		    mdp_rd(p, SSPP_PE_C12_REQ), mdp_rd(p, SSPP_PE_C3_LR), mdp_rd(p, SSPP_PE_C3_TB),
-		    mdp_rd(p, SSPP_PE_C3_REQ));
-	}
-	fBorder0 = mdp_rd(fMdp + SWEET_MDP_LM0, SWEET_MDP_LM_BORDER0);
-	fBorder1 = mdp_rd(fMdp + SWEET_MDP_LM0, SWEET_MDP_LM_BORDER1);
-	vm_offset_t ctl = fMdp + SWEET_MDP_CTL0;
-	IOLog("SWEET MDP: CTL0 layer0 0x%08x 0x%08x 0x%08x 0x%08x top 0x%08x flush 0x%08x; LM0 out 0x%08x border 0x%08x 0x%08x\n",
-	    mdp_rd(ctl, 0x00), mdp_rd(ctl, 0x04), mdp_rd(ctl, 0x08), mdp_rd(ctl, 0x0c), mdp_rd(ctl, 0x14),
-	    mdp_rd(ctl, SWEET_MDP_CTL_FLUSH), mdp_rd(fMdp + SWEET_MDP_LM0, 0x04), fBorder0, fBorder1);
-	uint32_t f0 = mdp_rd(fMdp + SWEET_MDP_INTF1, 0xac);
-	IODelay(100000);
-	uint32_t f1 = mdp_rd(fMdp + SWEET_MDP_INTF1, 0xac);
-	IOLog("SWEET MDP: INTF1 frame count %u -> %u in 100 ms (line count en 0x%x); pipe %s\n",
-	    f0, f1, mdp_rd(fMdp + SWEET_MDP_INTF1, 0xa8),
-	    fPipe >= 0 ? sweet_mdp_pipes[fPipe].name : "NOT FOUND");
-}
