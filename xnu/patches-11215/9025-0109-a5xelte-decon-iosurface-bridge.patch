-/*
- * Scan the buffer at pa (stride in bytes, 32-bit physical): hwFrame = a canvas
- * the scaler stretches, else a panel-sized frame 1:1. Latched at the next vsync.
- */
-void
-AppleCLCD::scanAddr(uint32_t pa, uint32_t stride, bool hwFrame)
-{
-	volatile uint32_t *p = (volatile uint32_t *)(fMdp + sweet_mdp_pipes[fPipe].off);
-
-	if (hwFrame && !fHwOn) {
-		hwProgram();
-		fHwOn = true;
-	} else if (!hwFrame && fHwOn) {
-		sweet_mdp_restore_apply();      /* boot geometry, scaler off (address/stride follow below) */
-		fHwOn = false;
-		fHudLayerOn = false;    /* the table put the boot mixer layer config back: the HUD stage is gone (patch 0213) */
-		fLmPending = fBorderFix;
-	}
-	if (fLastFlush != 0 &&
-	    (*(volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH) & fLastFlush) != 0) {
-		fSt.scanReplaced++;     /* the previous address was still waiting for its vsync: that frame is never shown */
-	}
-	if (fCurSwapID != fSwapScanID) {
-		__atomic_store_n(&fSwapPrevScan, fSwapScanID, __ATOMIC_RELEASE);        /* the frame before this one (it is, or was, on the panel) */
-	}
-	fLatchSeenAbs = 0;      /* a new frame is queued: the release guard starts over at its latch */
-	fScanForeign = true;    /* 0235: scanCopyPresent clears it right after its own scanAddr */
-	__atomic_store_n(&fSwapScanID, fCurSwapID, __ATOMIC_RELEASE);   /* before the flush: a poller that sees it clear sees this id */
-	if (struct sweet_fb_trace_rec *tr = sweet_fb_trace_of(fCurSwapID)) {
-		tr->scan = mach_absolute_time();
-	}
-	__asm__ volatile ("dsb sy" ::: "memory");      /* WC writes of the frame land first */
-	p[SSPP_SRC0_ADDR / 4] = pa;
-	p[SSPP_YSTRIDE0 / 4] = stride;
-	__asm__ volatile ("dsb sy" ::: "memory");
-	uint32_t fl = sweet_mdp_pipes[fPipe].flush | SWEET_MDP_CTL_BIT | (fLmPending ? SWEET_MDP_LM0_FLUSH : 0);
-	fLmPending = false;
-	*(volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH) = fl;
-	__asm__ volatile ("dsb sy" ::: "memory");
-	fLastFlush = fl;
-}
