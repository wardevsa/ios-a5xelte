-/* Show back buffer idx (0 = ABL's framebuffer): latched by the MDP at the next panel vsync. */
-void
-AppleCLCD::scanTo(uint32_t idx)
-{
-	bool hwFrame = fHw && idx != 0;
-	scanAddr((uint32_t)fBufPA[idx], hwFrame ? fHwStride : ((fBootStride & 0xffff0000u) | fRowBytes), hwFrame);
-	fFront = idx;
-	fZcFront = false;       /* the scan left the pooled surface (zcPoll lets go once this latched) */
-	fScanFront = false;
-}
