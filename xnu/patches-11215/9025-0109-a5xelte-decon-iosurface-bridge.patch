-		struct sweet_fb_trace_rec *tr = &sweet_fb_trace[get32(rec, 0x50) & (SWEET_FB_TRACE_N - 1)];
-		bzero(tr, sizeof(*tr));
-		tr->id = get32(rec, 0x50);
-		tr->swap = mach_absolute_time();
-	}
-	if (fDirty) {
-		fSt.coalesced++;        /* the previous swap never reached the panel */
-	}
-	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
-	fDirty = true;
-	memcpy(dropped, fPendHold, sizeof(dropped));     /* replaced before it was copied */
-	memcpy(fPendHold, held, sizeof(held));
-	IOLockUnlock(fLock);
-	sweet_hold_release(dropped);
