-void
-AppleCLCD::swapFired(OSObject *owner, IOTimerEventSource *)
-{
-	AppleCLCD *fb = (AppleCLCD *)owner;
-	SweetSurface *taken[4] = {};
-
-	if (fb->fPowerOff) {
-		return;         /* the vsync tick runs the backlight ramp and redraws on power on */
-	}
-	fb->zcPoll();           /* 0216: also kicked by SwapWait when it saw the latch, so the frame it waited for is released now */
-	fb->scanBlitPoll();     /* 0241: a GPU scan-out copy whose fence passed is scanned now */
-	fb->latchWatch();       /* 0217: while a frame is queued this timer comes back every 500 us */
-	IOLockLock(fb->fLock);
-	if (!fb->fDirty) {
-		IOLockUnlock(fb->fLock);
-		return;
-	}
-	/* 0241: the GPU scan-out copy needs no hold: it is queued behind the frame's own GPU work on the same ring */
-	if (!fb->scanGpuActive() && !fb->gpuGateOpen(mach_absolute_time())) {
-		IOLockUnlock(fb->fLock);
-		fb->fSwapTimer->setTimeoutUS(250);      /* 0229: the GPU is still drawing what was submitted before this swap */
-		return;
-	}
-	memcpy(fb->fEarlyRec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
-	fb->fDirty = false;
-	memcpy(taken, fb->fPendHold, sizeof(taken));
-	bzero(fb->fPendHold, sizeof(fb->fPendHold));
-	IOLockUnlock(fb->fLock);
-
-	fb->quietConsole();
-	if (fb->zcPresent(fb->fEarlyRec, get32(fb->fEarlyRec, 0x104))) {
-		sweet_hold_release(taken);      /* zcPresent holds the surface itself until its frame latched */
-		fb->latchWatch();
-		return;
-	}
-	SweetSurface *dropped[4] = {};
-	IOLockLock(fb->fLock);
-	if (!fb->fDirty) {
-		memcpy(fb->fPending, fb->fEarlyRec, SWEET_FB_SWAP_REC_SIZE);
-		fb->fDirty = true;
-		memcpy(fb->fPendHold, taken, sizeof(taken));
-	} else {
-		memcpy(dropped, taken, sizeof(dropped));        /* a newer swap replaced it while we looked */
-		fb->fSt.coalesced++;
-	}
-	IOLockUnlock(fb->fLock);
-	sweet_hold_release(dropped);
-}
