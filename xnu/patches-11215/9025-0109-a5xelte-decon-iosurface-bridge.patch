-/*
- * Hardware scaling decision (sweetfb_hw=1): VIG pipe with QSEED3 v1.2/1.3,
- * a scale mode that has something to scale, a destination rectangle equal to
- * the one the CPU scaler (and the touch mapping) uses, and scaling ratios the
- * scaler takes (Linux QSEED3: downscale < 4x). Pure arithmetic, no MMIO.
- */
-bool
-AppleCLCD::hwSetup(void)
-{
-	if (fPipe < 0 || !sweet_mdp_pipes[fPipe].vig) {
-		IOLog("SWEET FB: hw scaler: boot pipe is not a VIG pipe; CPU scaling\n");
-		return false;
-	}
-	if (fQseedVer != 0x1002 && fQseedVer != 0x1003) {
-		IOLog("SWEET FB: hw scaler: QSEED3 version 0x%x not handled; CPU scaling\n", fQseedVer);
-		return false;
-	}
-	if (fScale == 0 || fXMap == NULL) {
-		IOLog("SWEET FB: hw scaler: needs sweetfb_scale=1 (fit) or 2 (stretch) with a canvas that is not the panel size; CPU path\n");
-		return false;
-	}
-	uint64_t dw = (uint64_t)fLogicalW * fScaleXNum / fScaleXDen;
-	uint64_t dh = (uint64_t)fLogicalH * fScaleYNum / fScaleYDen;
-	if (dw == 0 || dh == 0 || dw > fWidth || dh > fHeight || fLogicalW > 2560 || fLogicalH > 4096 ||
-	    ((uint64_t)fLogicalW << 21) / dw >= (4ull << 21) || ((uint64_t)fLogicalH << 21) / dh >= (4ull << 21)) {
-		IOLog("SWEET FB: hw scaler: canvas %ux%u -> %llux%llu outside the scaler's range; CPU scaling\n",
-		    fLogicalW, fLogicalH, dw, dh);
-		return false;
-	}
-	fHwDstW = (uint32_t)dw;
-	fHwDstH = (uint32_t)dh;
-	fHwDstX = (uint32_t)(fPadX < 0 ? 0 : fPadX);
-	fHwDstY = (uint32_t)(fPadY < 0 ? 0 : fPadY);
-	fHwStride = (fLogicalW * 4 + 63) & ~63u;
-	int pe = 1;
-	PE_parse_boot_argn("sweetfb_hwpe", &pe, sizeof(pe));
-	fHwPE = pe != 0;
-	/*
-	 * sweetfb_hwfilter (patch 0129): 1 (default) = bilinear, QSEED3 Y/RGB filter field 3 =
-	 * Linux DPU_SCALE_BIL (the enum is 2D_4X4=0, CIR=1, SEP=2, BIL=3: 0126 wrote 1 = circular
-	 * LUT filter with no LUT loaded). 0 = field 0 (2D 4x4, edge directed), 2 = field 2 (1D
-	 * separable), 3 = field 1 (circular); all three read coefficient RAM that nobody loads
-	 * (Linux uploads nothing for the default bilinear), so they are diagnostics only.
-	 */
-	int hf = 1;
-	PE_parse_boot_argn("sweetfb_hwfilter", &hf, sizeof(hf));
-	fHwFilter = (hf < 0 || hf > 3) ? 1u : (uint32_t)hf;
-	int hd = 0;
-	PE_parse_boot_argn("sweetfb_hwdump", &hd, sizeof(hd));
-	fHwDump = hd != 0;
-	/* the margins of a fit come from the mixer's border colour: must be black */
-	fBorderFix = (fHwDstW < fWidth || fHwDstH < fHeight) && (fBorder0 | fBorder1) != 0;
-	IOLog("SWEET FB: hw scaler: canvas %ux%u (stride %u) -> %ux%u at %u,%u in the %ux%u panel, phase step 0x%x/0x%x, qseed3 v0x%x, PE regs %s, border fix %s\n",
-	    fLogicalW, fLogicalH, fHwStride, fHwDstW, fHwDstH, fHwDstX, fHwDstY, fWidth, fHeight,
-	    (uint32_t)(((uint64_t)fLogicalW << 21) / fHwDstW), (uint32_t)(((uint64_t)fLogicalH << 21) / fHwDstH),
-	    fQseedVer, fHwPE ? "written" : "left alone (sweetfb_hwpe=0)", fBorderFix ? "yes (LM0 border -> black)" : "no");
-	return true;
-}
-
-/*
- * Program the source pipe to scan a canvas-sized buffer and scale it into the
- * panel rectangle. Nothing takes effect before the CTL flush that scanAddr()
- * does next. Linux: dpu_hw_setup_rects_impl (SRC_SIZE/XY, OUT_SIZE/XY),
- * dpu_hw_sspp_setup_pe_config (zero extension, REQ_PIXELS = source size),
- * dpu_hw_setup_scaler3 with the defaults of _dpu_plane_setup_scaler3
- * (bilinear, lut_flag 0, blend_cfg 1, preload 4/3, init phase 0).
- */
-void
-AppleCLCD::hwProgram(void)
-{
-	vm_offset_t p = fMdp + sweet_mdp_pipes[fPipe].off, q = p + QSEED3_BASE;
-	uint32_t src = (fLogicalH << 16) | fLogicalW;
-	uint32_t dst = (fHwDstH << 16) | fHwDstW;
-	uint32_t stepx = (uint32_t)(((uint64_t)fLogicalW << 21) / fHwDstW) & 0xffffffu;
-	uint32_t stepy = (uint32_t)(((uint64_t)fLogicalH << 21) / fHwDstH) & 0xffffffu;
-	bool alpha = (mdp_rd(p, SSPP_SRC_FORMAT) >> 8) & 1;     /* ALPHA_ENABLE of ABL's format */
-
-	mdp_wr(p, SSPP_SRC_SIZE, src);
-	mdp_wr(p, SSPP_SRC_IMG_SIZE, src);
-	mdp_wr(p, SSPP_SRC_XY, 0);
-	mdp_wr(p, SSPP_OUT_SIZE, dst);
-	mdp_wr(p, SSPP_OUT_XY, (fHwDstY << 16) | fHwDstX);
-	if (fHwPE) {
-		mdp_wr(p, SSPP_PE_C0_LR, 0);
-		mdp_wr(p, SSPP_PE_C0_TB, 0);
-		mdp_wr(p, SSPP_PE_C0_REQ, src);
-		mdp_wr(p, SSPP_PE_C12_LR, 0);
-		mdp_wr(p, SSPP_PE_C12_TB, 0);
-		mdp_wr(p, SSPP_PE_C12_REQ, src);
-		mdp_wr(p, SSPP_PE_C3_LR, 0);
-		mdp_wr(p, SSPP_PE_C3_TB, 0);
-		mdp_wr(p, SSPP_PE_C3_REQ, src);
-	}
-	if (fQseedVer == 0x1002) {
-		mdp_wr(q, QSEED3_PHASE_INIT, 0);
-	} else {
-		mdp_wr(q, QSEED3_PHASE_INIT_Y_H, 0);
-		mdp_wr(q, QSEED3_PHASE_INIT_Y_V, 0);
-		mdp_wr(q, QSEED3_PHASE_INIT_UV_H, 0);
-		mdp_wr(q, QSEED3_PHASE_INIT_UV_V, 0);
-	}
-	mdp_wr(q, QSEED3_PHASE_STEP_Y_H, stepx);
-	mdp_wr(q, QSEED3_PHASE_STEP_Y_V, stepy);
-	mdp_wr(q, QSEED3_PHASE_STEP_UV_H, stepx);       /* the alpha channel runs on the second set */
-	mdp_wr(q, QSEED3_PHASE_STEP_UV_V, stepy);
-	mdp_wr(q, QSEED3_PRELOAD, 4u | (3u << 8) | (4u << 16) | (3u << 24));
-	mdp_wr(q, QSEED3_SRC_SIZE_Y_RGB_A, src);
-	mdp_wr(q, QSEED3_SRC_SIZE_UV, src);
-	mdp_wr(q, QSEED3_DST_SIZE, dst);
-	/* op_mode bits 17:16 = y_rgb_filter_cfg: enum dpu_hw_filter_yuv 2D_4X4 0, CIR 1, 1D_SEP 2, BIL 3 */
-	static const uint32_t filterField[4] = { 0, 3, 2, 1 };  /* sweetfb_hwfilter 0..3 */
-	uint32_t op = (1u << 0) |                       /* enable */
-	    (filterField[fHwFilter] << 16) |
-	    (1u << 14) |                                /* not a DX format */
-	    (1u << 31);                                 /* blend_cfg */
-	if (alpha) {
-		op |= (1u << 10) | (fQseedVer == 0x1002 ? (1u << 30) : (1u << 29));     /* alpha scaling, bilinear */
-	}
-	mdp_wr(q, QSEED3_OP_MODE, op);
-	if (fBorderFix) {
-		mdp_wr(fMdp + SWEET_MDP_LM0, SWEET_MDP_LM_BORDER0, 0);
-		mdp_wr(fMdp + SWEET_MDP_LM0, SWEET_MDP_LM_BORDER1, 0);
-		fLmPending = true;
-	}
-	static bool told;
-	if (!told) {
-		told = true;
-		IOLog("SWEET FB: hw scaler programmed: src %ux%u dst %ux%u at %u,%u, qseed3 op 0x%x steps 0x%x/0x%x%s\n",
-		    fLogicalW, fLogicalH, fHwDstW, fHwDstH, fHwDstX, fHwDstY, op, stepx, stepy,
-		    alpha ? " (alpha)" : "");
-		IOLog("SWEET FB: qseed3 written (v0x%x, hwfilter %u = Y/RGB field %u%s): SRC_SIZE 0x%08x OUT_SIZE 0x%08x OUT_XY 0x%08x PE %s (c0/c12/c3 LR 0 TB 0 REQ 0x%08x)\n",
-		    fQseedVer, fHwFilter, filterField[fHwFilter],
-		    fHwFilter == 1 ? ", bilinear" : " (no LUT loaded: diagnostic)", src, dst,
-		    (fHwDstY << 16) | fHwDstX, fHwPE ? "written" : "untouched", src);
-		IOLog("SWEET FB: qseed3 written: PHASE_INIT 0 (all, Y_H/Y_V/UV_H/UV_V%s) STEP_Y 0x%06x/0x%06x STEP_UV 0x%06x/0x%06x PRELOAD 0x%08x SRC_Y 0x%08x SRC_UV 0x%08x DST 0x%08x OP 0x%08x (en 1, filter %u<<16, non-DX, blend 1, dir_en 0, DE off, lut_flag 0%s)\n",
-		    fQseedVer == 0x1002 ? " via PHASE_INIT" : "", stepx, stepy, stepx, stepy,
-		    4u | (3u << 8) | (4u << 16) | (3u << 24), src, src, dst, op, filterField[fHwFilter],
-		    alpha ? (fQseedVer == 0x1002 ? ", alpha bilinear bit30" : ", alpha bilinear bit29") : ", no alpha");
-		if (fHwDump) {
-			static const uint32_t regs[] = { 0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x1c, 0x20,
-			    0x24, 0x28, 0x2c, 0x30, 0x34, 0x38, 0x3c, 0x40, 0x44, 0x48, 0x4c, 0x50,
-			    0x90, 0x94, 0x98, 0x9c };
-			for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
-				IOLog("SWEET FB: qseed3 readback +0x%02x = 0x%08x\n", regs[i], mdp_rd(q, regs[i]));
-			}
-			/* first words of the five coefficient tables (Linux off_tbl region 0): is the LUT RAM populated? */
-			static const uint32_t luts[5] = { 0x000, 0x320, 0x500, 0x380, 0x560 };
-			for (unsigned i = 0; i < 5; i++) {
-				IOLog("SWEET FB: qseed3 lut%u @0x%03x: %08x %08x %08x %08x\n", i, 0x100 + luts[i],
-				    mdp_rd(q, 0x100 + luts[i]), mdp_rd(q, 0x104 + luts[i]),
-				    mdp_rd(q, 0x108 + luts[i]), mdp_rd(q, 0x10c + luts[i]));
-			}
-		}
-	}
-}
-
-/*
- * Frames: 0 is ABL's own framebuffer (console, panics), 1 and 2 back buffers
- * after it, inside cont_splash_region (36 MiB). With the hardware scaler the
- * back buffers hold the canvas (fHwStride * fLogicalH, ~11 MB at @3x) and are
- * spaced a canvas apart: 0x9d400000, +10 MiB, +21 MiB, +32 MiB end < +36 MiB.
- */
-bool
-AppleCLCD::flipSetup(void)
-{
-	const uint64_t region_end = (uint64_t)fPhys + 0x2400000u;
-	uint64_t panel = (uint64_t)fRowBytes * fHeight;
-	uint64_t bytes = fHw ? (uint64_t)fHwStride * fLogicalH : panel;
-	uint64_t first = (panel + 0xfffffu) & ~0xfffffull;
-	uint64_t slot = ((bytes > panel ? bytes : panel) + 0xfffffu) & ~0xfffffull;
-	fBufPA[0] = fPhys;
-	fBufVA[0] = fPixels;
-	for (uint32_t i = 1; i < 3; i++) {
-		fBufPA[i] = (uint64_t)fPhys + first + slot * (i - 1);
-		if (fBufPA[i] + bytes > region_end || (fBufPA[i] >> 32)) {
-			return false;
-		}
-		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(fBufPA[i],
-		    (IOByteCount)bytes, kIODirectionInOut);
-		if (md == NULL) {
-			return false;
-		}
-		fBufMap[i] = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
-		md->release();
-		if (fBufMap[i] == NULL) {
-			return false;
-		}
-		fBufVA[i] = (uintptr_t)fBufMap[i]->getVirtualAddress();
-		if (fHw) {
-			bzero((void *)fBufVA[i], (size_t)bytes);
-		} else {
-			memcpy((void *)fBufVA[i], (const void *)fPixels, (size_t)bytes);
-		}
-	}
-	/* boot state to come back to (panic, power-off): read before anything is written */
-	uint32_t po = sweet_mdp_pipes[fPipe].off;
-	sweet_mdp_restore.base = fMdp;
-	sweet_mdp_restore.n = 0;
-	sweet_mdp_restore.flush = sweet_mdp_pipes[fPipe].flush | SWEET_MDP_CTL_BIT;
-#define SWEET_RESTORE_ADD(o) do { \
-	if (sweet_mdp_restore.n < SWEET_MDP_RESTORE_MAX) { \
-	        sweet_mdp_restore.r[sweet_mdp_restore.n].off = (o); \
-	        sweet_mdp_restore.r[sweet_mdp_restore.n].val = mdp_rd(fMdp, (o)); \
-	        sweet_mdp_restore.n++; \
-	} } while (0)
-	if (fHw) {
-		static const uint16_t pipe_regs[] = {
-			SSPP_SRC_SIZE, SSPP_SRC_IMG_SIZE, SSPP_SRC_XY, SSPP_OUT_SIZE, SSPP_OUT_XY,
