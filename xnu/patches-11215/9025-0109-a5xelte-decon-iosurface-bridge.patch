-/*
- * Clean (not invalidate) a CPU-written range to the point of coherency: the
- * MDP reads DRAM. This build is __ARM_COHERENT_IO__, where the kernel's own
- * flush_dcache64/clean_dcache64 are bare "dsb sy", so it is done by hand.
- * dc cvac keeps the lines valid: CoreAnimation's next partial redraw of the
- * surface still hits the cache.
- */
-static void
-sweet_dcache_clean_va(const void *va, size_t len)
-{
-	uint64_t ctr;
-	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
-	uintptr_t line = (uintptr_t)4 << ((ctr >> 16) & 0xf);   /* DminLine */
-	uintptr_t p = (uintptr_t)va & ~(line - 1);
-	uintptr_t end = (uintptr_t)va + len;
-
-	__asm__ volatile ("dsb sy" ::: "memory");
-	for (; p < end; p += line) {
-		__asm__ volatile ("dc cvac, %0" :: "r"(p) : "memory");
-	}
-	__asm__ volatile ("dsb sy" ::: "memory");
-}
