-/* vsync phase observation: low-pass the jitter of the polling (a quarter of the difference to the prediction per sample). */
-void
-AppleCLCD::notePhase(uint64_t obs)
-{
-	uint64_t old = __atomic_load_n(&fPhaseAbs, __ATOMIC_ACQUIRE), second;
-	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
-	if (fPeriodAbs == 0) {
-		nanoseconds_to_absolutetime((uint64_t)fVsyncUS * 1000, &fPeriodAbs);
-	}
-	uint64_t per = fPeriodAbs;
-	if (old == 0 || per == 0 || obs <= old || obs - old > second || !fVsyncSmooth) {
-		__atomic_store_n(&fPhaseAbs, obs, __ATOMIC_RELEASE);
-		return;
-	}
-	uint64_t n = (obs - old) / per;
-	int64_t r = (int64_t)((obs - old) - n * per);
-	if (r > (int64_t)(per / 2)) {
-		r -= (int64_t)per;
-		n++;
-	}
-	__atomic_store_n(&fPhaseAbs, (uint64_t)((int64_t)(old + n * per) + (fVsyncSmooth ? r / 4 : r)), __ATOMIC_RELEASE);
-}
