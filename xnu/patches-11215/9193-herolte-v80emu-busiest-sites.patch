+/*
+ * (9193) The busiest sites, into the console (the persistent log) every minute from herolte_ufs.c's log thread: iOS 18
+ * leaves ~345 000 LSE/RCpc sites to this trap (the rewriter's room is taken by the hotter libraries) and a trap costs
+ * ~1.3 us against ~19 ns for a routine. Which sites run most says what to give a routine next. The counts start again
+ * after every report; boot-arg v80emu_report=0: none.
+ */
+void
+herolte_v80emu_report(unsigned seconds)
+{
+	static int on = -1;
+	enum { TOP = 12 };
+	unsigned top[TOP];
+	uint64_t topc[TOP], total = 0;
+	unsigned n = 0, used = 0;
+
+	if (on < 0) {
+		uint32_t v = 1;
+		PE_parse_boot_argn("v80emu_report", &v, sizeof(v));
+		on = v != 0;
+	}
+	if (!on) {
+		return;
+	}
+	for (unsigned i = 0; i < V80EMU_NSITES; i++) {
+		uint64_t c = os_atomic_load(&v80emu_sites[i].count, relaxed);
+		if (os_atomic_load(&v80emu_sites[i].pc, relaxed) == 0) {
+			continue;
+		}
+		used++;
+		total += c;
+		unsigned k = n < TOP ? n++ : TOP;
+		if (k == TOP) {
+			if (c <= topc[TOP - 1]) {
+				continue;
+			}
+			k = TOP - 1;
+		}
+		while (k > 0 && topc[k - 1] < c) {
+			top[k] = top[k - 1];
+			topc[k] = topc[k - 1];
+			k--;
+		}
+		top[k] = i;
+		topc[k] = c;
+	}
+	printf("HEROLTE V80EMU: %u s: %llu traps (%llu/s), %u sites, %llu not recorded\n", seconds, total,
+	    seconds ? total / seconds : 0, used, os_atomic_load(&v80emu_dropped, relaxed));
+	for (unsigned j = 0; j < n && topc[j] != 0; j++) {
+		struct v80emu_site *s = &v80emu_sites[top[j]];
+		printf("HEROLTE V80EMU:   %llu x pc 0x%llx insn 0x%08x %s (first pid %d)\n", topc[j], s->pc, s->insn,
+		    s->cls < V80EMU_C_COUNT ? v80emu_class_names[s->cls] : "?", s->pid);
+	}
+	for (unsigned i = 0; i < V80EMU_NSITES; i++) {
+		os_atomic_store(&v80emu_sites[i].count, 0, relaxed);
+	}
+}
+
 #else /* !HEROLTE_V80EMU */
 
 size_t
@@ -284,4 +342,9 @@ herolte_v80emu_export(void *buf __unused, size_t buflen __unused, bool reset __u
 	return 0;
 }
 
+void
+herolte_v80emu_report(unsigned seconds __unused)
+{
+}
+
 #endif /* HEROLTE_V80EMU */
