+		fb->fLastShown = count;
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
 		if (fb->fPerfLog) {
 			uint64_t ns = 0;
@@ -444,11 +451,13 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		absolutetime_to_nanoseconds(finished - fb->fPerfWindowStart, &elapsedNS);
 		if (fb->fPerfFrames != 0 && elapsedNS != 0) {
 			uint64_t fpsTenths = fb->fPerfFrames * 10000000000ULL / elapsedNS;
-			IOLog("A5XELTE FB: frames=%llu elapsed_ms=%llu fps=%llu.%llu bytes=%llu avg_copy_us=%llu max_copy_us=%llu missed=%llu\n",
+			IOLog("A5XELTE FB: frames=%llu elapsed_ms=%llu fps=%llu.%llu bytes=%llu avg_copy_us=%llu max_copy_us=%llu missed=%llu gaps=%u/%u/%u/%u\n",
 			    fb->fPerfFrames, elapsedNS / 1000000, fpsTenths / 10,
 			    fpsTenths % 10, fb->fPerfBytes,
-			    fb->fPerfNS / fb->fPerfFrames / 1000, fb->fPerfMaxNS / 1000, fb->fVsyncMissed);
+			    fb->fPerfNS / fb->fPerfFrames / 1000, fb->fPerfMaxNS / 1000, fb->fVsyncMissed,
+			    fb->fGaps[0], fb->fGaps[1], fb->fGaps[2], fb->fGaps[3]);
 		}
+		bzero(fb->fGaps, sizeof(fb->fGaps));
 		fb->fPerfFrames = fb->fPerfBytes = fb->fPerfNS = fb->fPerfMaxNS = 0;
 		fb->fPerfWindowStart = finished;
 	}
