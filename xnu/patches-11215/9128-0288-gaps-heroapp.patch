diff --git a/bsd/dev/herolte_gl.c b/bsd/dev/herolte_gl.c
index c743b77..129160f 100644
--- a/bsd/dev/herolte_gl.c
+++ b/bsd/dev/herolte_gl.c
@@ -49,11 +49,19 @@ static int hgl_launches;
 static int hgl_pid = -1;        /* the backboardd that got the shim */
 static int hgl_sb_pid = -1;     /* the SpringBoard that got libherosb */
 static int hgl_sb_launches;
+#define HGL_APP_LIB     "/private/var/herolte/lib/libheroapp.dylib"
+#define HGL_APP_PIDS    64
+static int hgl_app_pids[HGL_APP_PIDS];  /* the latest applications that got libheroapp */
+static unsigned hgl_app_next;
 
 uint64_t
 herolte_gl_dyld_flags(void)
 {
-	if ((hgl_pid < 0 || proc_selfpid() != hgl_pid) && (hgl_sb_pid < 0 || proc_selfpid() != hgl_sb_pid)) {
+	bool app = false;
+	for (unsigned i = 0; i < HGL_APP_PIDS; i++) {
+		app = app || hgl_app_pids[i] == proc_selfpid();
+	}
+	if (!app && (hgl_pid < 0 || proc_selfpid() != hgl_pid) && (hgl_sb_pid < 0 || proc_selfpid() != hgl_sb_pid)) {
 		return 0;
 	}
 	return AMFI_DYLD_OUTPUT_ALLOW_AT_PATH | AMFI_DYLD_OUTPUT_ALLOW_PATH_VARS |
@@ -130,6 +138,16 @@ herolte_gl_env(const char *path, int pid, const char **extra, int max)
 			return 1;
 		}
 	}
+	/* libheroapp.dylib in the drop zone goes into every application: their last words, and no OpenGL ES that jumps to 0. */
+	if (path != NULL && strstr(path, "/Applications/") != NULL && max >= 1) {
+		vnode_t appvp = NULLVP;
+		if (vnode_lookup(HGL_APP_LIB, 0, &appvp, vfs_context_kernel()) == 0) {
+			vnode_put(appvp);
+			hgl_app_pids[hgl_app_next++ % HGL_APP_PIDS] = pid;
+			extra[0] = "DYLD_INSERT_LIBRARIES=" HGL_APP_LIB;
+			return 1;
+		}
+	}
 	if (hgl_mode == 0 || path == NULL || strcmp(path, HGL_TARGET) != 0 || max < 3) {
 		return 0;
 	}
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
