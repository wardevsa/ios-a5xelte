 	void rearmVsync(IOTimerEventSource *sender);
+	uint64_t            fLastShown;     /* the tick the last frame went to the panel at */
+	uint32_t            fGaps[4];       /* frames shown 1, 2, 3, 4 to 30 ticks after the one before: what judder is */
 
 	static void vsyncFired(OSObject *owner, IOTimerEventSource *sender);
 
@@ -419,6 +421,11 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		uint64_t before = fb->fPerfLog ? mach_absolute_time() : 0;
 #endif
 		uint64_t bytes = fb->present(rec);
