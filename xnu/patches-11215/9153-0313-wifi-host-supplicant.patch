- * brcmf_cfg80211_connect() with the firmware's own supplicant: WPA2-PSK, AES. The network is in the drop zone's
- * wifi/network.txt, its name on the first line and its passphrase on the second; the passphrase is not logged.
+ * Fourth step, WPA2. Samsung's firmware has no supplicant of its own (sup_wpa answers -23, BCME_UNSUPPORTED: Android runs
+ * wpa_supplicant), so the 4-way handshake is ours, as wpa_supplicant's (IEEE 802.11-2016 12.7.6), and the keys go to the
+ * firmware as "wsec_key" (brcmfmac's cfg80211.c). The kernel has no SHA-1 or AES of its own: SHA-1 (FIPS 180-4), HMAC,
+ * PBKDF2 for the PMK, the PRF for the PTK and the AES key unwrap of the group key (RFC 3394) are here, each checked once
+ * against a known answer.
+ */
+struct hw_sha1 {
+	uint32_t h[5];
+	uint8_t block[64];
+	uint32_t used;
+	uint64_t bytes;
+};
+
+#define HW_ROL(x, n)    (((x) << (n)) | ((x) >> (32 - (n))))
+
+static void
+hw_sha1_block(uint32_t h[5], const uint8_t *p)
+{
+	uint32_t w[80], a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+	for (unsigned i = 0; i < 16; i++) {
+		w[i] = hw_get32be(p + 4 * i);
+	}
+	for (unsigned i = 16; i < 80; i++) {
+		uint32_t x = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16];
+		w[i] = HW_ROL(x, 1);
+	}
+	for (unsigned i = 0; i < 80; i++) {
+		uint32_t f, k;
+		if (i < 20) {
+			f = (b & c) | (~b & d);
+			k = 0x5a827999u;
+		} else if (i < 40) {
+			f = b ^ c ^ d;
+			k = 0x6ed9eba1u;
+		} else if (i < 60) {
+			f = (b & c) | (b & d) | (c & d);
+			k = 0x8f1bbcdcu;
+		} else {
+			f = b ^ c ^ d;
+			k = 0xca62c1d6u;
+		}
+		uint32_t t = HW_ROL(a, 5) + f + e + k + w[i];
+		e = d;
+		d = c;
+		c = HW_ROL(b, 30);
+		b = a;
+		a = t;
+	}
+	h[0] += a;
+	h[1] += b;
+	h[2] += c;
+	h[3] += d;
+	h[4] += e;
+}
+
+static void
+hw_sha1_init(struct hw_sha1 *s)
+{
+	static const uint32_t start[5] = { 0x67452301u, 0xefcdab89u, 0x98badcfeu, 0x10325476u, 0xc3d2e1f0u };
+	memcpy(s->h, start, sizeof(start));
+	s->used = 0;
+	s->bytes = 0;
+}
+
+static void
+hw_sha1_update(struct hw_sha1 *s, const void *data, size_t len)
+{
+	const uint8_t *p = data;
+	s->bytes += len;
+	while (len > 0) {
+		size_t n = 64 - s->used < len ? 64 - s->used : len;
+		memcpy(s->block + s->used, p, n);
+		s->used += (uint32_t)n;
+		p += n;
+		len -= n;
+		if (s->used == 64) {
+			hw_sha1_block(s->h, s->block);
+			s->used = 0;
+		}
+	}
+}
+
+static void
+hw_sha1_final(struct hw_sha1 *s, uint8_t out[20])
+{
+	uint64_t bits = s->bytes * 8;
+	uint8_t pad = 0x80, zero = 0, len[8];
+	hw_sha1_update(s, &pad, 1);
+	while (s->used != 56) {
+		hw_sha1_update(s, &zero, 1);
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		len[i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	hw_sha1_update(s, len, 8);
+	for (unsigned i = 0; i < 20; i++) {
+		out[i] = (uint8_t)(s->h[i / 4] >> (24 - 8 * (i % 4)));
+	}
+}
+
+/* HMAC-SHA1 in two halves: the key's pads hashed once, the message into in, then hw_hmac_finish(). */
+struct hw_hmac {
+	struct hw_sha1 in, out;
+};
+
+static void
+hw_hmac_start(struct hw_hmac *m, const void *key, size_t len)
+{
+	uint8_t k[64] = { 0 }, pad[64];
+	if (len > 64) {
+		struct hw_sha1 s;
+		hw_sha1_init(&s);
+		hw_sha1_update(&s, key, len);
+		hw_sha1_final(&s, k);
+	} else {
+		memcpy(k, key, len);
+	}
+	for (unsigned i = 0; i < 64; i++) {
+		pad[i] = (uint8_t)(k[i] ^ 0x36);
+	}
+	hw_sha1_init(&m->in);
+	hw_sha1_update(&m->in, pad, 64);
+	for (unsigned i = 0; i < 64; i++) {
+		pad[i] = (uint8_t)(k[i] ^ 0x5c);
+	}
+	hw_sha1_init(&m->out);
+	hw_sha1_update(&m->out, pad, 64);
+	memset(k, 0, sizeof(k));
+	memset(pad, 0, sizeof(pad));
+}
+
+static void
+hw_hmac_finish(struct hw_hmac *m, uint8_t out[20])
+{
+	uint8_t inner[20];
+	hw_sha1_final(&m->in, inner);
+	hw_sha1_update(&m->out, inner, 20);
+	hw_sha1_final(&m->out, out);
+}
