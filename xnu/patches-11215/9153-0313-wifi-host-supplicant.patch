+/* PBKDF2-HMAC-SHA1 of the passphrase, salted with the network's name, 4096 rounds, 32 bytes: the PMK. */
+static void
+hw_pmk(const char *pass, size_t plen, const char *ssid, size_t slen, uint8_t pmk[32])
+{
+	struct hw_hmac base, m;
+	hw_hmac_start(&base, pass, plen);
+	for (uint8_t block = 1; block <= 2; block++) {
+		uint8_t u[20], t[20], count[4] = { 0, 0, 0, block };
+		m = base;
+		hw_sha1_update(&m.in, ssid, slen);
+		hw_sha1_update(&m.in, count, 4);
+		hw_hmac_finish(&m, u);
+		memcpy(t, u, 20);
+		for (unsigned round = 1; round < 4096; round++) {
+			m = base;
+			hw_sha1_update(&m.in, u, 20);
+			hw_hmac_finish(&m, u);
+			for (unsigned i = 0; i < 20; i++) {
+				t[i] ^= u[i];
+			}
+		}
+		memcpy(pmk + 20 * (block - 1), t, block == 1 ? 20 : 12);
+		memset(t, 0, sizeof(t));
+		memset(u, 0, sizeof(u));
+	}
+	memset(&base, 0, sizeof(base));
+	memset(&m, 0, sizeof(m));
