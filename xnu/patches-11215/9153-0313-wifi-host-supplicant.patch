+hw_xtime(uint8_t x)
+{
+	return (uint8_t)((x << 1) ^ ((x & 0x80) ? 0x1b : 0));
+}
+
+static uint8_t
+hw_gmul(uint8_t a, uint8_t b)
+{
+	uint8_t p = 0;
+	while (b) {
+		if (b & 1) {
+			p ^= a;
+		}
+		a = hw_xtime(a);
+		b >>= 1;
+	}
+	return p;
+}
+
+static void
+hw_aes_tables(void)
+{
+	uint8_t p = 1, q = 1;
+	if (hw_sbox[0] == 0x63) {
+		return;
+	}
+	do {
+		p = (uint8_t)(p ^ (uint8_t)(p << 1) ^ ((p & 0x80) ? 0x1b : 0));
+		q = (uint8_t)(q ^ (uint8_t)(q << 1));
+		q = (uint8_t)(q ^ (uint8_t)(q << 2));
+		q = (uint8_t)(q ^ (uint8_t)(q << 4));
+		if (q & 0x80) {
+			q ^= 0x09;
+		}
+		hw_sbox[p] = (uint8_t)(q ^ HW_ROL8(q, 1) ^ HW_ROL8(q, 2) ^ HW_ROL8(q, 3) ^ HW_ROL8(q, 4) ^ 0x63);
+	} while (p != 1);
+	hw_sbox[0] = 0x63;
+	for (unsigned i = 0; i < 256; i++) {
+		hw_isbox[hw_sbox[i]] = (uint8_t)i;
+	}
+}
+
+static void
+hw_aes_expand(const uint8_t key[16], uint8_t rk[176])
+{
+	uint8_t rcon = 1;
+	memcpy(rk, key, 16);
+	for (unsigned i = 16; i < 176; i += 4) {
+		uint8_t t[4] = { rk[i - 4], rk[i - 3], rk[i - 2], rk[i - 1] };
+		if (i % 16 == 0) {
+			uint8_t x = t[0];
+			t[0] = (uint8_t)(hw_sbox[t[1]] ^ rcon);
+			t[1] = hw_sbox[t[2]];
+			t[2] = hw_sbox[t[3]];
+			t[3] = hw_sbox[x];
+			rcon = hw_xtime(rcon);
+		}
+		for (unsigned k = 0; k < 4; k++) {
+			rk[i + k] = (uint8_t)(rk[i - 16 + k] ^ t[k]);
+		}
+	}
+}
+
+static void
+hw_aes_decrypt(const uint8_t rk[176], uint8_t s[16])
+{
+	uint8_t t[16];
+	for (unsigned i = 0; i < 16; i++) {
+		s[i] ^= rk[160 + i];
+	}
+	for (unsigned round = 9;; round--) {
+		for (unsigned r = 0; r < 4; r++) {              /* InvShiftRows */
+			for (unsigned c = 0; c < 4; c++) {
+				t[r + 4 * c] = s[r + 4 * ((c + 4 - r) % 4)];
+			}
+		}
+		for (unsigned i = 0; i < 16; i++) {             /* InvSubBytes, AddRoundKey */
+			s[i] = (uint8_t)(hw_isbox[t[i]] ^ rk[16 * round + i]);
+		}
+		if (round == 0) {
+			break;
+		}
+		for (unsigned c = 0; c < 4; c++) {              /* InvMixColumns */
+			uint8_t a0 = s[4 * c], a1 = s[4 * c + 1], a2 = s[4 * c + 2], a3 = s[4 * c + 3];
+			s[4 * c] = (uint8_t)(hw_gmul(a0, 14) ^ hw_gmul(a1, 11) ^ hw_gmul(a2, 13) ^ hw_gmul(a3, 9));
+			s[4 * c + 1] = (uint8_t)(hw_gmul(a0, 9) ^ hw_gmul(a1, 14) ^ hw_gmul(a2, 11) ^ hw_gmul(a3, 13));
+			s[4 * c + 2] = (uint8_t)(hw_gmul(a0, 13) ^ hw_gmul(a1, 9) ^ hw_gmul(a2, 14) ^ hw_gmul(a3, 11));
+			s[4 * c + 3] = (uint8_t)(hw_gmul(a0, 11) ^ hw_gmul(a1, 13) ^ hw_gmul(a2, 9) ^ hw_gmul(a3, 14));
+		}
+	}
+}
+
+/* RFC 3394: len bytes wrapped (a multiple of 8, at least 24) into len - 8 at out; false if the check value is wrong. */
+static bool
+hw_unwrap(const uint8_t kek[16], const uint8_t *in, uint32_t len, uint8_t *out)
+{
+	uint8_t a[8], b[16], rk[176];
+	uint32_t n = len / 8 - 1;
+	bool ok = true;
+	hw_aes_tables();
+	hw_aes_expand(kek, rk);
+	memcpy(a, in, 8);
+	memcpy(out, in + 8, len - 8);
+	for (unsigned j = 6; j-- > 0;) {
+		for (uint32_t i = n; i >= 1; i--) {
+			uint64_t t = (uint64_t)n * j + i;
+			memcpy(b, a, 8);
+			for (unsigned k = 0; k < 8; k++) {
+				b[7 - k] ^= (uint8_t)(t >> (8 * k));
+			}
+			memcpy(b + 8, out + 8 * (i - 1), 8);
+			hw_aes_decrypt(rk, b);
+			memcpy(a, b, 8);
+			memcpy(out + 8 * (i - 1), b + 8, 8);
+		}
+	}
+	for (unsigned k = 0; k < 8; k++) {
+		ok = ok && a[k] == 0xa6;
+	}
+	memset(rk, 0, sizeof(rk));
+	memset(b, 0, sizeof(b));
+	return ok;
+}
+
+/* IEEE 802.11-2016 J.4.2 (PBKDF2) and RFC 3394 4.1 (the unwrap) */
+static bool
+hw_crypto_check(void)
+{
+	static const uint8_t psk[8] = { 0xf4, 0x2c, 0x6f, 0xc5, 0x2d, 0xf0, 0xeb, 0xef };
+	static const uint8_t wrapped[24] = { 0x1f, 0xa6, 0x8b, 0x0a, 0x81, 0x12, 0xb4, 0x47, 0xae, 0xf3, 0x4b, 0xd8,
+		                             0xfb, 0x5a, 0x7b, 0x82, 0x9d, 0x3e, 0x86, 0x23, 0x71, 0xd2, 0xcf, 0xe5 };
+	uint8_t kek[16], key[16], pmk[32];
+	bool unwrap, pbkdf2;
+	for (unsigned i = 0; i < 16; i++) {
+		kek[i] = (uint8_t)i;
+	}
+	unwrap = hw_unwrap(kek, wrapped, sizeof(wrapped), key);
+	for (unsigned i = 0; i < 16; i++) {
+		unwrap = unwrap && key[i] == (uint8_t)(i * 0x11);
+	}
+	hw_pmk("password", 8, "IEEE", 4, pmk);
+	pbkdf2 = memcmp(pmk, psk, sizeof(psk)) == 0;
+	printf("HEROLTE WIFI: crypto check: PBKDF2 %s, AES key unwrap %s\n", pbkdf2 ? "ok" : "WRONG", unwrap ? "ok" : "WRONG");
+	return pbkdf2 && unwrap;
+}
+
+static uint8_t hw_pmk_key[32], hw_ptk[48], hw_anonce[32], hw_snonce[32], hw_replay[8], hw_rsn[22];
+static uint8_t hw_gtk[32], hw_gtk_rsc[6], hw_group;
+static uint32_t hw_gtk_len, hw_gtk_id, hw_install_after;
+static bool hw_have_ptk;
+static int hw_install;                          /* 1: PTK and GTK once the 4th message has left, 2: the GTK alone */
+static uint64_t hw_install_since;
+
+/* The PRF of 802.11 with SHA-1, 384 bits: KCK, KEK and TK. */
+static void
+hw_derive_ptk(void)
+{
+	static const char label[] = "Pairwise key expansion";
+	uint8_t data[76], out[20];
+	bool mac_first = memcmp(hw_bssid, hw_mac, 6) < 0, nonce_first = memcmp(hw_anonce, hw_snonce, 32) < 0;
+	memcpy(data, mac_first ? hw_bssid : hw_mac, 6);
+	memcpy(data + 6, mac_first ? hw_mac : hw_bssid, 6);
+	memcpy(data + 12, nonce_first ? hw_anonce : hw_snonce, 32);
+	memcpy(data + 44, nonce_first ? hw_snonce : hw_anonce, 32);
+	for (uint8_t i = 0; i < 3; i++) {
+		struct hw_hmac m;
+		hw_hmac_start(&m, hw_pmk_key, 32);
+		hw_sha1_update(&m.in, label, sizeof(label));    /* with its terminating zero, the PRF's separator */
+		hw_sha1_update(&m.in, data, sizeof(data));
+		hw_sha1_update(&m.in, &i, 1);
+		hw_hmac_finish(&m, out);
+		memcpy(hw_ptk + 20 * i, out, i < 2 ? 20 : 8);
+	}
+	memset(out, 0, sizeof(out));
+}
+
+static bool
+hw_flow_open(void)
+{
+	if (hw_flow == 2) {
+		return true;
+	}
+	hw_wr16(hw_tcm, hw_h2d_w + HW_FLOW_ID * 4, 0);
+	hw_wr16(hw_tcm, hw_h2d_r + HW_FLOW_ID * 4, 0);
+	hw_flow_w = 0;
+	hw_flow = 1;
+	if (!hw_submit(hw_fill_flow, NULL)) {
+		return false;
+	}
+	for (unsigned t = 0; t < 400 && hw_flow == 1; t++) {
+		IOSleep(5);
+		hw_drain();
+	}
+	printf("HEROLTE WIFI: flow ring %u: %s\n", HW_FLOW_ID, hw_flow == 2 ? "open" : hw_flow == 1 ? "no answer" : "refused");
+	return hw_flow == 2;
+}
+
+/* An EAPOL-Key frame to the access point, its MIC made with the KCK. */
+static void
+hw_eapol_send(uint16_t info, const uint8_t *nonce, const uint8_t *data, uint16_t dlen)
+{
+	uint8_t f[14 + 99 + sizeof(hw_rsn)] = { 0 }, mic[20];
+	uint8_t *e = f + 14;
+	uint16_t body = (uint16_t)(95 + dlen);
+	struct hw_hmac m;
+	memcpy(f, hw_bssid, 6);
+	memcpy(f + 6, hw_mac, 6);
+	f[12] = 0x88;
+	f[13] = 0x8e;
+	e[0] = 1;                                               /* 802.1X-2001, as wpa_supplicant */
+	e[1] = 3;                                               /* EAPOL-Key */
+	e[2] = (uint8_t)(body >> 8);
+	e[3] = (uint8_t)body;
+	e[4] = 2;                                               /* RSN */
+	e[5] = (uint8_t)(info >> 8);
+	e[6] = (uint8_t)info;
+	memcpy(e + 9, hw_replay, 8);
+	if (nonce) {
+		memcpy(e + 17, nonce, 32);
+	}
+	e[97] = (uint8_t)(dlen >> 8);
+	e[98] = (uint8_t)dlen;
+	if (dlen) {
+		memcpy(e + 99, data, dlen);
+	}
+	hw_hmac_start(&m, hw_ptk, 16);
+	hw_sha1_update(&m.in, e, 4u + body);
+	hw_hmac_finish(&m, mic);
+	memcpy(e + 81, mic, 16);
+	if (!hw_tx(f, 14u + 4u + body)) {
+		printf("HEROLTE WIFI: EAPOL frame not sent\n");
+	}
+}
+
+/* One EAPOL-Key frame from the access point: messages 1 and 3 of the 4-way handshake, or 1 of the group key's. */
+static void
+hw_eapol(const uint8_t *f, uint32_t len)
+{
+	static uint8_t copy[HW_EAPOL_MAX];
+	const uint8_t *e = f + 14;
+	uint8_t kd[256], mic[20];
+	uint32_t kdlen = 0;
+	if (len < 14 + 99 || e[1] != 3 || e[4] != 2) {
+		return;
+	}
+	uint32_t elen = 4u + hw_get16be(e + 2);
+	uint16_t info = hw_get16be(e + 5), dlen = hw_get16be(e + 97);
+	bool pairwise = (info & 0x8) != 0;
+	if (14 + elen > len || 99u + dlen > elen) {
+		printf("HEROLTE WIFI: an EAPOL-Key frame shorter than it says\n");
+		return;
+	}
+	if ((info & 7) != 2) {
+		printf("HEROLTE WIFI: EAPOL-Key descriptor version %u, not 2 (HMAC-SHA1 and AES)\n", info & 7);
+		return;
+	}
+	if (!(info & 0x80)) {                                   /* not from the authenticator */
+		return;
+	}
+	if (pairwise && !(info & 0x100)) {                      /* message 1: a fresh start */
+		memcpy(hw_bssid, f + 6, 6);
+		memcpy(hw_anonce, e + 17, 32);
+		memcpy(hw_replay, e + 9, 8);
+		read_random(hw_snonce, sizeof(hw_snonce));
+		hw_derive_ptk();
+		hw_have_ptk = true;
+		hw_install = 0;
+		if (hw_flow_open()) {
+			hw_eapol_send(0x010a, hw_snonce, hw_rsn, sizeof(hw_rsn));    /* pairwise, MIC; our RSN element */
+			printf("HEROLTE WIFI: handshake 1/4 from %02x:%02x:%02x:%02x:%02x:%02x, 2/4 sent\n",
+			    hw_bssid[0], hw_bssid[1], hw_bssid[2], hw_bssid[3], hw_bssid[4], hw_bssid[5]);
+		}
+		return;
+	}
+	if (!(info & 0x100) || !hw_have_ptk) {
+		return;
+	}
+	if (memcmp(e + 9, hw_replay, 8) <= 0) {
+		printf("HEROLTE WIFI: EAPOL-Key with an old replay counter, dropped\n");
+		return;
+	}
+	memcpy(copy, e, elen);
+	memset(copy + 81, 0, 16);
+	struct hw_hmac m;
+	hw_hmac_start(&m, hw_ptk, 16);
+	hw_sha1_update(&m.in, copy, elen);
+	hw_hmac_finish(&m, mic);
+	if (memcmp(mic, e + 81, 16) != 0) {
+		printf("HEROLTE WIFI: handshake %s: the MIC does not match (a wrong passphrase?)\n", pairwise ? "3/4" : "group 1/2");
+		return;
+	}
+	memcpy(hw_replay, e + 9, 8);
+	if (pairwise && memcmp(e + 17, hw_anonce, 32) != 0) {
+		printf("HEROLTE WIFI: handshake 3/4 with another ANonce, dropped\n");
+		return;
+	}
+	if (info & 0x1000) {                                    /* the key data, wrapped with the KEK */
+		if (dlen < 24 || dlen % 8 || dlen - 8u > sizeof(kd) || !hw_unwrap(hw_ptk + 16, e + 99, dlen, kd)) {
+			printf("HEROLTE WIFI: the key data (%u bytes) does not unwrap\n", dlen);
+			return;
+		}
+		kdlen = dlen - 8u;
+	}
+	hw_gtk_len = 0;
+	for (uint32_t i = 0; i + 2 <= kdlen && i + 2u + kd[i + 1] <= kdlen; i += 2u + kd[i + 1]) {
+		const uint8_t *k = kd + i;
+		/* the GTK KDE: 00-0f-ac:1, the key's index, a reserved byte, the key */
+		if (k[0] == 0xdd && k[1] >= 6 + 16 && k[1] - 6u <= sizeof(hw_gtk) && k[2] == 0x00 && k[3] == 0x0f && k[4] == 0xac && k[5] == 1) {
+			hw_gtk_id = k[6] & 3u;
+			hw_gtk_len = k[1] - 6u;
+			memcpy(hw_gtk, k + 8, hw_gtk_len);
+		}
+	}
+	memset(kd, 0, sizeof(kd));
+	memcpy(hw_gtk_rsc, e + 65, 6);
+	if (pairwise) {
+		hw_eapol_send(0x030a, NULL, NULL, 0);           /* pairwise, MIC, secure */
+		hw_install = 1;
+	} else {
+		hw_eapol_send(0x0302, NULL, NULL, 0);           /* MIC, secure */
+		hw_install = 2;
+	}
+	hw_install_after = hw_tx_next;
+	hw_install_since = mach_absolute_time();
+	printf("HEROLTE WIFI: handshake %s, group key %u of %u bytes; %s sent\n", pairwise ? "3/4" : "group 1/2", hw_gtk_id, hw_gtk_len,
+	    pairwise ? "4/4" : "group 2/2");
+}
+
+/* struct brcmf_wsec_key_le, as "wsec_key": a pairwise key for the access point's address, or a group key with its RSC */
+static int
+hw_key(uint32_t index, const uint8_t *key, uint32_t len, const uint8_t *ea, const uint8_t *rsc, uint32_t algo)
+{
+	uint8_t k[164] = { 0 };
+	hw_put32(k, index);
+	hw_put32(k + 4, len);
+	memcpy(k + 8, key, len);
+	if (algo == ALGO_TKIP && len == 32) {                   /* brcmfmac swaps the MIC keys of a station */
+		uint8_t x[8];
+		memcpy(x, k + 8 + 24, 8);
+		memcpy(k + 8 + 24, k + 8 + 16, 8);
+		memcpy(k + 8 + 16, x, 8);
+	}
+	hw_put32(k + 112, algo);
+	hw_put32(k + 116, ea ? 0 : 2);                          /* BRCMF_PRIMARY_KEY for the group's */
+	if (rsc) {
+		hw_put32(k + 132, 1);
+		hw_put32(k + 140, ((uint32_t)rsc[5] << 24) | ((uint32_t)rsc[4] << 16) | ((uint32_t)rsc[3] << 8) | rsc[2]);
+		hw_put16(k + 144, (uint16_t)((rsc[1] << 8) | rsc[0]));
+	}
+	if (ea) {
+		memcpy(k + 156, ea, 6);
+	}
+	int err = hw_ioctl(WLC_SET_VAR, "wsec_key", k, sizeof(k), NULL, 0);
+	memset(k, 0, sizeof(k));
+	volatile uint8_t *req = (volatile uint8_t *)(hw_dma + HW_IOCTL_REQ);
+	for (unsigned i = 0; i < 9 + sizeof(k); i++) {
+		req[i] = 0;
+	}
+	return err;
+}
+
+/* The keys of the last handshake, once its last message has left (so it does not go out encrypted), or after 300 ms. */
+static void
+hw_keys(void)
+{
+	uint64_t ns = 0;
+	if (hw_install == 0) {
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - hw_install_since, &ns);
+	if (hw_tx_done < hw_install_after && ns < 300000000ull) {
+		return;
+	}
+	int ptk = 0, gtk = -1;
+	if (hw_install == 1) {
+		ptk = hw_key(0, hw_ptk + 32, 16, hw_bssid, NULL, ALGO_AES_CCM);
+	}
+	if (hw_gtk_len) {
+		gtk = hw_key(hw_gtk_id, hw_gtk, hw_gtk_len, NULL, hw_gtk_rsc, hw_group == 2 ? ALGO_TKIP : ALGO_AES_CCM);
+	}
+	printf("HEROLTE WIFI: keys: pairwise %d, group %d (index %u)%s\n", ptk, gtk, hw_gtk_id, hw_tx_done < hw_install_after ? ", the last frame not confirmed sent" : "");
+	if (hw_install == 1 && ptk == 0 && gtk == 0) {
+		hw_keyed = true;
+	}
+	hw_install = 0;
+}
+
+/* A DHCP DISCOVER to everyone, answers asked to everyone too: what comes back proves both keys. */
+static void
+hw_dhcp_discover(void)
+{
+	static const uint8_t options[] = { 0x63, 0x82, 0x53, 0x63, 53, 1, 1, 55, 3, 1, 3, 6, 255 };
+	static uint8_t f[14 + 20 + 8 + 300];
+	uint8_t *ip = f + 14, *udp = ip + 20, *b = udp + 8;
+	uint32_t sum = 0;
+	memset(f, 0, sizeof(f));
+	memset(f, 0xff, 6);
+	memcpy(f + 6, hw_mac, 6);
+	f[12] = 0x08;
+	ip[0] = 0x45;
+	ip[2] = (uint8_t)((20 + 8 + 300) >> 8);
+	ip[3] = (uint8_t)(20 + 8 + 300);
+	ip[8] = 64;
+	ip[9] = 17;
+	memset(ip + 16, 0xff, 4);
+	for (unsigned i = 0; i < 20; i += 2) {
+		sum += ((uint32_t)ip[i] << 8) | ip[i + 1];
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	ip[10] = (uint8_t)(~sum >> 8);
+	ip[11] = (uint8_t)~sum;
+	udp[1] = 68;
+	udp[3] = 67;
+	udp[4] = (uint8_t)((8 + 300) >> 8);
+	udp[5] = (uint8_t)(8 + 300);
+	b[0] = 1;
+	b[1] = 1;
+	b[2] = 6;
+	read_random(&hw_dhcp_xid, sizeof(hw_dhcp_xid));
+	hw_put32(b + 4, __builtin_bswap32(hw_dhcp_xid));        /* as hw_get32be() will read it back */
+	b[10] = 0x80;                                           /* answer to everyone */
+	memcpy(b + 28, hw_mac, 6);
+	memcpy(b + 236, options, sizeof(options));
+	hw_dhcp_seen = false;
+	printf("HEROLTE WIFI: DHCP DISCOVER %s\n", hw_tx(f, sizeof(f)) ? "sent" : "not sent");
+}
