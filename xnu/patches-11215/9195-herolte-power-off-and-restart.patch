@@ -14,6 +14,7 @@ extern "C" int sweet_reboot_restart(int panic_restart);
 extern "C" void sweet_reboot_note_panic(void);
 #if defined(HEROLTE)
 extern "C" void herolte_log_flush_panic(void);         /* bsd/dev/herolte_ufs.c (9170) */
+extern "C" void herolte_power_down(int restart);       /* bsd/dev/herolte_gpu.c (9195) */
 #endif
 #include "../../../bsd/dev/sweet_board.h"
 #include "../../../bsd/dev/sweet_spmi.h"
@@ -70,6 +71,10 @@ SweetPlatformExpert::haltRestart(unsigned int type)
 	if (type == kPEPanicDiagnosticsDone || type == kPEPanicRestartCPU || type == kPEPanicRestartCPUNoCallouts) {
 		herolte_log_flush_panic();
 	}
+	/* 9195: a real power off / restart (PS_HOLD, SWRESET) instead of spinning in halt_all_cpus() */
+	if (type == kPEHaltCPU || type == kPERestartCPU) {
+		herolte_power_down(type == kPERestartCPU);
+	}
 #endif
 #if !defined(A5XELTE)
 	switch (type) {
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 471a543..9a071f3 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -896,9 +896,16 @@ halt_all_cpus(boolean_t reboot)
 		printf("CPU halted\n");
 		PEHaltRestart(kPEHaltCPU);
 	}
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	/* (9195) a core spinning here kept the phone hot for as long as the battery lasted: wait instead */
+	for (;;) {
+		__builtin_arm_wfi();
+	}
+#else
 	while (1) {
 		;
 	}
+#endif
 }
 
