  * CON0: M in bits 25:16, P in 13:8, S in 2:0, rate = 26 MHz * M / (P * 2^S).
  */
 static void
+hg_decon_measure(vm_offset_t decon, const char *when)
+{
+	uint64_t start = mach_absolute_time(), now = start, rise = 0, first = 0, period = 0, active = 0, began = 0;
+	uint32_t top = 0, frames = 0, last = 0;
+	while (now - start < 26000000u / 5u) {  /* 200 ms */
+		uint32_t line = hg_rd(decon, 0x8c) & 0xffff;
+		now = mach_absolute_time();
+		top = line > top ? line : top;
+		if (line != 0 && last == 0) {
+			began = now;
+			if (rise) {
+				period = now - rise;
+			} else {
+				first = now;
+			}
+			rise = now;
+			frames++;
+		} else if (line == 0 && last != 0) {
+			active = now - began;
+		}
+		last = line;
+	}
+	printf("HEROLTE DECON: %s: %u frames in 200 ms, period %llu us, reading %llu us, top line %u, span %llu us\n", when, frames,
+	    period / 26, active / 26, top, (rise - first) / 26);
