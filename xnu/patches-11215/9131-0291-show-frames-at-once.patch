+/*
+ * A frame is shown as soon as the window server has given it, not at the next tick: waiting cost up to a whole refresh,
+ * and a frame finished just after a tick was often replaced by the next before it was seen (overwritten=, 5% of them).
+ */
+void
+AppleCLCD::showFired(OSObject *owner, __unused IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		return;         /* the tick shows it */
+	}
+	IOLockLock(fb->fLock);
+	bool show = fb->fDirty && !fb->fPowerOff;
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	show = show && mach_absolute_time() >= sweet_fb_hold_until;
+#endif
+	if (show) {
+		memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+		fb->fDirty = false;
+	}
+	IOLockUnlock(fb->fLock);
+	if (show) {
+		uint64_t before = mach_absolute_time();
+		uint64_t bytes = fb->present(rec);
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - before, &ns);
+		uint64_t gap = fb->fVsyncCount - fb->fLastShown;
+		fb->fGaps[gap <= 1 ? 0 : gap >= 4 ? 3 : gap - 1] += gap <= 30 ? 1 : 0;
+		fb->fLastShown = fb->fVsyncCount;
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+		fb->fPerfFrames++;
+		fb->fPerfBytes += bytes;
+		fb->fPerfNS += ns;
+		if (ns > fb->fPerfMaxNS) {
+			fb->fPerfMaxNS = ns;
+		}
+#else
+		(void)bytes;
+#endif
+	}
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
