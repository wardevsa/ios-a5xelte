+	uint32_t twrp = 0;
+
+	if (PE_parse_boot_argn("herotwrp", &twrp, sizeof(twrp)) && twrp > 0 &&
+	    kernel_thread_start(hg_twrp_thread, (void *)(uintptr_t)twrp, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 
 	PE_parse_boot_argn("herogpu", &enabled, sizeof(enabled));
