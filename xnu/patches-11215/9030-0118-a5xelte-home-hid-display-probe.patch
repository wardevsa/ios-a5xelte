diff --git a/bsd/dev/a5xelte_keys.c b/bsd/dev/a5xelte_keys.c
new file mode 100644
index 0000000..3ba2fd4
--- /dev/null
+++ b/bsd/dev/a5xelte_keys.c
@@ -0,0 +1,110 @@
+/*
+ * Exynos7580 ALIVE GPIO keys for the SM-A510F.
+ *
+ * The working Linux device tree locates Power/Volume Up/Volume Down/Home at
+ * GPA2 pins 7/0/1/5, all active low.  Poll only GPA2DAT; boot firmware owns
+ * the pin mux and pull-ups.  No ALIVE or interrupt-controller writes occur.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+
+#define A5_ALIVE_PA 0x139b0000u
+#define A5_GPA2_CON 0x40u
+#define A5_GPA2_DAT 0x44u
+#define A5_GPA2_PUD 0x48u
+
+static vm_offset_t a5_alive;
+static int a5_keys_sleep;
+static bool a5_keys_started;
+
+static uint32_t
+a5_keys_read(uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(a5_alive + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+a5_keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&a5_keys_sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+a5_keys_thread(void *arg, wait_result_t result)
+{
+	static const uint8_t pins[4] = {7, 0, 1, 5};
+	uint8_t stable = (uint8_t)a5_keys_read(A5_GPA2_DAT);
+	uint8_t previous = stable;
+	unsigned repeated = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t sample = (uint8_t)a5_keys_read(A5_GPA2_DAT);
+		if (sample == previous) {
+			if (repeated < 2) {
+				repeated++;
+			}
+		} else {
+			previous = sample;
+			repeated = 0;
+		}
+		if (repeated == 2 && stable != sample) {
+			for (unsigned key = 0; key < 4; key++) {
+				uint8_t bit = 1u << pins[key];
+				if ((stable ^ sample) & bit) {
+					int down = !(sample & bit);
+					printf("A5XELTE KEYS: key=%u down=%d gpio=%#x\n",
+					    key, down, sample);
+					sweet_hid_key((int)key, down);
+				}
+			}
+			stable = sample;
+		}
+		a5_keys_wait();
+	}
+}
+
+void
+a5xelte_keys_init(void)
+{
+	thread_t thread;
+	int enabled = 1;
+	if (a5_keys_started) {
+		return;
+	}
+	a5_keys_started = true;
+	(void)PE_parse_boot_argn("a5keys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("A5XELTE KEYS: disabled\n");
+		return;
+	}
+	a5_alive = ml_io_map(A5_ALIVE_PA, 0x1000);
+	if (!a5_alive) {
+		printf("A5XELTE KEYS: ALIVE mapping failed\n");
+		return;
+	}
+	printf("A5XELTE KEYS: GPA2 con=%#x dat=%#x pud=%#x (read only)\n",
+	    a5_keys_read(A5_GPA2_CON), a5_keys_read(A5_GPA2_DAT),
+	    a5_keys_read(A5_GPA2_PUD));
+	kern_return_t kr = kernel_thread_start(a5_keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A5XELTE KEYS: thread start failed %d\n", kr);
+	}
+}
+#endif
diff --git a/bsd/dev/a5xelte_touch.c b/bsd/dev/a5xelte_touch.c
new file mode 100644
index 0000000..e46d739
--- /dev/null
+++ b/bsd/dev/a5xelte_touch.c
@@ -0,0 +1,58 @@
+/*
+ * Read-only Exynos7580 ZT7538 bring-up probe.  The working native Linux
+ * port uses I2C2 at 0x13850000, GPC3-0/1, GPA1-1 and S2MPU03 LDO33.
+ * Keep this first XNU probe out of the PMIC and touchscreen register files:
+ * their controller clocks and power sequencing need a separate device test.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static uint32_t
+a5touch_read(vm_offset_t base, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+void
+a5xelte_touch_probe(void)
+{
+	int enabled = 1;
+	(void)PE_parse_boot_argn("a5touchprobe", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	vm_offset_t alive = ml_io_map(0x139b0000, 0x1000);
+	vm_offset_t nfc = ml_io_map(0x138c0000, 0x1000);
+	vm_offset_t mifpins = ml_io_map(0x104e0000, 0x1000);
+	vm_offset_t peri = ml_io_map(0x139f0000, 0x1000);
+	vm_offset_t mif = ml_io_map(0x10430000, 0x1000);
+	if (!alive || !nfc || !mifpins || !peri || !mif) {
+		printf("A5XELTE TOUCH: probe MMIO mapping failed\n");
+		return;
+	}
+	uint32_t pclk = a5touch_read(peri, 0x904);
+	uint32_t mifclk = a5touch_read(mif, 0x900);
+	printf("A5XELTE TOUCH: INT GPA1 con=%#x dat=%#x; GPC3 con=%#x dat=%#x pud=%#x\n",
+	    a5touch_read(alive, 0x20), a5touch_read(alive, 0x24),
+	    a5touch_read(nfc, 0), a5touch_read(nfc, 4), a5touch_read(nfc, 8));
+	printf("A5XELTE TOUCH: I2C2 gate=%d MIF HSI2C3 gate=%d GPM0 con=%#x dat=%#x pud=%#x\n",
+	    !!(pclk & (1u << 9)), !!(mifclk & (1u << 27)),
+	    a5touch_read(mifpins, 0), a5touch_read(mifpins, 4),
+	    a5touch_read(mifpins, 8));
+	if (pclk & (1u << 9)) {
+		vm_offset_t i2c = ml_io_map(0x13850000, 0x1000);
+		if (i2c) {
+			printf("A5XELTE TOUCH: I2C2 con=%#x stat=%#x add=%#x lc=%#x (read only)\n",
+			    a5touch_read(i2c, 0), a5touch_read(i2c, 4),
+			    a5touch_read(i2c, 8), a5touch_read(i2c, 0x10));
+		}
+	}
+}
+#endif
