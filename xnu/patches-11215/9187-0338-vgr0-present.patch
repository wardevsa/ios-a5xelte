+/*
+ * (0338) Scaling by the display, not the Mali (boot-0337: VGR0 showed the test picture full screen). With window 0 on
+ * VGR0 the Mali draws the iOS frame 1:1 (750x1334, 768 pixels a row) into FB or FB2 and VGR0 scales it to the panel
+ * as the panel reads it: a quarter of the pixels written per frame and no bilinear pass over 3.7 Mpixels. The two
+ * buffers and their flips stay as they were (VGR0's BASE_ADDR_Y/PINGPONG/shadow are G1's). Entered on a GPU frame,
+ * after it is drawn; left (window 0 back on G1 at FB) whenever the CPU writes the panel (fallback copy, power-off fade),
+ * and entered again on a later GPU frame, at most once a second. An IDMA read error or a flip not taken: G1 for good.
+ * Boot-arg herovgr=0: never.
+ */
+#define HVG_STRIDE_PX   768u
+#define HVG_VGR0_PA     0x13e03000u
+#define HVG_MMU1_PA     0x13e30000u
+static void hg_vgr0_program(vm_offset_t vg, uint32_t pa, uint32_t sw, uint32_t sh, uint32_t stride_px, uint32_t dw, uint32_t dh);
+static uint32_t hg_decon_measure(vm_offset_t decon, const char *when);
+static vm_offset_t hvg_decon, hvg_vgr, hvg_mmu;
+static uint32_t hvg_w, hvg_h;
+static uint64_t hvg_left_at, hvg_entries;
+
+/* Can window 0 go to VGR0 for a w x h frame now? */
+static bool
+hvg_wanted(uint32_t w, uint32_t h)
+{
+	if (hvg_state != 0 || hfb_state != 1 || w > HVG_STRIDE_PX || h > HG_PANEL_H || w < 64 || h < 64) {
+		return false;
+	}
+	if (hvg_left_at && mach_absolute_time() - hvg_left_at < 26000000u) {      /* 1 s at 26 MHz */
+		return false;
+	}
+	if (!hvg_decon) {
+		uint32_t on = 1;
+		PE_parse_boot_argn("herovgr", &on, sizeof(on));
+		vm_offset_t pmu1 = ml_io_map(0x105c4000u, 0x1000);
+		if (!on || !pmu1 || (hg_rd(pmu1, 0x1a4) & 0xfu) != 0xfu) {
+			printf("HEROLTE VGR0 PRESENT: %s; scaling stays on the GPU\n", on ? "DISP1 off" : "herovgr=0");
+			hvg_state = -1;
+			return false;
+		}
+		hvg_vgr = ml_io_map(HVG_VGR0_PA, 0x1000);
+		hvg_mmu = ml_io_map(HVG_MMU1_PA, 0x1000);
+		hvg_decon = ml_io_map(HG_DECON_F_PA, 0x1000);
+		vm_offset_t cmu1 = ml_io_map(0x13f00000u, 0x1000), top = ml_io_map(0x10570000u, 0x1000);
+		if (!hvg_vgr || !hvg_mmu || !hvg_decon || !cmu1 || !top) {
+			hvg_state = -1;
+			return false;
+		}
+		/*
+		 * boot-0337: with window 0 on VGR0 the panel got a frame every 83.7 ms (75.5 ms reading it): VGR0 ran on the
+		 * 26 MHz oscillator, as DECON's vclk did. CMU_DISP1 (0x13F00000; clk-exynos8890.c, Linux): the user muxes
+		 * ACLK_DISP1_0_400_USER (0x200) and ACLK_DISP1_1_400_USER (0x204), bit 12, oscclk or CMU_TOP's
+		 * gout_top_aclk_disp1_{0,1}_400 (TOP mux 0x274/0x278 with its gate in bit 21, divider 0x3d4/0x3d8, enable
+		 * 0x834/0x838 bit 0). Boot-arg herovgrclk=0 leaves them.
+		 */
+		printf("HEROLTE VGR0 PRESENT: disp1 user mux %#x %#x %#x | top mux %#x %#x div %#x %#x enable %#x %#x\n",
+		    hg_rd(cmu1, 0x200), hg_rd(cmu1, 0x204), hg_rd(cmu1, 0x224), hg_rd(top, 0x274), hg_rd(top, 0x278),
+		    hg_rd(top, 0x3d4), hg_rd(top, 0x3d8), hg_rd(top, 0x834), hg_rd(top, 0x838));
+		uint32_t clk = 1;
+		PE_parse_boot_argn("herovgrclk", &clk, sizeof(clk));
+		for (unsigned i = 0; clk && i < 2; i++) {
+			uint32_t user = 0x200 + i * 4, tmux = 0x274 + i * 4, ten = 0x834 + i * 4;
+			if (hg_rd(cmu1, user) & (1u << 12)) {
+				continue;
+			}
+			hg_wr(top, tmux, hg_rd(top, tmux) | (1u << 21));
+			hg_wr(top, ten, hg_rd(top, ten) | 1u);
+			delay(10);
+			hg_wr(cmu1, user, hg_rd(cmu1, user) | (1u << 12));
+			delay(100);
+		}
+		printf("HEROLTE VGR0 PRESENT: disp1 user mux now %#x %#x\n", hg_rd(cmu1, 0x200), hg_rd(cmu1, 0x204));
+	}
+	return true;
+}
+
+static bool
+hvg_window_update(void)
+{
+	hg_wr(hvg_decon, 0x60, hg_rd(hvg_decon, 0x60) | 1u);          /* SHADOW_REG_UPDATE_REQ_WIN(0) */
+	for (unsigned us = 0; us < 50000; us += 20) {
+		if (!(hg_rd(hvg_decon, 0x60) & 1u)) {
+			return true;
+		}
+		delay(20);
+	}
+	return false;
+}
+
+/* The frame just drawn at pa (w x h, HVG_STRIDE_PX a row) goes on screen through VGR0. */
+static void
+hvg_enter(uint64_t pa, uint32_t w, uint32_t h)
+{
+	uint32_t wc = hg_rd(hvg_decon, 0x130);
+	if (!(wc & 1u) || ((wc >> 12) & 7u) != 0) {
+		printf("HEROLTE VGR0 PRESENT: window 0 control %#x is not on G1; scaling stays on the GPU\n", wc);
+		hvg_state = -1;
+		return;
+	}
+	if (hg_rd(hvg_mmu, 0x0) != 0) {
+		hg_wr(hvg_mmu, 0x0, 0);                                 /* SysMMU bypass: VGR0 reads physical addresses */
+	}
+	hg_vgr0_program(hvg_vgr, (uint32_t)pa, w, h, HVG_STRIDE_PX, HG_PANEL_W, HG_PANEL_H);
+	hg_wr(hvg_vgr, 0x04, hg_rd(hvg_vgr, 0x04) | (1u << 19));       /* no stale read error */
+	hg_wr(hvg_decon, 0x130, (wc & ~(7u << 12)) | (5u << 12));
+	bool updated = hvg_window_update();
+	hvg_w = w;
+	hvg_h = h;
+	hfb_idma = hvg_vgr;
+	hvg_state = 1;
+	if (++hvg_entries <= 3 || hvg_entries % 100 == 0 || !updated) {
+		printf("HEROLTE VGR0 PRESENT: window 0 on VGR0 (%u), %ux%u at %#llx scaled to the panel%s\n", (unsigned)hvg_entries,
+		    w, h, pa, updated ? "" : "; the window update was not taken in 50 ms");
+	}
+	/* The first time: does the panel still get 60 frames a second (12 in 200 ms)? Under 10: back to G1 for good. */
+	if (hvg_entries == 1) {
+		uint32_t frames = hg_decon_measure(hvg_decon, "window 0 on VGR0");
+		if (frames < 10) {
+			hvg_leave("VGR0 too slow for the panel's 60 Hz");
+			hvg_state = -1;
+		}
+	}
+}
+
+static void
+hvg_leave(const char *why)
+{
+	if (hvg_state != 1) {
+		return;
+	}
+	/* G1 to FB first (it takes it when it reads again), then window 0 to G1 */
+	hg_wr(hfb_g1, 0x74, (uint32_t)HG_FB_PA);
+	hg_wr(hfb_g1, 0x1c, 1);
+	uint32_t wc = hg_rd(hvg_decon, 0x130);
+	hg_wr(hvg_decon, 0x130, wc & ~(7u << 12));
+	bool updated = hvg_window_update();
+	hfb_idma = hfb_g1;
+	hvg_state = 0;
+	hvg_left_at = mach_absolute_time();
+	if (hvg_entries <= 3 || hvg_entries % 100 == 0 || !updated) {
+		printf("HEROLTE VGR0 PRESENT: window 0 back on G1: %s%s\n", why, updated ? "" : "; the window update was not taken in 50 ms");
+	}
+}
