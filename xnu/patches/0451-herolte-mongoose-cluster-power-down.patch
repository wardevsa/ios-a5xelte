herolte: cluster power-down (CPD) of the Mongoose cluster, heroidle bit 16 (0451)

min78/min79/min80 (E-0294..E-0296): the cores sleep 97-99% of the time and one, three or six of them in CPU_SUSPEND changes nothing (~495 mA): a core in suspend leaves the cluster's L2 and shared logic powered, and cpu4 was never in the mask. Samsung's CPD: the last core of the non-boot cluster to go idle, with every other core of it already in suspend, sets PMU CPUSEQ_OPTION bit 0 (0x2488 + 0x20*cluster) before its own CPU_SUSPEND; the first to wake clears it. 0451 does the same for cpu4-7 (heroidle=<mask 0xf0> | cap<<8 | 1<<16: 91376 = mask 0xf0, 100 ms, CPD) and prints the sequencer bit, the NONCPU and L2 status of the cluster and the set/clear counts in the HEROLTE IDLE line. Whether the monitor flushes the cluster's L2 is unknown: a panic or hang is the stop condition. heroidle only (D-0089).

--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -494,8 +494,30 @@
 volatile uint64_t herolte_idle_enter[MAX_CPUS], herolte_idle_resume[MAX_CPUS], herolte_idle_since[MAX_CPUS];
 volatile uint64_t herolte_idle_arm[MAX_CPUS];        /* 0440: arm_init_idle_cpu reached (MMU on) */
 volatile uint64_t herolte_idle_cap_ticks;       /* 0449: longest sleep, in 26 MHz ticks (0 = 5 ms); heroidle bits 8-15 are the cap in ms */
-volatile uint64_t herolte_idle_pop[MAX_CPUS];        /* 0445: the next timer pop of a core when it went to sleep (what the broadcast tick of herolte_gpu.c wakes it for) */
 volatile uint64_t herolte_idle_pmu_cfg[MAX_CPUS];   /* 0441: VA of each core's PMU CONFIGURATION register (PMU+0x2000+0x80*(Aff1<<2|Aff0)); 0 = not mapped: no deep idle */
+volatile uint32_t herolte_cpd_enable;           /* 0451: heroidle bit 16: cluster power-down of the Mongoose cluster (all of cpu4-7 in the mask) */
+volatile uint32_t herolte_cpd_on;
+volatile uint64_t herolte_cpd_set, herolte_cpd_clear;
+/*
+ * 0451: Samsung's CPD (exynos-powermode.c enter_c2 -> exynos_cpu.cluster_down; exynos-pmu.c exynos_cpu_sequencer_ctrl): the LAST core
+ * of the non-boot cluster to go idle, when every core of the cluster is already in C2 and its next event is at least 3 ms away,
+ * sets bit 0 of PMU CPUSEQ_OPTION (0x2488 + 0x20 * cluster) before its own CPU_SUSPEND; the first core to wake clears it
+ * (wakeup_from_c2 -> cluster_up). Cluster 0 (Aff1 = 0) is the Mongoose cluster; its registers sit at PMU+0x2000+0x488, found
+ * from cpu4's CONFIGURATION register (PMU+0x2000). A core in suspend alone leaves the cluster's L2 and shared logic powered (min78 /
+ * min79: ~495 mA either way), which is the reading of E-0294/E-0295 this tests.
+ */
+static void
+herolte_cpd_release(unsigned c)
+{
+	if (c >= 4 && c < 8 && herolte_cpd_on && herolte_idle_pmu_cfg[4]) {
+		volatile uint32_t *seq = (volatile uint32_t *)(herolte_idle_pmu_cfg[4] + 0x488);
+		*seq = *seq & ~1u;
+		__builtin_arm_dsb(DSB_SY);
+		herolte_cpd_on = 0;
+		herolte_cpd_clear++;
+	}
+}
+volatile uint64_t herolte_idle_pop[MAX_CPUS];        /* 0445: the next timer pop of a core when it went to sleep (what the broadcast tick of herolte_gpu.c wakes it for) */
 
