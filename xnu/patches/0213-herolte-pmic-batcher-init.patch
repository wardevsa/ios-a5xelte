+	    ht_rd(ht_pm, PM_BAT_CON), ht_rd(ht_pm, PM_BAT_STATE), ht_rd(ht_pm, PM_BAT_INT_STAT),
+	    ht_rd(ht_pm, 0x50c));
+}
+
+/*
+ * exynos5_i2c_probe() for a batcher bus: clear pending interrupts, SW
+ * reset, then exynos5_i2c_init(): master, trailing count, the HS master
+ * code (bus 15: MASTER_ID = (15 & 7) + 8) and CONF HS | AUTO.
+ */
+static void
+pm_bus_init(void)
+{
+	ht_wr(ht_pm, HSI2C_INT_STAT, ht_rd(ht_pm, HSI2C_INT_STAT));
+	ht_wr(ht_pm, HSI2C_CTL, ht_rd(ht_pm, HSI2C_CTL) | (1u << 31));
+	ht_wr(ht_pm, HSI2C_CTL, ht_rd(ht_pm, HSI2C_CTL) & ~(1u << 31));
+	ht_wr(ht_pm, HSI2C_CTL, 1u << 3);
+	ht_wr(ht_pm, HSI2C_TRAILING, 0xfu);
+	ht_wr(ht_pm, HSI2C_ADDR, 0x0fu << 24);
+	ht_wr(ht_pm, HSI2C_CONF, ht_rd(ht_pm, HSI2C_CONF) | (1u << 29) | (1u << 31));
+}
+
+/* Linux recover_batcher()/reset_batcher() for a stuck program. */
+static void
+pm_batcher_recover(uint32_t state)
+{
+	if (state >= (1u << 6) && state <= (1u << 13)) {
+		ht_wr(ht_pm, PM_BAT_CON, 1u << 31);
+		ht_wr(ht_pm, PM_BAT_CON, 0);
+		if (ht_rd(ht_pm, PM_BAT_STATE) & 1u) {
+			ht_wr(ht_pm, PM_BAT_STATE, 1u);
+		}
+		pm_bus_init();
+		ht_wr(ht_pm, PM_BAT_CON, 0);
+		ht_wr(ht_pm, PM_SMRELEASE, 1u);
+	}
+	ht_wr(ht_pm, PM_BAT_CON, 0);
+}
+
+/*
