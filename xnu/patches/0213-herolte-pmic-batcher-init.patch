-	return pm_message(false, &reg, 1, false) && pm_message(true, value, 1, true);
+	return pm_message(false, &reg, 1, pm_read_form == 2, false) &&
+	       pm_message(true, value, 1, true, pm_read_form == 0);
 }
 
