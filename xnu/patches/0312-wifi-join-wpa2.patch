--- a/bsd/dev/herolte_wifi.c
+++ b/bsd/dev/herolte_wifi.c
@@ -290,8 +290,16 @@ hw_console(uint32_t console, uint32_t *done)
 #define MSG_WL_EVENT            0xe
 
 #define WLC_UP          2
+#define WLC_SET_INFRA   20
+#define WLC_GET_BSSID   23
+#define WLC_SET_SSID    26
+#define WLC_GET_RSSI    127
 #define WLC_GET_VAR     262
 #define WLC_SET_VAR     263
+#define WLC_SET_WSEC_PMK 268
+#define E_SET_SSID      0
+#define E_LINK          16
+#define E_PSK_SUP       46
 #define E_ESCAN_RESULT  69
 
 static vm_offset_t hw_dma;
@@ -303,6 +311,8 @@ static uint16_t hw_resp_len;
 static uint32_t hw_resp_id;
 static bool hw_resp_seen;
 static unsigned hw_ssids;
+static bool hw_link, hw_keyed;
+static int hw_joined;
 static char hw_ssid_seen[48][33];
 
 static uint16_t
@@ -416,7 +426,15 @@ hw_event(const volatile uint8_t *pkt, uint16_t len)
 	}
 	uint32_t type = hw_get32be(pkt + 28), status = hw_get32be(pkt + 32), datalen = hw_get32be(pkt + 44);
 	if (type != E_ESCAN_RESULT) {
-		printf("HEROLTE WIFI: event %u status %u\n", type, status);
+		unsigned flags = ((unsigned)pkt[26] << 8) | pkt[27];
+		printf("HEROLTE WIFI: event %u status %u reason %u flags %#x\n", type, status, hw_get32be(pkt + 36), flags);
+		if (type == E_LINK) {
+			hw_link = (flags & 1) != 0;
+		} else if (type == E_PSK_SUP) {
+			hw_keyed = status == 6;                 /* FWSUP_COMPLETED */
+		} else if (type == E_SET_SSID) {
+			hw_joined = status == 0 ? 1 : -1;
