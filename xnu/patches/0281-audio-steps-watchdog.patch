+/*
+ * A wrong step here hangs the whole bus, with the big cores left burning (50 C). The watchdog restarts the phone then,
+ * into recovery as INFORM3 says, and each step waits for the log's flush (10 s) so the last one is on disk.
+ */
+static vm_offset_t ha_wdt;
+
+static void
+ha_step(const char *what)
+{
+	printf("HEROLTE AUDIO: step: %s\n", what);
+	hg_wr(ha_wdt, 8, 0xffff);
+	hg_msleep(11000);
+	hg_wr(ha_wdt, 8, 0xffff);
+}
+
+static void
+ha_guard(vm_offset_t pmu)
+{
+	ha_wdt = ml_io_map(0x10020000u, 0x1000);
+	hg_wr(pmu, 0x808, 0x12345678);
+	hg_wr(pmu, 0x80c, 0x12345674);
+	hg_wr(pmu, 0x408, hg_rd(pmu, 0x408) & ~(1u << 24));
+	hg_wr(pmu, 0x40c, hg_rd(pmu, 0x40c) & ~(1u << 24));
+	hg_wr(ha_wdt, 4, 0xffff);
+	hg_wr(ha_wdt, 8, 0xffff);
+	hg_wr(ha_wdt, 0, (0xffu << 8) | (3u << 3) | (1u << 5) | 1u);    /* /256 /128, enabled, reset */
+	printf("HEROLTE AUDIO: watchdog armed, con %#x\n", hg_rd(ha_wdt, 0));
+}
+
