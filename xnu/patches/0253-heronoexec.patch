+/*
+ * boot-arg heronoexec=name,name: these programs do not start (exec fails
+ * with EPERM, launchd throttles and gives up). On the S7 vmd sat at two
+ * full cores from its launch on, with or without swap (vm_compressor=2),
+ * and bluetoothd (no Bluetooth driver) was relaunched every few seconds:
+ * together with launchd's respawns, ~3 of the 8 cores the UI needs.
+ */
+static char hgl_noexec[128];
+static int hgl_noexec_init;
+
+static bool
+herolte_noexec(const char *path)
+{
+	if (!hgl_noexec_init) {
+		hgl_noexec_init = 1;
+		if (!PE_parse_boot_argn("heronoexec", hgl_noexec, sizeof(hgl_noexec))) {
+			hgl_noexec[0] = '\0';
+		}
+	}
+	if (hgl_noexec[0] == '\0' || path == NULL) {
+		return false;
+	}
+	const char *base = strrchr(path, '/');
+	base = base ? base + 1 : path;
+	size_t n = strlen(base);
+	for (const char *t = hgl_noexec; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, base, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
 int
 herolte_gl_env(const char *path, int pid, const char **extra, int max)
 {
+	if (herolte_noexec(path)) {
+		static unsigned refused;
+		if (refused++ < 20) {
+			printf("HEROLTE NOEXEC: %s refused (heronoexec)\n", path);
+		}
+		return -1;
+	}
 	if (hgl_mode < 0) {
 		hgl_mode = 0;
 		PE_parse_boot_argn("herogl", &hgl_mode, sizeof(hgl_mode));
