+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * Safari's pages stay black (boot-0316) and nothing of WebKit's showed in the log: the creates are said only
+ * for the first 64 of the boot, the selectors once for all processes. WebKit's own processes (and Safari)
+ * are said apart: their first 160 calls, each with what it answered.
+ */
+static uint32_t sweet_surf_webkit_said;
+
+static bool
+sweet_surf_webkit(char *name, size_t size)
+{
+	proc_selfname(name, (int)size);
+	return strncmp(name, "com.apple.WebKit", 16) == 0 || strcmp(name, "MobileSafari") == 0;
+}
+#endif
