+++ b/bsd/dev/herolte_gpu.c
@@ -2778,6 +2778,20 @@
 					printf("HEROLTE IDLE: cpu%u has not come back after %llu ms (enter %llu, resume %llu): deep idle off\n", c,
 					    age / NSEC_PER_MSEC, herolte_idle_enter[c], herolte_idle_resume[c]);
 					herolte_idle_mask = 0;
+					/*
+					 * 0439: which kind of failure? PSCI CPU_ON on a core that is OFF returns 0 and brings it up through the
+					 * reset vector (handler resume_idle_cpu: it should come back as from idle); on one that is ON (stuck
+					 * inside the monitor or in our entry) it returns ALREADY_ON (-4) or ON_PENDING (-5).
+					 */
+					{
+						register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
+						register uint64_t x1 __asm__("x1") = c >= 4 ? (uint64_t)(c - 4) : (0x100ull + c);
+						register uint64_t x2 __asm__("x2") = herolte_idle_entry_pa;
+						register uint64_t x3 __asm__("x3") = c;
+						__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+						    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+						printf("HEROLTE IDLE: cpu%u CPU_ON recovery -> %d (0 = it was OFF; -4 ALREADY_ON; -5 ON_PENDING)\n", c, (int)(int32_t)x0);
+					}
 				} else if (age > 150ull * NSEC_PER_MSEC) {
 					a5xelte_send_ipi(c);
 					idle_ipis++;
