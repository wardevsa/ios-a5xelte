diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index 97613a3..9778ac0 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -74,11 +74,17 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
+	/* boot-arg sweetsample_s=N: seconds between samples, for catching what a stall is */
+	int seconds = 120;
+	PE_parse_boot_argn("sweetsample_s", &seconds, sizeof(seconds));
+	if (seconds < 1) {
+		seconds = 1;
+	}
 	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", seconds * hz);
 	}
 }
 
