diff --git a/osfmk/arm64/hakios_ram_banks.h b/osfmk/arm64/hakios_ram_banks.h
new file mode 100644
index 0000000..81f4f8c
--- /dev/null
+++ b/osfmk/arm64/hakios_ram_banks.h
@@ -0,0 +1,134 @@
+/* Shared loader/VM model for discontinuous physical RAM.
+ * Only firmware-claimed, reservation-filtered ranges may be added here.
+ * Bank order defines compact metadata indices; physical addresses need not be ordered.
+ * This model never makes a physical gap into managed memory.
+ */
+#ifndef HAKIOS_RAM_BANKS_H
+#define HAKIOS_RAM_BANKS_H
+
+#include <stdint.h>
+
+#define HAKIOS_RAM_BANK_MAX 16u     /* HEROLTE: 7 used (bank 2 and six pieces of bank 1); phystokv walks the PTOV table */
+
+struct hakios_ram_bank {
+    uint64_t base;
+    uint64_t pages;
+    uint64_t first_index;
+};
+
+struct hakios_ram_banks {
+    uint32_t count;
+    uint32_t page_shift;
+    uint64_t total_pages;
+    struct hakios_ram_bank bank[HAKIOS_RAM_BANK_MAX];
+};
+
+#if defined(KERNEL)
+extern struct hakios_ram_banks hakios_managed_ram;
+uint64_t hakios_ram_pmap_index(uint64_t address);
+uint64_t hakios_ram_pmap_pa(uint64_t index);
+void hakios_ram_set_vm_first_page(uint64_t ppnum);
+uint64_t hakios_ram_vm_page_pa(uint64_t index);
+#endif
+
+enum hakios_ram_result {
+    HAKIOS_RAM_OK = 0,
+    HAKIOS_RAM_INVALID,
+    HAKIOS_RAM_OVERLAP,
+    HAKIOS_RAM_FULL,
+    HAKIOS_RAM_OVERFLOW
+};
+
+static inline int
+hakios_ram_banks_init(struct hakios_ram_banks *table, uint32_t page_shift)
+{
+    if (page_shift < 12 || page_shift > 16) return HAKIOS_RAM_INVALID;
+    *table = (struct hakios_ram_banks){ .page_shift = page_shift };
+    return HAKIOS_RAM_OK;
+}
+
+/* Append preserves every previously assigned index. Only forward adjacency to
+ * the final bank is merged, so coalescing cannot reorder existing pages. */
+static inline int
+hakios_ram_bank_add_mode(struct hakios_ram_banks *table, uint64_t base, uint64_t bytes, int merge_adjacent)
+{
+    if (table->page_shift < 12 || table->page_shift > 16 || table->count > HAKIOS_RAM_BANK_MAX)
+        return HAKIOS_RAM_INVALID;
+    uint64_t mask = (UINT64_C(1) << table->page_shift) - 1;
+    if (!bytes || ((base | bytes) & mask)) return HAKIOS_RAM_INVALID;
+    if (bytes > UINT64_MAX - base) return HAKIOS_RAM_OVERFLOW;
+    uint64_t end = base + bytes;
+    uint64_t pages = bytes >> table->page_shift;
+    if (pages > (UINT64_MAX >> table->page_shift) - table->total_pages)
+        return HAKIOS_RAM_OVERFLOW;
+    for (uint32_t i = 0; i < table->count; ++i) {
+        const struct hakios_ram_bank *bank = &table->bank[i];
+        uint64_t bank_end = bank->base + (bank->pages << table->page_shift);
+        if (base < bank_end && bank->base < end) return HAKIOS_RAM_OVERLAP;
+    }
+    if (table->count && merge_adjacent) {
+        struct hakios_ram_bank *last = &table->bank[table->count - 1];
+        if (last->base + (last->pages << table->page_shift) == base) {
+            last->pages += pages;
+            table->total_pages += pages;
+            return HAKIOS_RAM_OK;
+        }
+    }
+    if (table->count == HAKIOS_RAM_BANK_MAX) return HAKIOS_RAM_FULL;
+    table->bank[table->count++] = (struct hakios_ram_bank){
+        .base = base, .pages = pages, .first_index = table->total_pages };
+    table->total_pages += pages;
+    return HAKIOS_RAM_OK;
+}
+
+static inline int
+hakios_ram_bank_add(struct hakios_ram_banks *table, uint64_t base, uint64_t bytes)
+{
+    return hakios_ram_bank_add_mode(table, base, bytes, 1);
+}
+
+/* Accept page-interior addresses, as pmap's pa_valid/pa_index do. */
+static inline int
+hakios_ram_pa_index(const struct hakios_ram_banks *table, uint64_t address, uint64_t *index)
+{
+    for (uint32_t i = 0; i < table->count; ++i) {
+        const struct hakios_ram_bank *bank = &table->bank[i];
+        if (address >= bank->base) {
+            uint64_t page = (address - bank->base) >> table->page_shift;
+            if (page < bank->pages) {
+                *index = bank->first_index + page;
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+
+static inline int
+hakios_ram_index_pa(const struct hakios_ram_banks *table, uint64_t index, uint64_t *address)
+{
+    if (index >= table->total_pages) return 0;
+    for (uint32_t i = 0; i < table->count; ++i) {
+        const struct hakios_ram_bank *bank = &table->bank[i];
+        if (index >= bank->first_index && index - bank->first_index < bank->pages) {
+            *address = bank->base + ((index - bank->first_index) << table->page_shift);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Bound a physical/DMA operation to one real contiguous bank. */
+static inline uint64_t
+hakios_ram_contiguous_bytes(const struct hakios_ram_banks *table, uint64_t address)
+{
+    for (uint32_t i = 0; i < table->count; ++i) {
+        const struct hakios_ram_bank *bank = &table->bank[i];
+        uint64_t bytes = bank->pages << table->page_shift;
+        if (address >= bank->base && address - bank->base < bytes)
+            return bytes - (address - bank->base);
+    }
+    return 0;
+}
+
+#endif
diff --git a/osfmk/arm64/hakios_ram_banks.inc b/osfmk/arm64/hakios_ram_banks.inc
new file mode 100644
index 0000000..22971f0
--- /dev/null
+++ b/osfmk/arm64/hakios_ram_banks.inc
@@ -0,0 +1,107 @@
+/* Included by arm_vm_init.c after its physical-window globals.
+ * boot_args retains the primary contiguous bootstrap window. Only the explicit,
+ * opt-in DT bank list contributes extra pages; gaps never enlarge that window.
+ */
+#include <arm64/hakios_ram_banks.h>
+
+SECURITY_READ_ONLY_LATE(struct hakios_ram_banks) hakios_managed_ram;
+SECURITY_READ_ONLY_LATE(static uint64_t) hakios_vm_first_ram_index;
+
+uint64_t
+hakios_ram_pmap_index(uint64_t address)
+{
+    uint64_t index;
+    if (!hakios_ram_pa_index(&hakios_managed_ram, address, &index))
+        panic("ram_banks: unmanaged physical address 0x%llx", address);
+    return index;
+}
+
+uint64_t
+hakios_ram_pmap_pa(uint64_t index)
+{
+    uint64_t address;
+    if (!hakios_ram_index_pa(&hakios_managed_ram, index, &address))
+        panic("ram_banks: invalid metadata index 0x%llx", index);
+    return address;
+}
+
+void
+hakios_ram_set_vm_first_page(uint64_t ppnum)
+{
+    if (hakios_managed_ram.count > 1)
+        hakios_vm_first_ram_index = hakios_ram_pmap_index(ppnum << PAGE_SHIFT);
+}
+
+uint64_t
+hakios_ram_vm_page_pa(uint64_t index)
+{
+    if (index > UINT64_MAX - hakios_vm_first_ram_index)
+        panic("ram_banks: VM page index overflow");
+    return hakios_ram_pmap_pa(hakios_vm_first_ram_index + index);
+}
+
+static uint64_t
+hakios_ram_extra_bytes(void)
+{
+    if (hakios_managed_ram.count <= 1) return 0;
+    return (hakios_managed_ram.total_pages - hakios_managed_ram.bank[0].pages) << PAGE_SHIFT;
+}
+
+/* The primary mapping may include the KASAN shadow or an unused capped tail,
+ * whereas additional mappings must end at their own bank's exact boundary. */
+static pmap_paddr_t
+hakios_ram_mapping_end(pmap_paddr_t address)
+{
+    if (address >= gPhysBase && address < real_avail_end) return real_avail_end;
+    for (uint32_t i = 1; i < hakios_managed_ram.count; ++i) {
+        const struct hakios_ram_bank *bank = &hakios_managed_ram.bank[i];
+        uint64_t size = bank->pages << PAGE_SHIFT;
+        if (address >= bank->base && address - bank->base < size) return bank->base + size;
+    }
+    return 0;
+}
+
+static uint64_t
+hakios_ram_boot_memory_size(boot_args *args, uint64_t limit)
+{
+    /*
+     * HEROLTE: on whenever the ADT has the list (mkadt_herolte.py --bank1), boot-arg ram_banks=0 turns it off: the
+     * boot line has no room left for an opt-in. Without the list, the one boot bank, as before.
+     */
+    int enabled = 1;
+    PE_parse_boot_argn("ram_banks", &enabled, sizeof(enabled));
+    if (enabled != 1)
+        return gPhysSize;
+    DTEntry chosen;
+    void *property = NULL;
+    unsigned int length = 0;
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTGetProperty(chosen, "hakios-ram-banks", &property, &length) != kSuccess || !property || !length)
+        return gPhysSize;
+    if (length % 16 || length / 16 > HAKIOS_RAM_BANK_MAX)
+        panic("ram_banks: malformed claimed-bank list");
+    struct { uint64_t base, bytes; } range;
+    if (hakios_ram_banks_init(&hakios_managed_ram, PAGE_SHIFT) != HAKIOS_RAM_OK)
+        panic("ram_banks: unsupported page size");
+    uint64_t remaining = limit ? (limit & ~((uint64_t)PAGE_MASK)) : UINT64_MAX;
+    for (unsigned int i = 0; i < length / 16; ++i) {
+        memcpy(&range, (const char *)property + i * 16, sizeof(range));
+        if (i == 0 && (range.base != args->physBase || range.bytes != args->memSize))
+            panic("ram_banks: primary bank differs from boot_args");
+        if (!remaining) break;
+        if (range.bytes > remaining) range.bytes = remaining;
+        /* Keep the bootstrap bank boundary even if another claim is adjacent. */
+        if (hakios_ram_bank_add_mode(&hakios_managed_ram, range.base, range.bytes, 0) != HAKIOS_RAM_OK)
+            panic("ram_banks: invalid, overlapping or overflowing bank %u", i);
+        remaining -= range.bytes;
+    }
+    if (!hakios_managed_ram.count) panic("ram_banks: no usable memory");
+#if KASAN || XNU_MONITOR
+    if (hakios_managed_ram.count > 1)
+        panic("ram_banks: extra banks require the generic non-KASAN pmap configuration");
+#endif
+    uint64_t bytes = hakios_managed_ram.total_pages << PAGE_SHIFT;
+    kprintf("ram_banks: %u claimed banks, %llu MiB managed, primary %llu MiB\n",
+            hakios_managed_ram.count, bytes >> 20, hakios_managed_ram.bank[0].pages >> (20 - PAGE_SHIFT));
+    return bytes;
+}
