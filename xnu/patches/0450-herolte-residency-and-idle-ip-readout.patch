+					prev_busy[cc] = b;
+					prev_idle[cc] = i;
+					uint64_t tot = db + di;
+					printf(" cpu%d busy %llu.%llu%% idle %llu.%llu%%", cc, tot ? db * 100 / tot : 0, tot ? (db * 1000 / tot) % 10 : 0,
+					    tot ? di * 100 / tot : 0, tot ? (di * 1000 / tot) % 10 : 0);
+				}
