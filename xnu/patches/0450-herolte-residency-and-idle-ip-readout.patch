herolte: read-only residency per core and the PMU idle-IP words, once a minute (0450)

min78/min79 (E-0294, E-0295): deep idle of cores does not lower the screen-off current (~495 mA with 0, 1 or 6 cores; Linux 25-35 mA). Samsung's Linux gets there by cluster power-down (CPD, non-boot cluster only) and system idle (SICD, entered by a boot-cluster core when every online core is in C2 with an event farther than the residency and the PMU idle-IP words say every non-masked block is idle). 0450 measures the two things the design needs before anything is written: HEROLTE RESIDENCY (busy/idle share of each core in the last minute) and HEROLTE IDLEIP (PMU 0x3e0-0x3ec status and 0x3f0-0x3fc masks). No argument: a line a minute with the other POWER lines. Read only.

--- a/osfmk/kern/processor.c
+++ b/osfmk/kern/processor.c
@@ -1749,3 +1749,23 @@
 	}
 	return busy;
 }
+
+/*
+ * 0450: the busy and idle time of ONE core since boot, in Mach time, for the HEROLTE RESIDENCY line (bsd/dev/herolte_gpu.c).
+ * Read only. recount's idle time includes the interval of an idle that is still going on.
+ */
+void herolte_cpu_times_mach(int cpu, uint64_t *busy, uint64_t *idle);
+void
+herolte_cpu_times_mach(int cpu, uint64_t *busy, uint64_t *idle)
+{
+	*busy = 0;
+	*idle = 0;
+	processor_t p = cpu_to_processor(cpu);
+	if (p != PROCESSOR_NULL) {
+		struct recount_usage usage = { 0 };
+		uint64_t idle_time = 0;
+		recount_processor_usage(&p->pr_recount, &usage, &idle_time);
+		*busy = usage.ru_user_time_mach + usage.ru_system_time_mach;
+		*idle = idle_time;
+	}
+}
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -3035,6 +3035,37 @@
