+					    hg_rd(pmu0, 0x3e8), hg_rd(pmu0, 0x3ec), hg_rd(pmu0, 0x3f0), hg_rd(pmu0, 0x3f4), hg_rd(pmu0, 0x3f8), hg_rd(pmu0, 0x3fc));
+				}
