 			seen_max = -1000;
 			/*
+			 * 0450: read-only measurements for the system-idle design (docs/S7GE_ENERGIA_SISTEMA_ARQUITECTURA_20261118.md).
+			 * (a) HEROLTE RESIDENCY: per core, busy and idle share of the last minute (recount). (b) HEROLTE IDLEIP: the PMU's
+			 * idle-IP words (PMU 0x3e0-0x3ec: a 0 is a block that is NOT idle) and their masks (0x3f0-0x3fc), which in Samsung's
+			 * Linux (exynos-powermode.c exynos_check_idle_ip_stat) decide whether the system may enter SICD; which bit is which
+			 * block is in the BOOT DTB (the idle-ip property of the power-mode node).
+			 */
+			{
+				extern void herolte_cpu_times_mach(int cpu, uint64_t *busy, uint64_t *idle);
+				static uint64_t prev_busy[8], prev_idle[8];
