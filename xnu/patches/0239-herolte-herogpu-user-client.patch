+/*
+ * HeroGPU (iokit/Kernel/arm/HeroGPU.cpp): user-space GPU jobs, the kernel
+ * half of a Panfrost-style driver. Buffers get GPU VAs in the user range
+ * (64 KiB aligned, never reused yet) and are mapped noncached like
+ * everything else (the Mali is not IO-coherent; user mappings are
+ * write-combined). Jobs run one at a time under hg_mtx, polled.
+ */
+bool
+herolte_gpu_up(void)
+{
+	lck_mtx_lock(hg_mtx);
+	bool ok = hg_bringup();
+	lck_mtx_unlock(hg_mtx);
+	return ok;
+}
+
+/* A GPU register (GPU_ID, *_PRESENT, *_FEATURES...), for GetParam. */
+uint32_t
+herolte_gpu_reg(uint32_t off)
+{
+	if (hg_up_state != 1 || off >= 0x1000 || (off & 3)) {
+		return 0;
+	}
+	return hg_rd(hg_gpu, off);
+}
+
+uint64_t
+herolte_gpu_va_alloc(uint64_t bytes)
+{
+	lck_mtx_lock(hg_mtx);
+	uint64_t va = (hgu_next_va + 0xffff) & ~0xffffull;
+	uint64_t end = va + ((bytes + 0xfff) & ~0xfffull);
+	if (hg_up_state != 1 || bytes == 0 || end > HGU_VA_END) {
+		va = 0;
+	} else {
+		hgu_next_va = end;
+	}
+	lck_mtx_unlock(hg_mtx);
+	return va;
+}
+
+/* PTEs for n 4 KiB pages at va (pages == NULL: unmap), then an MMU flush. */
+static bool
+hgu_set_locked(uint64_t va, const uint64_t *pages, unsigned n)
+{
+	volatile uint64_t *l2 = (volatile uint64_t *)(hgp_scr + HGU_L2_OFF);
+	for (unsigned i = 0; i < n; i++) {
+		uint64_t a = va + (uint64_t)i * 0x1000;
+		if (a < HGU_VA_BASE || a >= HGU_VA_END) {
+			return false;
+		}
+		unsigned l2i = (unsigned)((a >> 21) & 0x1ff);
+		if (hgu_l3_of[l2i] == 0) {
+			if (pages == NULL) {
+				continue;
+			}
+			if (hgu_l3_used >= HGU_L3_MAX) {
+				printf("HEROLTE GPU: user L3 pool exhausted\n");
+				return false;
+			}
+			uint32_t table = HGU_L3_OFF + hgu_l3_used * 0x1000;
+			hg_zero(hgp_scr + table, 0x1000);
+			hgu_l3_of[l2i] = (uint16_t)(++hgu_l3_used);
+			l2[l2i] = (HG_SCR_PA + table) | 3;
+		}
+		volatile uint64_t *l3 = (volatile uint64_t *)(hgp_scr + HGU_L3_OFF +
+		    (hgu_l3_of[l2i] - 1u) * 0x1000);
+		l3[(a >> 12) & 0x1ff] = pages ? ((pages[i] & ~0xfffull) | 0x2c1) : 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return hgp_mmu_flush(HGU_VA_BASE, 30);
+}
+
+bool
+herolte_gpu_map(uint64_t va, const uint64_t *pages, unsigned n)
+{
+	lck_mtx_lock(hg_mtx);
+	bool ok = hg_up_state == 1 && hgu_set_locked(va, pages, n);
+	lck_mtx_unlock(hg_mtx);
+	return ok;
+}
+
+void
+herolte_gpu_unmap(uint64_t va, unsigned n)
+{
+	lck_mtx_lock(hg_mtx);
+	if (hg_up_state == 1) {
+		(void)hgu_set_locked(va, NULL, n);
+	}
+	lck_mtx_unlock(hg_mtx);
+}
+
+/*
+ * Run the job chain at GPU VA jc on slot js (0: fragment, 1: vertex,
+ * tiler, compute) on all shader cores and wait (bounded). Returns 0 when
+ * it finished cleanly, else JS_STATUS (or ~0 if it never ran); *us = time.
+ */
+uint32_t
+herolte_gpu_submit(unsigned js, uint64_t jc, uint64_t *us)
+{
+	if (js > 1 || jc == 0) {
+		return ~0u;
+	}
+	lck_mtx_lock(hg_mtx);
+	uint32_t status = ~0u;
+	if (hg_up_state == 1) {
+		uint64_t start = mach_absolute_time();
+		hg_affinity = hg_rd(hg_gpu, SHADER_PRESENT_LO);
+		hg_job_va = jc;
+		hg_job_cpu = 0;
+		hg_run_quiet = true;
+		bool ok = hg_run(js, js ? "HEROGPU job JS1" : "HEROGPU job JS0");
+		hg_run_quiet = false;
+		hg_job_va = HG_TEST_VA;
+		hg_affinity = 1;
+		status = ok ? 0 : (hg_last_js_status ? hg_last_js_status : ~0u);
+		if (us) {
+			*us = hg_us_since(start);
+		}
+	}
+	lck_mtx_unlock(hg_mtx);
+	return status;
+}
