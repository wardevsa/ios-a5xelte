diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index e5d0a6c..9a64905 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2526,6 +2526,40 @@ hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 		{ "BUS2", 0x10570000u, 0x140 }, { "BUS3", 0x10570000u, 0x160 },
 	};
 	hg_msleep(30000);
+	/*
+	 * DECON_F, read only: the panel takes a frame in command mode, on its TE pulse. The line counter says when it reads our
+	 * memory: how often (the real refresh), and for how long (a copy into that memory then is what tears).
+	 */
+	vm_offset_t decon = ml_io_map(0x13960000u, 0x1000);
+	for (unsigned round = 0; decon && round < 6; round++) {
+		uint64_t start = mach_absolute_time(), now = start, rise = 0, first = 0, period = 0, active = 0, began = 0;
+		uint32_t top = 0, frames = 0, last = 0;
+		while (now - start < 26000000u / 5u) {  /* 200 ms */
+			uint32_t line = hg_rd(decon, 0x8c) & 0xffff;
+			now = mach_absolute_time();
+			top = line > top ? line : top;
+			if (line != 0 && last == 0) {
+				began = now;
+				if (rise) {
+					period = now - rise;
+				} else {
+					first = now;
+				}
+				rise = now;
+				frames++;
+			} else if (line == 0 && last != 0) {
+				active = now - began;
+			}
+			last = line;
+		}
+		printf("HEROLTE DECON: %u frames in 200 ms, period %llu us, reading %llu us, top line %u; span %llu us\n", frames,
+		    period / 26, active / 26, top, (rise - first) / 26);
+		printf("HEROLTE DECON: control %#x update %#x trig %#x\n", hg_rd(decon, 0), hg_rd(decon, 0x60), hg_rd(decon, 0x70));
+		for (unsigned w = 0; w < 8 && round == 0; w++) {
+			printf("HEROLTE DECON: window %u control %#x end %#x\n", w, hg_rd(decon, 0x130 + w * 0x20), hg_rd(decon, 0x138 + w * 0x20));
+		}
+		hg_msleep(20000);
+	}
 	for (unsigned i = 0; i < sizeof(plls) / sizeof(plls[0]); i++) {
 		vm_offset_t cmu = ml_io_map(plls[i].base, 0x1000);
 		uint32_t con0 = cmu ? hg_rd(cmu, plls[i].con0) : 0;
