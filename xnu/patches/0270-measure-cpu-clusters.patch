diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 1ef54af..cbb7714 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -1961,6 +1961,32 @@ hg_thread(void *arg, __unused wait_result_t wr)
 		uint8_t out = 0;
 		bool read = herolte_apm_pmic_read(0x26, &out);
 		printf("HEROLTE GPU: PMIC G3D out reg 0x26 = %#x (%s)\n", out, read ? "read" : "read failed");
+		/*
+		 * The CPU clusters: their supplies, and how fast each really runs. The
+		 * registers are not read (CMU blocks abort); a one-cycle-per-pass loop
+		 * on a bound thread gives the clock. Mongoose's supply after the
+		 * bootloader is 675 mV, where its table has 912 mV for 1976 MHz.
+		 */
+		uint8_t mngs = 0, apollo = 0;
+		herolte_apm_pmic_read(0x1d, &mngs);
+		herolte_apm_pmic_read(0x1f, &apollo);
+		printf("HEROLTE CPU: vdd_mngs reg %#x = %u uV, vdd_apollo reg %#x = %u uV\n", mngs, 300000 + mngs * 6250u,
+		    apollo, 300000 + apollo * 6250u);
+		extern struct processor *cpu_to_processor(int cpu);
+		extern struct processor *thread_bind(struct processor *processor);
+		static const int cores[] = { 0, 4 };
+		for (unsigned i = 0; i < sizeof(cores) / sizeof(cores[0]); i++) {
+			thread_bind(cpu_to_processor(cores[i]));
+			hg_msleep(1);
+			uint64_t passes = 100000000, count = passes, ns = 0;
+			uint64_t start = mach_absolute_time();
+			__asm__ volatile ("1: subs %0, %0, #1\n b.ne 1b\n" : "+r" (count) :: "cc");
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+			printf("HEROLTE CPU: cpu %d (%s): %llu passes in %llu us, about %llu MHz\n", cores[i],
+			    cores[i] < 4 ? "A53" : "Mongoose", passes, ns / 1000, ns ? passes * 1000 / ns : 0);
+		}
+		thread_bind(NULL);
+		hg_msleep(1);
 	}
 	if (mode >= 2) {
 		hg_pmic_dump();
