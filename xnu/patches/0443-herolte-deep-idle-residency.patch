 				uint64_t age = 0;
 				absolutetime_to_nanoseconds(now - since, &age);
-				if (age > 3000ull * NSEC_PER_MSEC) {
+				if (age > 20000ull * NSEC_PER_MSEC) {
 					printf("HEROLTE IDLE: cpu%u has not come back after %llu ms (enter %llu, resume %llu): deep idle off\n", c,
 					    age / NSEC_PER_MSEC, herolte_idle_enter[c], herolte_idle_resume[c]);
 					herolte_idle_mask = 0;
@@ -2839,7 +2839,7 @@
 							    slot ? slot[0] : 0, slot ? slot[1] : 0, slot ? slot[2] : 0, slot ? slot[3] : 0, herolte_idle_arm[c]);
 						}
 					}
-				} else if (age > 150ull * NSEC_PER_MSEC) {
