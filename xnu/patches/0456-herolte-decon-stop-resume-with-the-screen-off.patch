herolte: stop and resume the display controller with the screen off, reversibly, herodisp=<s> (0456, D-0094)

E-0302: cutting DISP0 halfway took the screen-off current from 432 to 290 mA at once; our display off is only a flag and the DECON keeps scanning. herodisp=<s> (>= 10): with the screen off 30 s the DECON is stopped at the end of the frame (GLOBAL_CONTROL.DECON_EN_F, shadow update, wait for RUN off, 20 ms or put back), <s> seconds later fully (HW trigger masked, DECON_EN cleared). When iOS asks for the display on (SweetFramebuffer, before any frame) and from the power thread as a safety net it is restored in reverse with the saved values, waiting for RUN on. Writes only DECON_F GLOBAL_CONTROL 0x0, SHADOW_REG_UPDATE_REQ 0x60 and HW_SW_TRIG_CONTROL 0x70. Logs HEROLTE DISP lines. herodisp only.

--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2659,6 +2659,86 @@
 	}
 }
 
+/*
+ * 0456 (D-0094): stop and resume the display controller (DECON_F, 0x13960000) while the screen is "off", reversibly.
+ * min86 (E-0302): cutting the DISP0 power domain halfway took the screen-off current from 432 to 290 mA at once, and our "display
+ * off" is only a flag (SweetFramebuffer.cpp: fade to black, 5 ticks a second): the DECON keeps reading the black frame and feeding the
+ * panel. Samsung stops it with decon_reg_stop and starts it with decon_reg_start (decon_reg_8890.c) without touching the domain.
+ * Registers (regs-decon.h): GLOBAL_CONTROL 0x0 (bit0 DECON_EN_F per frame, bit1 DECON_EN, bit4 RUN_STATUS), SHADOW_REG_UPDATE_REQ
+ * 0x60 (bit31 global), HW_SW_TRIG_CONTROL 0x70 (bit5 HW_TRIG_MASK, set = trigger disabled), line counter 0x8c.
+ * Level 1: DECON_EN_F to 0 (stops at the end of the frame: valid for command and video mode), shadow update, wait for RUN off.
+ * Level 2: also mask the HW trigger and clear DECON_EN. Restore (herolte_disp_restore, called when iOS asks for the display on and
+ * from the power thread as a safety net): the saved trigger value back, EN/EN_F as they were, shadow update, wait for RUN on.
+ */
+volatile uint32_t herolte_disp_state;        /* 0 running, 1 per-frame stop, 2 full stop */
+static uint32_t disp_trig_saved, disp_glob_saved;
+static vm_offset_t disp_decon;
+
+static bool
+hg_disp_run_is(bool running, unsigned limit_us)
+{
+	for (unsigned t = 0; t < limit_us; t += 10) {
+		if (((hg_rd(disp_decon, 0x0) >> 4) & 1u) == (running ? 1u : 0u)) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static void
+hg_disp_update(void)
+{
+	hg_wr(disp_decon, 0x60, hg_rd(disp_decon, 0x60) | (1u << 31));
+}
+
+void herolte_disp_restore(void);
+
+void
+herolte_disp_stop(unsigned level)
+{
+	if (!disp_decon) {
+		disp_decon = ml_io_map(0x13960000u, 0x1000);
+	}
+	if (!disp_decon || level < 1 || level > 2 || herolte_disp_state >= level) {
+		return;
+	}
+	uint32_t g0 = hg_rd(disp_decon, 0x0), t0 = hg_rd(disp_decon, 0x70), line0 = hg_rd(disp_decon, 0x8c) & 0xffff;
+	if (herolte_disp_state == 0) {
+		disp_glob_saved = g0;
+		disp_trig_saved = t0;
+	}
+	if (level == 1) {
+		hg_wr(disp_decon, 0x0, g0 & ~1u);
+	} else {
+		hg_wr(disp_decon, 0x70, t0 | (1u << 5));
+		hg_wr(disp_decon, 0x0, hg_rd(disp_decon, 0x0) & ~3u);
+	}
+	hg_disp_update();
+	bool off = hg_disp_run_is(false, 20000);
+	printf("HEROLTE DISP: stop level %u: global %#x -> %#x, trig %#x -> %#x, run %s within 20 ms (line %u -> %u)\n", level, g0,
+	    hg_rd(disp_decon, 0x0), t0, hg_rd(disp_decon, 0x70), off ? "OFF" : "STILL ON", line0, hg_rd(disp_decon, 0x8c) & 0xffff);
+	__atomic_store_n(&herolte_disp_state, level, __ATOMIC_SEQ_CST);
+	if (!off) {
+		herolte_disp_restore();        /* it did not stop: put everything back */
+	}
+}
+
+void
+herolte_disp_restore(void)
+{
+	uint32_t old = __atomic_exchange_n(&herolte_disp_state, 0, __ATOMIC_SEQ_CST);
+	if (old == 0 || !disp_decon) {
+		return;
+	}
+	hg_wr(disp_decon, 0x70, disp_trig_saved);
+	hg_wr(disp_decon, 0x0, (hg_rd(disp_decon, 0x0) & ~3u) | (disp_glob_saved & 3u));
+	hg_disp_update();
+	bool on = hg_disp_run_is(true, 20000);
+	printf("HEROLTE DISP: restore from level %u: global %#x, trig %#x, run %s within 20 ms (line %u)\n", old, hg_rd(disp_decon, 0x0),
+	    hg_rd(disp_decon, 0x70), on ? "ON" : "STILL OFF", hg_rd(disp_decon, 0x8c) & 0xffff);
+}
