+	nanoseconds_to_absolutetime(10ull * NSEC_PER_SEC, &ticks_10s);
 	for (;;) {
 		hg_msleep(20);
 		if (!hc.saved || hc.broken) {
@@ -2965,10 +2968,10 @@
 					downs++;
 				}
