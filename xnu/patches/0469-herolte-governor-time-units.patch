 	bool started = false, boosting = false;
+	uint64_t ticks_60ms = 0, ticks_10s = 0;        /* mach_absolute_time is in ticks, not nanoseconds (min102 compared the two: no summary line, a 2.5 s minimum instead of 60 ms) */
