+
+/*
+ * 0467 (D-0112): herogov=2, the governor of the big cluster. herogov=1 looks at the four cores every 200 ms and has two states (the
+ * bootloader's 728 MHz and one fixed rate); min98-min101 (E-0318, E-0320, E-0321) showed that the rate cap alone trades fluidity for
+ * current: the cores are rarely saturated over 2 s but they are over 100 ms, and the climb from 728 MHz takes 200 ms to notice.
+ *
+ * Here a thread of its own every 20 ms: the busiest big core's load (the UI is one thread) gives the capacity needed to run at 80 %,
+ * and the cluster goes at once to the lowest level that has it (728, 1352, 1664, 1976, 2288 MHz), one step down at a time after 120 ms of
+ * slack, back to the bootloader's 728 MHz after 1 s of nothing, never lower than 1664 MHz within 400 ms of a finger report (the touch
+ * driver stamps herolte_touch_last_mach), capped at 1976 MHz when the SoC is within 8 C of herohot, at 728 MHz when the screen is off or hot.
+ * It owns the cluster while it runs: the power thread's own governor and rate stepping stay out. Every ten seconds it prints how long it
+ * spent at each level, how many changes, how long a change takes and how many 20 ms samples were saturated at the top level (the
+ * capacity measure min101 lacked).
+ */
+volatile uint64_t herolte_touch_last_mach;        /* bsd/dev/herolte_touch.c: the last finger report */
+static volatile bool g2_screen_off, g2_hot;
+static volatile int g2_top = -1000;
+static volatile uint32_t g2_hot_c = 60;
+static const uint32_t g2_lv[] = { 728, 1352, 1664, 1976, 2288 };
+#define G2_N (sizeof(g2_lv) / sizeof(g2_lv[0]))
+
+static bool
+g2_go(unsigned lv)
+{
+	if (lv == 0) {
+		return !hc.high || hc_go_low();
+	}
+	uint32_t mhz = g2_lv[lv];
+	if (hc.high) {
+		return hc_rate(mhz);
+	}
+	for (unsigned i = 0; i < HC_NRATES; i++) {
+		if (hc_rate_rows[i].mhz == mhz) {
+			hc.mhz = mhz;
+			hc.m = hc_rate_rows[i].m;
+			hc.volt = hc_rate_rows[i].volt;
+			hc.promise = hc_rate_rows[i].promise;
+			bool ok = hc_go_high();
+			if (ok) {
+				herolte_pm_mhz = mhz;
+			}
+			return ok;
+		}
+	}
+	return false;
+}
+
+static void
+g2_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	extern uint64_t herolte_cluster_busy_mach(int first, int last);
+	uint64_t prev[4] = { 0 }, prev_t = 0, last_log = 0, hold_until = 0;
+	uint64_t res_ns[G2_N] = { 0 }, trans = 0, ups = 0, downs = 0, boosts = 0, sat = 0, samples = 0, tr_ns_sum = 0, tr_ns_max = 0;
+	unsigned lv = 0, down_n = 0, idle_n = 0;
+	bool started = false, boosting = false;
+	for (;;) {
+		hg_msleep(20);
+		if (!hc.saved || hc.broken) {
+			continue;
+		}
+		uint64_t now = mach_absolute_time();
+		if (!started) {
+			started = true;
+			lv = 0;
+			if (hc.high) {
+				lv = (unsigned)G2_N - 1;
+				for (unsigned i = 1; i < G2_N; i++) {
+					if (g2_lv[i] >= hc.mhz) {
+						lv = i;
+						break;
+					}
+				}
+			}
+			printf("HEROLTE GOV2: started at level %u (%u MHz): levels 728 1352 1664 1976 2288, 20 ms, 80 %% target, 120 ms down, 1 s idle, touch floor 1664, thermal cap near %u C\n",
+			    lv, lv ? g2_lv[lv] : 728u, g2_hot_c);
+		}
+		uint64_t dt = prev_t ? now - prev_t : 0, dt_ns = 0;
+		unsigned umax = 0, usum = 0;
+		for (int c = 0; c < 4; c++) {
+			uint64_t cur = herolte_cluster_busy_mach(4 + c, 4 + c);
+			unsigned pm = dt ? (unsigned)((cur - prev[c]) * 1000 / dt) : 0;
+			pm = pm > 1000 ? 1000 : pm;
+			prev[c] = cur;
+			usum += pm;
+			umax = pm > umax ? pm : umax;
+		}
+		prev_t = now;
+		if (!dt) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(dt, &dt_ns);
+		res_ns[lv] += dt_ns;
+		samples++;
+		if (lv == G2_N - 1 && umax >= 900) {
+			sat++;
+		}
+		/* what the busiest core needs, in MHz, to run at 80 % */
+		uint32_t f_cur = g2_lv[lv];
+		uint32_t need = (uint32_t)((uint64_t)umax * f_cur / 800);
+		unsigned want_rate = 1;
+		while (want_rate < G2_N - 1 && g2_lv[want_rate] < need) {
+			want_rate++;
+		}
+		bool touch = herolte_touch_last_mach != 0 && now > herolte_touch_last_mach;
+		if (touch) {
+			uint64_t since = 0;
+			absolutetime_to_nanoseconds(now - herolte_touch_last_mach, &since);
+			touch = since < 400ull * NSEC_PER_SEC / 1000;
+		}
+		unsigned want = lv;
+		if (g2_screen_off || g2_hot) {
+			want = 0;
+			idle_n = 0;
+			down_n = 0;
+		} else {
+			if (usum / 4 < 60) {
+				idle_n++;
+			} else {
+				idle_n = 0;
+			}
+			if (lv == 0) {
+				if (umax > 250 || touch) {
+					want = want_rate;          /* leaving the bootloader's rate: straight to what is needed */
+				}
+			} else if (want_rate > lv) {
+				want = want_rate;                  /* up at once, to the level that has the capacity */
+				down_n = 0;
+			} else if (want_rate < lv) {
+				if (++down_n >= 6 && now > hold_until) {
+					want = lv - 1;                /* down one step after 120 ms of slack */
+					down_n = 0;
+				}
+			} else {
+				down_n = 0;
+			}
+			if (lv != 0 && idle_n >= 50 && !touch) {
+				want = 0;                              /* a second of nothing: the bootloader's rate */
+			}
+			if (touch && want < 2 && want != 0 && !g2_screen_off) {
+				want = 2;                              /* a finger is on the screen: not below 1664 MHz */
+			}
+			if (touch && want == 0 && lv == 0) {
+				want = 2;
+			}
+			if ((int)g2_top >= (int)g2_hot_c - 8 && want > 3) {
+				want = 3;                              /* near the heat limit: 1976 MHz at most */
+			}
+		}
+		if (touch && !boosting) {
+			boosting = true;
+			boosts++;
+		} else if (!touch) {
+			boosting = false;
+		}
+		if (want != lv) {
+			uint64_t t0 = mach_absolute_time(), t1;
+			bool ok = g2_go(want);
+			t1 = mach_absolute_time();
+			uint64_t tr_ns = 0;
+			absolutetime_to_nanoseconds(t1 - t0, &tr_ns);
+			tr_ns_sum += tr_ns;
+			tr_ns_max = tr_ns > tr_ns_max ? tr_ns : tr_ns_max;
+			if (++trans <= 120 || !ok) {
+				printf("HEROLTE GOV2: %u -> %u MHz %s in %llu us (busiest core %u per mille, mean %u, needs %u MHz%s%s%s)\n", g2_lv[lv], g2_lv[want], ok ? "done" : "FAILED",
+				    tr_ns / 1000, umax, usum / 4, need, touch ? ", touch" : "", g2_screen_off ? ", screen off" : "", g2_hot ? ", hot" : "");
+			}
+			if (ok) {
+				if (want > lv) {
+					ups++;
+				} else {
+					downs++;
+				}
+				lv = want;
+				hold_until = t1 + 60ull * NSEC_PER_SEC / 1000;
+			}
+		}
+		if (!last_log || now - last_log > 10ull * 1000 * NSEC_PER_SEC / 1000) {
+			if (last_log) {
+				uint64_t tot = 0;
+				for (unsigned i = 0; i < G2_N; i++) {
+					tot += res_ns[i];
+				}
+				printf("HEROLTE GOV2: residency");
+				for (unsigned i = 0; i < G2_N; i++) {
+					printf(" %u MHz %llu per mille", g2_lv[i], tot ? res_ns[i] * 1000 / tot : 0);
+				}
+				printf("; %llu changes (%llu up, %llu down), a change takes %llu us on average and %llu us at most; touch boosts %llu; saturated samples at the top level %llu of %llu\n",
+				    trans, ups, downs, trans ? tr_ns_sum / trans / 1000 : 0, tr_ns_max / 1000, boosts, sat, samples);
+			}
+			last_log = now;
+		}
+	}
+}
