--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2623,6 +2623,42 @@
 	return p ? 26 * m / (p << s) : 0;
 }
 
+/*
+ * 0445: the broadcast tick for deep idle. A powered-down core does not wake on its own timer (see herolte_idle_suspend), so a
+ * thread bound to cpu 0, which never sleeps deeply, looks every millisecond at the cores that sleep and sends the wake-up SGI
+ * when the next timer pop they published is due (1 ms ahead). A core woken by anything else drops its entry (since = 0).
+ */
+static void
+hg_idle_tick(__unused void *arg, __unused wait_result_t wr)
+{
+	extern volatile uint32_t herolte_idle_mask;
+	extern volatile uint64_t herolte_idle_since[], herolte_idle_pop[];
+	extern void a5xelte_send_ipi(unsigned int logical);
+	extern struct processor *cpu_to_processor(int cpu);
+	extern struct processor *thread_bind(struct processor *processor);
+	uint64_t sent[8] = { 0 };
+	thread_bind(cpu_to_processor(0));
+	hg_msleep(1);
+	for (;;) {
+		hg_msleep(1);
+		if (!herolte_idle_mask) {
+			hg_msleep(100);
+			continue;
+		}
+		uint64_t now = mach_absolute_time();
+		for (unsigned c = 1; c < 8; c++) {
+			uint64_t since = herolte_idle_since[c], pop = herolte_idle_pop[c];
+			if (!(herolte_idle_mask & (1u << c)) || since == 0 || sent[c] == since) {
+				continue;
+			}
+			if (pop != 0 && pop <= now + 26000ull) {
+				sent[c] = since;
+				a5xelte_send_ipi(c);
+			}
+		}
+	}
+}
+
 static void
 hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 {
