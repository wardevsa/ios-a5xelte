 	hg_wr(cfg, 0x80, 0x18000000u);                          /* BAR0's window: ChipCommon */
 	printf("HEROLTE WIFI: bar0 %#x bar2 %#x command %#x window %#x\n", hg_rd(cfg, 0x10), hg_rd(cfg, 0x18), hg_rd(cfg, 0x04), hg_rd(cfg, 0x80));
