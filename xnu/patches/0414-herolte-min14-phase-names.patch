+/*
+ * min14: name every kernel_bootstrap phase on screen. kernel_debug_string_early() (bsd/kern/kdebug.c) calls
+ * sweet_early_phase(); once sweet_early_phase_begin() has run (end of arm_init), each call draws a coloured block at slot
+ * 41+n of the x=1300 column and the phase name, 16x32 px per character, to its left. herostop=N still freezes after block N.
+ */
+static unsigned int a5_phase_n, a5_phase_on;
+
+void
+sweet_early_phase_begin(void)
+{
+	a5_phase_n = 0;
+	a5_phase_on = 1;
+}
+
+static void
+a5_label(unsigned int slot, const char *s)
+{
+	static const unsigned int scale = 2;
+	unsigned int len = 0;
+	while (s[len] && len < 48) {
+		len++;
+	}
+	unsigned int x0 = 1290 - len * 8 * scale;
+	unsigned int y0 = 88 + 32 * slot - 6;
+	for (unsigned int c = 0; c < len; c++) {
+		const unsigned char *glyph = iso_font + (unsigned char)s[c] * 16;
+		for (unsigned int gy = 0; gy < 16; gy++) {
+			for (unsigned int sy = 0; sy < scale; sy++) {
+				volatile uint32_t *line = A5_FB + (y0 + gy * scale + sy) * A5_STRIDE + x0 + c * 8 * scale;
+				for (unsigned int gx = 0; gx < 8; gx++) {
+					uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+					for (unsigned int sx = 0; sx < scale; sx++) {
+						line[gx * scale + sx] = pixel;
+					}
+				}
+			}
+		}
+	}
+}
+
+void
+sweet_early_phase(const char *message)
+{
+	static const uint32_t colours[8] = { 0xffff4500, 0xff00ff7f, 0xff1e90ff, 0xffffd700, 0xffff1493, 0xff9932cc, 0xff20b2aa, 0xffffffff };
+	if (!a5_active || !a5_phase_on || !message) {
+		return;
+	}
+	unsigned int slot = 41 + a5_phase_n++;
+	if (slot > 76) {
+		return;
+	}
+	a5_label(slot, message);
+	sweet_early_block(slot, colours[slot & 7]);
+}
+
 /* Boot-arg herostop=N (read in arm_init after PE_init_platform): freeze the machine right after block N is drawn, so the
  * screen keeps showing how far it got. -1 = never stop (default). Interrupts are masked at this point of boot. */
 static volatile int a5_stop_slot = -1;
