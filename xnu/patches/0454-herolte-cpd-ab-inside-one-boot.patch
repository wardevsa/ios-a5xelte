herolte: CPD alternates every 30 s with the screen off, heroidle bit 18, an A/B inside one boot (0454)

min83 (CPD always): 460 +-5 mA with the screen off; min80 505 +-4 and min82 502 +-9 without CPD; min84 (CPD only with the screen off): 491 +-16 (n=18). Runs differ in more than CPD (time since boot when the screen went off, background work, battery), so the comparison needs both states in the same boot. Bit 18 makes the flag alternate every 30 s while the screen is off, starting on, and logs each change as HEROLTE CPD: on|off; the PWR lines in between are then one state each. heroidle only (D-0089).

--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2744,7 +2744,7 @@
 	 * the whole thing off and says so.
 	 */
 	uint32_t idle_mask_want = 0;
-	uint32_t cpd_allowed = 0, cpd_screen_only = 0;      /* 0453 */
+	uint32_t cpd_allowed = 0, cpd_screen_only = 0, cpd_ab = 0;      /* 0453, 0454 */
 	bool idle_armed = false;
 	uint64_t idle_t0 = 0, idle_ipis = 0;
 	PE_parse_boot_argn("heroidle", &idle_mask_want, sizeof(idle_mask_want));
@@ -2766,6 +2766,7 @@
 		 */
 		cpd_allowed = (idle_mask_want >> 16) & 1u;
 		cpd_screen_only = (idle_mask_want >> 17) & 1u;
+		cpd_ab = (idle_mask_want >> 18) & 1u;      /* 0454 */
 		herolte_cpd_enable = cpd_allowed && !cpd_screen_only;
 		idle_mask_want &= 0xffu;
 	}
@@ -2784,7 +2785,23 @@
 		bool screen_off = off != 0 && ns > 3ull * NSEC_PER_SEC;
 		if (cpd_allowed && cpd_screen_only) {
 			extern volatile uint32_t herolte_cpd_enable;
-			herolte_cpd_enable = screen_off;       /* 0453 */
+			uint32_t want = screen_off;            /* 0453 */
+			/*
+			 * 0454: heroidle bit 18, an A/B inside ONE boot. min83 (CPD always) measured 460 mA with the screen off against 502-505
+			 * without, but min84 (CPD only with the screen off) measured 491 +-16, and the runs differ in more than CPD: how long
+			 * after boot the screen went off, battery, background work. With the screen off the flag now alternates every 30 s
+			 * (on first); every change is logged ("HEROLTE CPD: on|off"), so the PWR lines between two of them belong to one state
+			 * and the two states are compared in the same minutes of the same boot.
+			 */
+			if (screen_off && cpd_ab) {
+				want = ((ns / NSEC_PER_SEC) / 30) % 2 == 0;
+			}
+			if (want != herolte_cpd_enable) {
+				herolte_cpd_enable = want;
+				if (cpd_ab) {
+					printf("HEROLTE CPD: %s\n", want ? "on" : "off");
+				}
+			}
 		}
 		int c[4] = { -1000, -1000, -1000, -1000 };
 		top = -1000;
