--- a/osfmk/kern/processor.c
+++ b/osfmk/kern/processor.c
@@ -1728,3 +1728,24 @@
 }
 
 #endif /* defined(__arm64__) */
+
+/*
+ * 0434: the time the cores first..last have spent running (user + system, Mach time, idle excluded), for bsd/dev/herolte_gpu.c's
+ * governor of the Mongoose cluster (cores 4-7).
+ */
+uint64_t herolte_cluster_busy_mach(int first, int last);
+uint64_t
+herolte_cluster_busy_mach(int first, int last)
+{
+	uint64_t busy = 0;
+	for (int c = first; c <= last; c++) {
+		processor_t p = cpu_to_processor(c);
+		if (p != PROCESSOR_NULL) {
+			struct recount_usage usage = { 0 };
+			uint64_t idle = 0;
+			recount_processor_usage(&p->pr_recount, &usage, &idle);
+			busy += usage.ru_user_time_mach + usage.ru_system_time_mach;
+		}
+	}
+	return busy;
+}
