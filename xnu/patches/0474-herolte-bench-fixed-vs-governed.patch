+/* 0474: fixed mode for the bench: the governor holds the cap instead of following the load, to compare the governor with a fixed rate in one boot */
+static volatile bool g2_fixed;
 static volatile unsigned g2_cap = (unsigned)(sizeof(g2_lv) / sizeof(g2_lv[0])) - 1;   /* highest level the governor may use (0468: the scenario bench changes it) */
