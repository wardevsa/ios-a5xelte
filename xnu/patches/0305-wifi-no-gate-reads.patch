@@ -2823,9 +2823,11 @@ hg_wifi_thread(__unused void *arg, __unused wait_result_t wr)
 	hg_wr(pins, 0x60, (hg_rd(pins, 0x60) & ~0xf00fu & ~0xf00u) | 2u | (1u << 8) | (1u << 12));
