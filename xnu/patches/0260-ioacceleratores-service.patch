 OSDefineMetaClassAndStructors(HeroGPU, IOService);
 
+/*
+ * QuartzCore polls for this class every 100 ms, up to 30 s, the first time a
+ * CoreGraphics IOSurface context flushes, and SpringBoard's main thread can end
+ * up behind that wait. It only checks that the service exists, so an empty one
+ * ends the wait. No user client: anything that tries to open it just fails.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
 class HeroGPUUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(HeroGPUUserClient);
 
