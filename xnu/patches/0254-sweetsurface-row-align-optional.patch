diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 05e6546..c162df9 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -39,6 +39,7 @@
 #include <libkern/c++/OSNumber.h>
 #include <libkern/c++/OSUnserialize.h>
 #include <sys/proc.h>
+#include <pexpert/pexpert.h>
 
 enum {
 	kSweetSurfaceCreate             = 0,
@@ -308,7 +309,16 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 	 * cannot import (linear rows must be 64-byte aligned), so those surfaces
 	 * went through CPU copies and the icons stayed blank.
 	 */
-	if (props->getObject("IOSurfacePlaneInfo") == NULL) {
+	/*
+	 * Only with boot-arg sweetrowalign=1: a client that writes with the pitch it
+	 * asked for (the keyboard) came out skewed, and the HakiOS EAGL bridge copies
+	 * such surfaces into textures anyway.
+	 */
+	static int row_align = -1;
+	if (row_align < 0 && !PE_parse_boot_argn("sweetrowalign", &row_align, sizeof(row_align))) {
+		row_align = 0;
+	}
+	if (row_align && props->getObject("IOSurfacePlaneInfo") == NULL) {
 		s->bytesPerRow = (s->bytesPerRow + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint32_t)(SWEET_SURFACE_ROW_ALIGN - 1);
 	}
 #endif
