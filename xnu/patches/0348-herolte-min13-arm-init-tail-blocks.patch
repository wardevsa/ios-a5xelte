+/* min13: busy-wait (generic timer, no allocation) so that something asynchronous that clears the framebuffer after serial_init
+ * has finished before the later progress blocks are drawn. */
+void
+sweet_early_pause_ms(unsigned int ms)
+{
+	uint64_t freq, t0, now;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(freq));
+	if (freq == 0) {
+		freq = 24000000ULL;
+	}
+	__asm__ volatile ("isb; mrs %0, cntpct_el0" : "=r"(t0));
+	do {
+		__asm__ volatile ("isb; mrs %0, cntpct_el0" : "=r"(now));
+	} while ((now - t0) * 1000ULL < freq * ms);
+}
+
 /* Boot-arg herostop=N (read in arm_init after PE_init_platform): freeze the machine right after block N is drawn, so the
  * screen keeps showing how far it got. -1 = never stop (default). Interrupts are masked at this point of boot. */
 static volatile int a5_stop_slot = -1;
