 volatile uint64_t herolte_idle_arm[MAX_CPUS];        /* 0440: arm_init_idle_cpu reached (MMU on) */
+volatile uint64_t herolte_idle_pmu_cfg[MAX_CPUS];   /* 0441: VA of each core's PMU CONFIGURATION register (PMU+0x2000+0x80*(Aff1<<2|Aff0)); 0 = not mapped: no deep idle */
 
 static bool
 herolte_idle_suspend(cpu_data_t *cdp)
 {
 	unsigned c = (unsigned)cdp->cpu_number;
-	if (c == 0 || c >= MAX_CPUS || !(herolte_idle_mask & (1u << c)) || herolte_idle_entry_pa == 0) {
+	if (c == 0 || c >= MAX_CPUS || !(herolte_idle_mask & (1u << c)) || herolte_idle_entry_pa == 0 || herolte_idle_pmu_cfg[c] == 0) {
 		return false;
 	}
+	volatile uint32_t *pcfg = (volatile uint32_t *)herolte_idle_pmu_cfg[c];
 	herolte_idle_enter[c]++;
 	herolte_idle_since[c] = mach_absolute_time();
 	CleanPoC_Dcache();
@@ -509,6 +511,14 @@
 	 * of a powered-down core; the architected virtual timer (PPI 27, the one XNU uses) is what Linux's idle wakes on. Armed for
 	 * 2 ms ahead (52 000 ticks at 26 MHz) before the call; the timer is re-synchronized if the call returns.
 	 */
+	/*
+	 * 0441: what Samsung's Linux does before the SMC and min68-min70 did not (exynos-powermode.c enter_c2 ->
+	 * exynos_cpu.power_down -> exynos-pmu.c exynos_cpu_down): the core's PMU CONFIGURATION register, local power bits 0xf, goes
+	 * to 0, so that the WFI the monitor executes powers the core down and an interrupt can bring it back. On a return from the
+	 * call (error or no power-down) it goes back to 0xf, as Linux's wakeup_from_c2(early_wakeup) does.
+	 */
+	*pcfg = *pcfg & ~0xfu;
+	__builtin_arm_dsb(DSB_SY);
 	__builtin_arm_wsr64("CNTV_CVAL_EL0", __builtin_arm_rsr64("CNTVCT_EL0") + 52000ULL);
 	__builtin_arm_wsr64("CNTV_CTL_EL0", 1ULL);
 	__builtin_arm_isb(ISB_SY);
@@ -520,6 +530,8 @@
 	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
 	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
 	/* Only reached when the call returns: an error, or the core did not power down. */
+	*pcfg = *pcfg | 0xfu;
+	__builtin_arm_dsb(DSB_SY);
 	herolte_idle_since[c] = 0;
 	timer_resync_deadlines();
 	return true;
