diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 3883ca2..e32abb5 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -383,11 +383,14 @@ hg_job_fragment(uint64_t pixels_va, uint32_t size, uint32_t stride, uint32_t col
 	fb[11] = (2u << 6) |            /* tie-break MINUS_180_IN_0_OUT, as the A5 */
 	    (8u << 9) |                 /* effective tile size log2(16 * 16) */
 	    (1u << 24);                 /* color buffer allocation 1 KiB (shr 10) */
-	fb[12] = 0;
+	fb[12] = 1u << 16;              /* Z internal format D24 (Mesa, no ZS) */
 	fb[13] = 0;                     /* Z clear 0.0 */
-	/* Tiler Context at +56 (word 14): empty list, no hierarchy (A5 values). */
-	fb[14] = 516;                   /* polygon list size: 512-byte header + 4 */
-	fb[15] = 4095;
+	/* Tiler Context at +56 (word 14). Mesa pan_emit_midgard_tiler(), tiler
