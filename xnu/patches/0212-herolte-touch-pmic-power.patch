 	ht_wr(ht_pins, 0, (ht_rd(ht_pins, 0) & ~0xffu) | 0x22u);
@@ -321,7 +490,8 @@ herolte_touch_probe(void)
 	ht_alive = ml_io_map(HT_ALIVE_PA, 0x1000);
 	ht_pins = ml_io_map(HT_PINS_PA, 0x1000);
