+/*
+ * Two panel buffers (boot-arg herofb2, default 1; idea from Scion's fb_zc on the Galaxy S9). S-Boot leaves DECON_F's
+ * window 0 on IDMA channel G1 (0x13952000), reading 0xe2a00000 (boot-0320). With that one buffer every GPU-drawn frame
+ * was written while the panel read it: the tears, and showFired waited for the 1.9 ms between readings. Now the Mali
+ * draws into the buffer that is not shown and G1 is pointed at it (VG_BASE_ADDR_Y(0) at 0x74, VG_PINGPONG_UPDATE at 0x1c,
+ * as Samsung's vpp_reg_set_in_buf_addr); the IDMA takes the new address when its next frame begins, and the shadow at
+ * 0xb74 says which one it reads. The second buffer is 16 MiB of the first DRAM bank outside XNU's RAM, below 4 GiB for
+ * the IDMA's 32-bit address. A read error of the IDMA (VG_IRQ bit 19) or a flip that is never taken: back to the one
+ * buffer for good.
+ */
+#define HG_FB2_PA       0x91000000ull
+#define HG_PANEL2_VA    0x06000000ull
+#define HGP_FB2_L3_OFF  0x120000u       /* 8 L3 tables in the scratch block, after the user L2 */
+#define HG_IDMA_G1_PA   0x13952000u
+#define HG_DECON_F_PA   0x13960000u
+static vm_offset_t hfb_idma;
+static int hfb_state;                   /* 0 not tried, 1 two buffers, -1 one */
+static uint64_t hfb_flips;
+
+static void
+hfb_give_up(const char *why)
+{
+	hfb_state = -1;
+	if (hfb_idma && hg_rd(hfb_idma, 0xb74) != (uint32_t)HG_FB_PA) {
+		hg_wr(hfb_idma, 0x74, (uint32_t)HG_FB_PA);
+		hg_wr(hfb_idma, 0x1c, 1);
+	}
+	printf("HEROLTE FB2: one buffer from now on: %s (after %llu flips)\n", why, hfb_flips);
+}
+
+/* The flip asked for last has been taken (bounded: two refreshes), and the IDMA read it without error. */
+static bool
+hfb_settled(void)
+{
+	unsigned us = 0;
+	while ((hg_rd(hfb_idma, 0x1c) & 1) && us < 40000) {
+		delay(20);
+		us += 20;
+	}
+	uint32_t irq = hg_rd(hfb_idma, 0x04);
+	if (irq & (1u << 19)) {
+		hg_wr(hfb_idma, 0x04, 1u << 19);
+		hfb_give_up("IDMA read error");
+		return false;
+	}
+	if (hg_rd(hfb_idma, 0x1c) & 1) {
+		hfb_give_up("flip not taken in 40 ms");
+		return false;
+	}
+	return true;
+}
+
+static void
+hfb_setup_locked(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("herofb2", &on, sizeof(on));
+	hfb_state = -1;
+	if (!on) {
+		return;
+	}
+	vm_offset_t decon = ml_io_map(HG_DECON_F_PA, 0x1000);
+	uint32_t wc = decon ? hg_rd(decon, 0x130) : 0;
+	if (!(wc & 1) || ((wc >> 12) & 7) != 0) {
+		printf("HEROLTE FB2: window 0 control %#x is not on channel G1; one buffer\n", wc);
+		return;
+	}
+	hfb_idma = ml_io_map(HG_IDMA_G1_PA, 0x1000);
+	if (!hfb_idma || hg_rd(hfb_idma, 0xb74) != (uint32_t)HG_FB_PA || hg_rd(hfb_idma, 0x10) != ((HG_PANEL_H << 16) | HG_PANEL_W)) {
+		printf("HEROLTE FB2: G1 reads %#x, size %#x: not the panel as S-Boot left it; one buffer\n",
+		    hfb_idma ? hg_rd(hfb_idma, 0xb74) : 0, hfb_idma ? hg_rd(hfb_idma, 0x10) : 0);
+		return;
+	}
+	volatile uint64_t *l2t = (volatile uint64_t *)(hg_mem + 0x2000);
+	unsigned pages = (HG_PANEL_BYTES + 0xfff) / 0x1000;
+	hg_zero(hgp_scr + HGP_FB2_L3_OFF, 8 * 0x1000);
+	for (unsigned t = 0; t * 512 < pages; t++) {
+		uint32_t table = HGP_FB2_L3_OFF + t * 0x1000;
+		volatile uint64_t *l3 = (volatile uint64_t *)(hgp_scr + table);
+		for (unsigned i = 0; i < 512 && t * 512 + i < pages; i++) {
+			l3[i] = (HG_FB2_PA + (uint64_t)(t * 512 + i) * 0x1000) | 0x2c1;
+		}
+		l2t[((HG_PANEL2_VA >> 21) & 0x1ff) + t] = (HG_SCR_PA + table) | 3;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (!hgp_mmu_flush(HG_PANEL2_VA, 24)) {
+		printf("HEROLTE FB2: MMU flush timeout; one buffer\n");
+		return;
+	}
+	hg_wr(hfb_idma, 0x04, 1u << 19);        /* a stale read error is not ours */
+	hfb_state = 1;
+	printf("HEROLTE FB2: two buffers, %#llx and %#llx (GPU VA %#llx), on IDMA G1\n", HG_FB_PA, HG_FB2_PA, HG_PANEL2_VA);
+}
+
+/* For the CPU's writes into the first buffer (SweetFramebuffer.cpp): that one shown again first. */
+void
+herolte_fb_primary(void)
+{
+	lck_mtx_lock(hg_mtx);
+	if (hfb_state == 1 && hfb_settled() && hg_rd(hfb_idma, 0xb74) != (uint32_t)HG_FB_PA) {
+		hg_wr(hfb_idma, 0x74, (uint32_t)HG_FB_PA);
+		hg_wr(hfb_idma, 0x1c, 1);
+		(void)hfb_settled();
+	}
+	lck_mtx_unlock(hg_mtx);
+}
+
+bool
+herolte_fb_two_buffers(void)
+{
+	return hfb_state == 1;
+}
