+/*
+ * 0433: from one of the cluster's rates to another while it runs (the same table as hg_cpu_up: 1976, 2288, 2600 MHz): a
+ * lower rate is relocked first and its voltage written after, a higher rate gets its voltage first (hc_go_high). Anything
+ * unexpected puts the previous rate's numbers back. Only the power thread calls it (herocycle=<seconds>, below).
+ */
+static bool
+hc_rate(uint32_t mhz)
+{
+	extern bool herolte_apm_mngs_voltage(uint8_t value);
+	static const struct {
+		uint32_t mhz, m;
+		uint8_t volt, promise;
+	} rates[] = {
+		{ 1976, 228, 0x62, 5 },
+		{ 2288, 264, 0x6f, 6 },
+		{ 2600, 300, 0x7c, 7 },
+	};
+	if (!hc.saved || hc.broken || !hc.high) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+		if (rates[i].mhz != mhz) {
+			continue;
+		}
+		if (hc.mhz == mhz) {
+			return true;
+		}
+		uint32_t old_mhz = hc.mhz, old_m = hc.m;
+		uint8_t old_volt = hc.volt, old_promise = hc.promise;
+		hc.mhz = mhz;
+		hc.m = rates[i].m;
+		hc.volt = rates[i].volt;
+		hc.promise = rates[i].promise;
+		if (!hc_go_high()) {
+			hc.mhz = old_mhz;
+			hc.m = old_m;
+			hc.volt = old_volt;
+			hc.promise = old_promise;
+			return false;
+		}
+		herolte_pm_mhz = mhz;
+		if (hc.volt < old_volt) {
+			uint8_t set = 0;
+			bool wrote = herolte_apm_mngs_voltage(hc.volt);
+			delay(200);
+			if (!wrote || !herolte_apm_pmic_read(0x1d, &set) || set != hc.volt) {
+				printf("HEROLTE CPU: vdd_mngs down to %#x failed (now %#x), the old voltage stays\n", hc.volt, set);
+			}
+		}
+		return true;
+	}
+	return false;
+}
