+/*
+ * Timed from the tick that was due, not from the end of the work: counted from the end, the 2.6 ms of a frame's copy
+ * came on top of the period, ticks were 18-19.5 ms apart (51-55 Hz, unevenly), and CoreAnimation's 60 Hz frames beat
+ * against them. A tick too late is passed over, so that the ones after it are on time.
+ */
+AppleCLCD::rearmVsync(IOTimerEventSource *sender)
+{
+	uint64_t period, now = mach_absolute_time();
+	nanoseconds_to_absolutetime(SWEET_FB_VSYNC_US * 1000ULL, &period);
+	if (fVsyncNext == 0) {
+		fVsyncNext = now;
+	}
+	fVsyncNext += period;
+	if (fVsyncNext <= now) {
+		uint64_t missed = (now - fVsyncNext) / period + 1;
+		fVsyncNext += missed * period;
+		fVsyncMissed += missed;
+	}
+	AbsoluteTime due;
+	AbsoluteTime_to_scalar(&due) = fVsyncNext;
+	sender->wakeAtTime(due);
+}
