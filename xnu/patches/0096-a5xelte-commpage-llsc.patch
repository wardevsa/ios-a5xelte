diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..f015ef1 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,8 +273,17 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	ldaxr	w10, [x3]		 // ARMv8.0 acquire load
+	cbnz	w10, Ltrylock_enqueue_clear
+	stxr	w12, w11, [x3]	 // One non-blocking store attempt
+	cbz	w12, Ltrylock_enqueue_success
+Ltrylock_enqueue_clear:
+	clrex
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_enqueue_success
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_enqueue_exit
@@ -323,8 +332,17 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	ldaxr	w10, [x2]		 // ARMv8.0 acquire load
+	cbnz	w10, Ltrylock_dequeue_clear
+	stxr	w12, w11, [x2]	 // One non-blocking store attempt
+	cbz	w12, Ltrylock_dequeue_success
+Ltrylock_dequeue_clear:
+	clrex
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_dequeue_success
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_dequeue_exit
