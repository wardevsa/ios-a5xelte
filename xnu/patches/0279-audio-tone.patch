+#include "herolte_audio_table.h"
+
+static void
+ha_write(uint32_t reg, uint16_t value)
+{
+	uint8_t bytes[8] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg, 0, 0,
+		(uint8_t)(value >> 8), (uint8_t)value };
+	uint8_t got;
+	uint32_t dat = hg_rd(ha_pins, HA_GPE2 + 4);
+	hg_wr(ha_pins, HA_GPE2 + 4, dat & ~(1u << 1));
+	delay(2);
+	for (unsigned i = 0; i < 8; i++) {
+		if (!ha_byte(bytes[i], &got)) {
+			break;
+		}
+	}
+	delay(2);
+	hg_wr(ha_pins, HA_GPE2 + 4, dat | (1u << 1));
+}
+
+/* What Linux left while it played, on top of the reset values; the outputs only at the end. */
 static void
-hg_audio_thread(__unused void *arg, __unused wait_result_t wr)
+ha_codec_setup(void)
+{
+	unsigned written = 0;
+	for (unsigned phase = 0; phase < 3; phase++) {
+		for (unsigned i = 0; i < sizeof(ha_codec_table) / sizeof(ha_codec_table[0]); i++) {
+			uint16_t reg = ha_codec_table[i][0], value = ha_codec_table[i][1], now = 0;
+			bool fll = reg >= 0x172 && reg <= 0x1dd, clocks = reg >= 0x100 && reg < 0x172;
+			if ((phase == 0 && !fll) || (phase == 1 && !clocks) || (phase == 2 && (fll || clocks))) {
+				continue;
+			}
+			if (ha_read(reg, &now) && now != value) {
+				ha_write(reg, value);
+				written++;
+			}
+		}
+		if (phase == 0) {
+			ha_write(0x171, 1);
+			ha_write(0x191, 1);
+			ha_write(0x1d1, 1);
+			hg_msleep(20);
+		}
+	}
+	ha_write(0x406, 0x33);
+	ha_write(0x400, 0x33);
+	hg_msleep(50);
+	uint16_t s0 = 0, s1 = 0, s2 = 0, s3 = 0;
+	ha_read(0x101, &s0);
+	ha_read(0x171, &s1);
+	ha_read(0x400, &s2);
+	ha_read(0x1881, &s3);
+	printf("HEROLTE AUDIO: codec: %u registers written; sysclk %#x fll1 %#x outputs %#x status %#x\n", written, s0, s1, s2, s3);
+}
+
+/* MAX98506 at 0x31 on GPD1-0 (SDA) and GPD1-1 (SCL), by hand: a line is let go high, or driven low. */
+#define HA_AMP_PINS_PA  0x136d0040u
+static vm_offset_t ha_i2c;
+
+static void
+ha_line(unsigned pin, bool high)
+{
+	uint32_t con = hg_rd(ha_i2c, 0) & ~(0xfu << (pin * 4));
+	if (high) {
+		hg_wr(ha_i2c, 0, con);
+	} else {
+		hg_wr(ha_i2c, 4, hg_rd(ha_i2c, 4) & ~(1u << pin));
+		hg_wr(ha_i2c, 0, con | (1u << (pin * 4)));
+	}
+	delay(5);
+}
+
+static bool
+ha_i2c_byte(uint8_t value)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		ha_line(0, (value >> bit) & 1);
+		ha_line(1, true);
+		ha_line(1, false);
+	}
+	ha_line(0, true);
+	ha_line(1, true);
+	bool ack = !(hg_rd(ha_i2c, 4) & 1);
+	ha_line(1, false);
+	return ack;
+}
+
+static bool
+ha_amp_write(uint8_t reg, uint8_t value)
+{
+	ha_line(0, true);
+	ha_line(1, true);
+	ha_line(0, false);
+	ha_line(1, false);
+	bool ack = ha_i2c_byte(0x31 << 1) && ha_i2c_byte(reg) && ha_i2c_byte(value);
+	ha_line(0, false);
+	ha_line(1, true);
+	ha_line(0, true);
+	return ack;
+}
+
+/* The I2S block is the codec's slave (CBM_CFM); its FIFO filled by hand for now. A sine at 440 Hz. */
+static void
+ha_tone(void)
+{
+	vm_offset_t pmu = ml_io_map(0x105c0000u, 0x5000);
+	vm_offset_t aud = ml_io_map(0x114c0000u, 0x1000);
+	vm_offset_t lpass = ml_io_map(0x11400000u, 0x1000);
+	vm_offset_t i2s = ml_io_map(0x11440000u, 0x1000);
+	vm_offset_t pins = ml_io_map(0x114b0000u, 0x1000);
+	ha_i2c = ml_io_map(HA_AMP_PINS_PA & ~0xfffu, 0x1000) + (HA_AMP_PINS_PA & 0xfffu);
+	printf("HEROLTE AUDIO: PMU debug %#x, AUD domain %#x/%#x\n", hg_rd(pmu, 0xa00), hg_rd(pmu, 0x40c0), hg_rd(pmu, 0x40c4));
+	hg_wr(pmu, 0xa00, 0x1f00);              /* MCLK1: 26 MHz out to the codec */
+	hg_wr(pmu, 0x40c0, 0xf);
+	for (unsigned i = 0; i < 1000 && (hg_rd(pmu, 0x40c4) & 0xf) != 0xf; i++) {
+		delay(10);
+	}
+	hg_wr(pmu, 0x1340, 1);                  /* the AUD pads out of retention */
+	printf("HEROLTE AUDIO: AUD domain now %#x; cmu mux %#x div %#x %#x gates %#x %#x\n", hg_rd(pmu, 0x40c4), hg_rd(aud, 0x200),
+	    hg_rd(aud, 0x400), hg_rd(aud, 0x404), hg_rd(aud, 0x800), hg_rd(aud, 0x804));
+	hg_wr(aud, 0x800, 1);
+	hg_wr(aud, 0x804, 0x1f3fff);
+	hg_wr(lpass, 0x08, hg_rd(lpass, 0x08) | (3u << 7));
+	printf("HEROLTE AUDIO: lpass version %#x reset %#x; i2s con %#x mod %#x ver %#x\n", hg_rd(lpass, 0), hg_rd(lpass, 0x08), hg_rd(i2s, 0),
+	    hg_rd(i2s, 4), hg_rd(i2s, 0x44));
+	hg_wr(pins, 0, 0x2222222);
+	ha_codec_setup();
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof(ha_amp_table) / sizeof(ha_amp_table[0]); i++) {
+		ok = ha_amp_write(ha_amp_table[i][0], ha_amp_table[i][1]) && ok;
+	}
+	ok = ha_amp_write(0x3a, 0xf8) && ok;
+	printf("HEROLTE AUDIO: amplifier %s\n", ok ? "answered" : "DID NOT ANSWER");
+	hg_wr(i2s, 0x08, 1u << 15);             /* FIC_TXFLUSH */
+	delay(10);
+	hg_wr(i2s, 0x08, 0);
+	hg_wr(i2s, 0x04, 1u << 11);             /* MOD: slave, 16 bits, TX only */
+	hg_wr(i2s, 0x00, 1u);                   /* CON_ACTIVE */
+	printf("HEROLTE AUDIO: i2s con %#x mod %#x fic %#x\n", hg_rd(i2s, 0), hg_rd(i2s, 4), hg_rd(i2s, 8));
+	/* A table of one 440 Hz period at 48 kHz (109 samples, close enough), low level. */
+	static int16_t wave[109];
+	int32_t a = 0, b = 2621;                /* a recurrence for a sine: c = 2 sin(pi f/fs) in 1/32768 */
+	for (unsigned i = 0; i < 109; i++) {
+		wave[i] = (int16_t)a;
+		a += (b * 1887) >> 15;
+		b -= (a * 1887) >> 15;
+	}
+	unsigned sent = 0, stuck = 0, phase = 0;
+	while (sent < 48000u * 8u) {
+		if (hg_rd(i2s, 0) & (1u << 8)) {        /* CON_TXFIFO_FULL */
+			delay(20);
+			if (++stuck > 50000) {
+				break;
+			}
+			continue;
+		}
+		uint16_t sample = (uint16_t)wave[phase];
+		hg_wr(i2s, 0x10, ((uint32_t)sample << 16) | sample);
+		phase = (phase + 1) % 109;
+		sent++;
+	}
+	printf("HEROLTE AUDIO: tone: %u frames sent, %u waits, i2s con %#x, level %#x\n", sent, stuck, hg_rd(i2s, 0), hg_rd(i2s, 8));
+	hg_wr(i2s, 0x00, 0);
+}
+
