@@ -2280,6 +2445,9 @@ hg_audio_thread(__unused void *arg, __unused wait_result_t wr)
 		bool ok = ha_read(regs[i], &value);
 		printf("HEROLTE AUDIO: codec register %#x = %#x (%s), SPI status %#x\n", regs[i], value, ok ? "read" : "TIMEOUT", hg_rd(ha_spi, 0x14));
 	}
+	if ((int)(uintptr_t)arg >= 2) {
+		ha_tone();
+	}
 }
 
