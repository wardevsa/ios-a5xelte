diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 0241a1a..177cb1b 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -28,6 +28,7 @@
 #include <libkern/amfi/amfi.h>
 #include <mach/kern_return.h>
 #include <sys/codesign.h>
+#include <sys/errno.h>
 #include <sys/mount.h>
 #include <sys/priv.h>
 #include <sys/proc.h>
@@ -367,6 +368,50 @@ static struct mac_policy_conf sweet_amfi_mac_conf = {
 
 static mac_policy_handle_t sweet_amfi_mac_handle;
 
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * Policy "AMFI": dyld's amfi_check_dyld_policy_self() is
+ * __mac_syscall("AMFI", 90, &{ u64 input flags, u64 *output flags }).
+ * Without a policy of that name it fails with ENOPOLICY and dyld ignores
+ * every DYLD_* variable. Only HEROLTE GL's backboardd gets an answer
+ * (bsd/dev/herolte_gl.c); every other call keeps failing with ENOPOLICY,
+ * exactly as with no policy at all.
+ */
+extern uint64_t herolte_gl_dyld_flags(void);
+
+static int
+sweet_amfi_dyld_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	struct {
+		uint64_t input_flags;
+		uint64_t output;        /* user pointer to a u64 */
+	} args;
+	uint64_t flags;
+
+	if (call != 90 || (flags = herolte_gl_dyld_flags()) == 0) {
+		return ENOPOLICY;
+	}
+	if (copyin(arg, &args, sizeof(args)) != 0) {
+		return EFAULT;
+	}
+	printf("SWEET AMFI: dyld policy for pid %d: input 0x%llx -> 0x%llx\n",
+	    proc_selfpid(), args.input_flags, flags);
+	return copyout(&flags, (user_addr_t)args.output, sizeof(flags));
+}
+
+static const struct mac_policy_ops sweet_amfi_dyld_mac_ops = {
+	.mpo_policy_syscall = sweet_amfi_dyld_syscall,
+};
+
+static struct mac_policy_conf sweet_amfi_dyld_mac_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "SWEET dyld policy for HEROLTE GL",
+	.mpc_ops = &sweet_amfi_dyld_mac_ops,
+};
+
+static mac_policy_handle_t sweet_amfi_dyld_mac_handle;
+#endif
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void sweet_amfi_policy_register(void);
 
@@ -379,5 +424,9 @@ sweet_amfi_policy_register(void)
 	error = mac_policy_register(&sweet_sandbox_mac_conf, &sweet_sandbox_mac_handle, NULL);
 	printf("SWEET Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	error = mac_policy_register(&sweet_amfi_dyld_mac_conf, &sweet_amfi_dyld_mac_handle, NULL);
+	printf("SWEET AMFI: dyld policy %s (%d)\n", error ? "NOT registered" : "registered", error);
+#endif
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_A5XELTE */
