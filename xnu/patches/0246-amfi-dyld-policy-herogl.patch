diff --git a/bsd/dev/herolte_gl.c b/bsd/dev/herolte_gl.c
index b2ef08b..8466a09 100644
--- a/bsd/dev/herolte_gl.c
+++ b/bsd/dev/herolte_gl.c
@@ -17,20 +17,47 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/vnode.h>
+#include <sys/proc.h>
 #include <string.h>
 #include <pexpert/pexpert.h>
 
-int herolte_gl_env(const char *path, const char **extra, int max);
+int herolte_gl_env(const char *path, int pid, const char **extra, int max);
+uint64_t herolte_gl_dyld_flags(void);
 
 #define HGL_TARGET      "/usr/libexec/backboardd"
 #define HGL_SHIM        "/private/var/herolte/lib/libheroeagl.dylib"
 #define HGL_MAX_LAUNCHES 2
 
+/*
+ * dyld only honours DYLD_* variables when AMFI allows them
+ * (amfi_check_dyld_policy_self: __mac_syscall("AMFI", 90, {in, &out})); with
+ * no "AMFI" policy the call fails and dyld treats the process as
+ * restricted, so 0245's DYLD_INSERT_LIBRARIES was ignored. sweet_amfi.c's
+ * "AMFI" policy answers through herolte_gl_dyld_flags(): the backboardd
+ * this file just gave the shim may use @-paths and path variables, and may
+ * start without an inserted library that fails to load; every other
+ * process gets no answer, as before.
+ */
+#define AMFI_DYLD_OUTPUT_ALLOW_AT_PATH                  (1ull << 0)
+#define AMFI_DYLD_OUTPUT_ALLOW_PATH_VARS                (1ull << 1)
+#define AMFI_DYLD_OUTPUT_ALLOW_FAILED_LIBRARY_INSERTION (1ull << 5)
+
 static int hgl_mode = -1;
 static int hgl_launches;
+static int hgl_pid = -1;        /* the backboardd that got the shim */
+
+uint64_t
+herolte_gl_dyld_flags(void)
+{
+	if (hgl_pid < 0 || proc_selfpid() != hgl_pid) {
+		return 0;
+	}
+	return AMFI_DYLD_OUTPUT_ALLOW_AT_PATH | AMFI_DYLD_OUTPUT_ALLOW_PATH_VARS |
+	       AMFI_DYLD_OUTPUT_ALLOW_FAILED_LIBRARY_INSERTION;
+}
 
 int
-herolte_gl_env(const char *path, const char **extra, int max)
+herolte_gl_env(const char *path, int pid, const char **extra, int max)
 {
 	if (hgl_mode < 0) {
 		hgl_mode = 0;
@@ -57,7 +84,9 @@ herolte_gl_env(const char *path, const char **extra, int max)
 	if (hgl_mode >= 2) {
 		extra[n++] = "EAGL_SHIM_DEBUG=1";
 	}
-	printf("HEROLTE GL: backboardd launch %d: EAGL shim inserted (herogl=%d)\n", launch, hgl_mode);
+	hgl_pid = pid;
+	printf("HEROLTE GL: backboardd launch %d (pid %d): EAGL shim inserted (herogl=%d)\n",
+	    launch, hgl_pid, hgl_mode);
 	return n;
 }
 #endif /* ARM64_BOARD_CONFIG_HEROLTE */
