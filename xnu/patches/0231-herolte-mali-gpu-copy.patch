+static void
+hg_gpu_copy_test(uint64_t hold)
+{
+	static uint64_t pages[HG_SRC_MAX_PAGES];
+	unsigned n = 0;
+	uint32_t soff = 0, sstride = 0, sw = 0, sh = 0;
+	uintptr_t kva = 0;
+	if (!sweet_fb_last_surface(pages, HG_SRC_MAX_PAGES, &n, &soff, &sstride, &sw, &sh, &kva)) {
