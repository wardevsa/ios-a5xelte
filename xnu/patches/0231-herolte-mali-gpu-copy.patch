+	uintptr_t end = kva + soff + (uintptr_t)sstride * sh;
+	for (uintptr_t p = (kva + soff) & ~(uintptr_t)63; p < end; p += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (p) : "memory");
