diff --git a/iokit/Kernel/arm/SweetNetworkStack.cpp b/iokit/Kernel/arm/SweetNetworkStack.cpp
new file mode 100644
index 0000000..0d8b3e5
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNetworkStack.cpp
@@ -0,0 +1,215 @@
+/* From HackiOS's iokit/Kernel/MiniIONetworkStack.cpp (github.com/oosexgang/hackios-xnu-kernel; APSL 2.0), for
+ * apollo's Wi-Fi (xnu 0129); its warnings are not looked at (written for a build without -Werror). */
+#pragma clang diagnostic ignored "-Weverything"
+/*
+ * IONetworkStack: a stand-in for IONetworkStack of Apple's IONetworkingFamily, as seen by
+ * configd's interface namer.
+ *
+ * The real one gives the BSD names (en0, en1, ...) to the IONetworkInterface objects of the
+ * drivers, when the interface namer asks. Here interfaces are made with the BSD interface KPI
+ * (bsd/dev/sweet_net.c) and are born with their names, so there is never anything to name.
+ * But the namer wants this object all the same: until it has opened it, it does not say in
+ * configd's store that the registry has gone quiet (the key Plugin:InterfaceNamer, "*QUIET*"),
+ * and gives up only after five minutes ("*TIMEOUT*"). SystemConfiguration's
+ * SCNetworkInterfaceCopyAll() waits for one of the two, and with it whoever asks for the list of
+ * interfaces: wifid as soon as it has a device, and behind wifid Settings (boot 54: Settings hung
+ * on its Wi-Fi and About pages; the cause as iOSPlus10 traced it, patches/xnu/README-wifi.md).
+ *
+ * So: the service, a user client that can be opened, and a refusal of the naming request.
+ * Started by sweet_wifi_init() for sweetwifi=11 and 12, before launchd.
+ */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_HEROLTE)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IORegistryEntry.h>
+#include <libkern/c++/OSKext.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+extern "C" void SweetNetworkStackStart(void);
+extern "C" void SweetIOKitDaemonStandIn(void);
+
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+bool
+IONetworkStack::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	setName("IONetworkStack");
+	registerService();
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+/*
+ * Boot 55: configd opened this with the registry busy (1), and still waited its 300 s: the
+ * namer publishes "*QUIET*" only when the whole registry is idle, so something stays busy. Which
+ * services are busy (the busiest leaves: busy, with no busy child) is said 20, 60 and 120 s after
+ * configd opened the stack.
+ */
+static void
+sayBusy(unsigned seconds)
+{
+	IOService * root = IOService::getServiceRoot();
+	unsigned shown = 0;
+
+	IOLog("SweetNetworkStack: %u s after configd: the registry's busy state is %u\n", seconds,
+	    (unsigned) root->getBusyState());
+	if (root->getBusyState() == 0) {
+		return;
+	}
+	IORegistryIterator * all = IORegistryIterator::iterateOver(root, gIOServicePlane, kIORegistryIterateRecursively);
+	if (all == NULL) {
+		return;
+	}
+	IORegistryEntry * entry;
+	while ((entry = all->getNextObject()) != NULL && shown < 12) {
+		IOService * service = OSDynamicCast(IOService, entry);
+		if (service == NULL || service->getBusyState() == 0) {
+			continue;
+		}
+		bool busyChild = false;
+		OSIterator * children = service->getChildIterator(gIOServicePlane);
+		if (children != NULL) {
+			OSObject * child;
+			while (!busyChild && (child = children->getNextObject()) != NULL) {
+				IOService * other = OSDynamicCast(IOService, child);
+				busyChild = other != NULL && other->getBusyState() != 0;
+			}
+			children->release();
+		}
+		if (!busyChild) {
+			IOLog("SweetNetworkStack: %u s after configd: BUSY: %s (class %s, busy %u)\n", seconds, service->getName(),
+			    service->getMetaClass()->getClassName(), (unsigned) service->getBusyState());
+			shown++;
+		}
+	}
+	all->release();
+}
+
+static void
+watchBusy(void * argument)
+{
+	static const unsigned at[] = { 20, 60, 120 };
+	unsigned waited = 0;
+
+	for (unsigned i = 0; i < sizeof(at) / sizeof(at[0]); i++) {
+		IOSleep((at[i] - waited) * 1000);
+		waited = at[i];
+		sayBusy(at[i]);
+	}
+	IOExitThread();
+}
+
+bool
+IONetworkStackUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	/* whether the registry is quiet at this moment is what the namer goes on to ask */
+	proc_selfname(who, sizeof(who));
+	IOLog("SweetNetworkStack: opened by %s; the registry's busy state is %u\n", who,
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	static bool watching;
+	if (!watching) {
+		watching = true;
+		(void) IOCreateThread(watchBusy, NULL);
+	}
+	return true;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* "Name this interface" (a dictionary: IONetworkStackUserCommand, IOPathMatch, IOInterfaceUnit). */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject * properties)
+{
+	static unsigned said;
+
+	if (said++ < 4) {
+		IOLog("SweetNetworkStack: asked to name an interface: there are none of that kind\n");
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/*
+ * Boot 56: the registry stayed busy (1) with no busy service under its root. That is the count
+ * StartIOKitMatching() adds to the root "until the IOKit daemon has completely finished launching"
+ * (IOStartIOKit.cpp): this kernel is built with the macOS SDK (!NO_KEXTD), so it waits for
+ * kernelmanagerd, which an iOS root does not have (an iOS kernel, NO_KEXTD, never adds the count).
+ * The registry never went quiet, so configd's interface namer never said "*QUIET*" and everything
+ * behind SCNetworkInterfaceCopyAll() waited its 300 s (wifid, Settings). So the daemon's arrival is
+ * stood in for, once, as early as sweet_wifi_init() runs (bsd_init, after PE_init_iokit's
+ * StartIOKitMatching): the deferred matches start, the root's count goes, IOUserResources gets
+ * "IOKit", as when kernelmanagerd checks in. (Not when the kernel has no daemon to wait for:
+ * boot-arg -restore.)
+ */
+void
+SweetIOKitDaemonStandIn(void)
+{
+	static bool done;
+
+	if (done || !OSKext::iokitDaemonAvailable()) {
+		return;
+	}
+	done = true;
+	IOLog("SweetNetworkStack: no IOKit daemon on iOS: its arrival is stood in for (the registry's busy state %u)\n",
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	IOService::iokitDaemonLaunched();
+}
+
+void
+SweetNetworkStackStart(void)
+{
+	/* where the real one is: IOService:/IOResources/IONetworkStack */
+	IOService * resources = IOService::getResourceService();
+	IONetworkStack * stack = OSTypeAlloc(IONetworkStack);
+
+	if (resources == NULL || stack == NULL || !stack->init() || !stack->attach(resources)) {
+		OSSafeReleaseNULL(stack);
+		IOLog("SweetNetworkStack: cannot create the service\n");
+		return;
+	}
+	if (!stack->start(resources)) {
+		stack->detach(resources);
+	}
+	stack->release();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_HEROLTE */
diff --git a/iokit/Kernel/arm/SweetWLAN.cpp b/iokit/Kernel/arm/SweetWLAN.cpp
new file mode 100644
index 0000000..126bede
--- /dev/null
+++ b/iokit/Kernel/arm/SweetWLAN.cpp
@@ -0,0 +1,142 @@
+/* From HackiOS's iokit/Kernel/hakios.wlan.cpp (github.com/oosexgang/hackios-xnu-kernel; APSL 2.0), for
+ * apollo's Wi-Fi (xnu 0128); its warnings are not looked at (written for a build without -Werror). */
+#pragma clang diagnostic ignored "-Weverything"
+/*
+ * HakiosWLAN: the registry entries by which iOS finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (bsd/dev/hakios.net.c) and has no IOKit object behind
+ * it of its own; iOS looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which bsd/dev/hakios.apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ * So: a controller of the class IO80211Controller under the platform, and below it one object
+ * that is both, an IONetworkInterface with wifid's properties. Both classes are ours, named as
+ * IO80211Family and IONetworkingFamily name theirs; neither has anything but properties.
+ */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_HEROLTE)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void HakiosWLANStart(const char * interface, const uint8_t * address);
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class HakiosWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(HakiosWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HakiosWLAN, IONetworkInterface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+HakiosWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("HakiosWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when the interface of a radio exists. */
+void
+HakiosWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	HakiosWLAN * wlan = OSTypeAlloc(HakiosWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("HakiosWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	if ((controller = (IO80211Controller *) publish(controller, platform, "HakiosWLANController")) == NULL) {
+		wlan->release();
+		IOLog("HakiosWLAN: the controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "HakiosWLAN") == NULL) {
+		IOLog("HakiosWLAN: the service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_HEROLTE */
