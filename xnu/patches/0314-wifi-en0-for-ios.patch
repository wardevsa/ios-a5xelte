+		out[n].frequency = (uint16_t)(2407 + 5 * c);
+		out[n++].flags = 0;
+	}
+	for (unsigned i = 0; i < sizeof(five) / sizeof(five[0]) && n < most; i++) {
+		out[n].frequency = (uint16_t)(5000 + 5 * five[i]);
+		out[n++].flags = (uint16_t)(five[i] >= 52 && five[i] <= 144 ? HAKIOS_STA_CHANNEL_PASSIVE | HAKIOS_STA_CHANNEL_RADAR : 0);
+	}
+	return n;
