+/*
+ * The noise floor told with every signal (xnu 0131): ath11k's own figure (ATH11K_DEFAULT_NOISE_FLOOR, the value
+ * it reckons signal strengths against); the firmware is not asked. Without a noise floor (0) iOS's signal-to-noise
+ * is the signal itself, -41 dBm, and the status bar showed a weak signal next to the access point (boot 56).
+ */
+#define NOISE_FLOOR             (-95)
+/*
+ * RSSI_BOUNDS (106): wifid asks it while it sets the device up (and tries again only on an error); the
+ * layout {version 1, the weakest, the strongest, a threshold} (dBm) and these values are iOSPlus10's
+ * (patches/xnu/README-wifi.md "0345", from the 20H392 binaries; the values are its guess, min < threshold
+ * < max). Refused, wifid had no range to put a signal in (boot 57: the status bar weak at -41 dBm).
+ */
+#define RSSI_BOUND_MIN          (-90)
+#define RSSI_BOUND_MAX          (-40)
+#define RSSI_BOUND_THRESHOLD    (-80)
+#define PHY_11A                 0x2u
+#define PHY_11B                 0x4u
+#define PHY_11G                 0x8u
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
