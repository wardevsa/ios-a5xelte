+static int
+hw_sta_scan(const struct hakios_sta_scan *what)
+{
+	uint8_t escan[72] = { 0 };
+	uint32_t v = 1, minus = 0xffffffffu, slen = what->ssid_length <= 32 ? what->ssid_length : 0;
+	uint16_t action = 1, sync = 0x1234;
+	memcpy(escan, &v, 4);
+	memcpy(escan + 4, &action, 2);
+	memcpy(escan + 6, &sync, 2);
+	memcpy(escan + 8, &slen, 4);
+	memcpy(escan + 12, what->ssid, slen);
+	memset(escan + 8 + 36, 0xff, 6);                        /* bssid: broadcast */
+	escan[8 + 42] = 2;                                      /* bss_type: any */
+	escan[8 + 43] = what->passive ? 1 : 0;
+	for (unsigned i = 0; i < 4; i++) {
+		memcpy(escan + 8 + 44 + i * 4, &minus, 4);
+	}
+	lck_mtx_lock(&hw_lock);
+	if (hw_phase == HAKIOS_STA_OFF) {
+		lck_mtx_unlock(&hw_lock);
+		return ENETDOWN;
+	}
+	hw_heard_count = 0;
+	hw_scan_done = false;
+	if (hw_phase == HAKIOS_STA_IDLE) {
+		hw_phase = HAKIOS_STA_SCANNING;
+	}
+	int err = hw_ioctl(WLC_SET_VAR, "escan", escan, sizeof(escan), NULL, 0);
+	lck_mtx_unlock(&hw_lock);
+	for (unsigned t = 0; err == 0 && t < 800 && !hw_scan_done; t++) {
+		IOSleep(10);
+	}
+	lck_mtx_lock(&hw_lock);
+	if (hw_phase == HAKIOS_STA_SCANNING) {
+		hw_phase = HAKIOS_STA_IDLE;
+	}
+	lck_mtx_unlock(&hw_lock);
+	return err == 0 ? 0 : EIO;
+}
