+/*
+ * herowifi=1, before launchd (bsd_init.c): en0 and the registry entries iOS looks for, made at once with the link down;
+ * wifid and configd look for them as they start, once, and the radio comes up behind them some 45 s later
+ * (herolte_gpu.c). As on apollo (xnu 0129, 0131): IONetworkStack for configd's interface namer, and the IOKit daemon's
+ * arrival stood in for so that the registry goes quiet (herowifiquiet=0 leaves that out).
+ */
+void
+herolte_wifi_early(void)
+{
+	uint32_t wifi = 0, quiet = 1;
+	DTEntry node;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	if (!PE_parse_boot_argn("herowifi", &wifi, sizeof(wifi)) || !wifi) {
+		return;
+	}
+	PE_parse_boot_argn("herowifiquiet", &quiet, sizeof(quiet));
+	if (quiet) {
+		SweetIOKitDaemonStandIn();
+	}
+	SweetNetworkStackStart();
+	hakios_net_init();
+	/* the address MobileGestalt reports as the Wi-Fi's (mkadt_herolte.py's /chosen mac-address-wifi0) */
+	bool adt = SecureDTLookupEntry(NULL, "/chosen", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "mac-address-wifi0", &prop, &size) == kSuccess && size == 6;
+	if (adt) {
+		memcpy(hw_net_link.address, prop, 6);
+	} else {
+		read_random(hw_net_link.address, 6);
+		hw_net_link.address[0] = (uint8_t)((hw_net_link.address[0] & 0xfe) | 0x02);
+	}
+	hw_en0 = hakios_net_attach(&hw_net_link);
+	printf("HEROLTE WIFI: en0 %s, its address %s; the radio comes later\n", hw_en0 ? "made" : "NOT MADE",
+	    adt ? "the ADT's mac-address-wifi0" : "a random one");
+}
