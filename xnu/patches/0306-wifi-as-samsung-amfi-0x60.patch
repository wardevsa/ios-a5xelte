+++ b/bsd/dev/herolte_gpu.c
@@ -2790,8 +2790,8 @@ hg_twrp_thread(void *arg, __unused wait_result_t wr)
 
 /*
  * Boot-arg herowifi=1, the first step of Wi-Fi: the BCM4359 is on PCIe channel 0 (FSYS1), as Linux's pci-exynos.c brings it up.
- * Its enable pin high, clocks, the PHY's table, the link trained, and the chip's identity read through the iATU. A step a
- * flush apart, so that the log says which one stalled the bus. Nothing is written to the chip itself.
+ * In its order and with its timing: the chip gets #PERST high about 20 ms before the link starts, not half a minute, and Samsung's
+ * driver tries up to ten times. The LTSSM's history says how far each try got. Nothing is written to the chip itself.
  */
 static void
 hw_step(const char *what)
@@ -2801,97 +2801,161 @@ hw_step(const char *what)
 }
 
 static void
-hg_wifi_thread(__unused void *arg, __unused wait_result_t wr)
+hw_pulse(vm_offset_t elbi, unsigned reg)
+{
+	for (unsigned t = 0; t < 3; t++) {
+		hg_wr(elbi, reg, t != 1);
+		delay(10);
+	}
+}
+
+/* exynos_pcie_phy_config(): 26 MHz, Gen1 */
+static void
+hw_phy_config(vm_offset_t elbi, vm_offset_t phy, vm_offset_t pcs, vm_offset_t sys)
 {
 	static const uint8_t cmn[26] = { 0x01, 0x0F, 0xA6, 0x31, 0x90, 0x62, 0x20, 0x00, 0x00, 0xA7, 0x0A, 0x37, 0x20, 0x08, 0xEF, 0xFC, 0x96, 0x14,
 		                         0x00, 0x10, 0x60, 0x01, 0x00, 0x00, 0x04, 0x10 };
 	static const uint8_t trsv[41] = { 0x31, 0xF4, 0xF4, 0x80, 0x25, 0x40, 0xD8, 0x03, 0x35, 0x55, 0x4C, 0xC3, 0x10, 0x54, 0x70, 0xC5, 0x00, 0x2F,
 		                          0x38, 0xA4, 0x00, 0x3B, 0x30, 0x9A, 0x64, 0x00, 0x1F, 0x83, 0x1B, 0x01, 0xE0, 0x00, 0x00, 0x02, 0x00, 0x00,
 		                          0x00, 0x00, 0x00, 0x1D, 0x00 };
+	hg_wr(sys, 0x44, hg_rd(sys, 0x44) & ~2u);
+	hg_wr(sys, 0x50, ((hg_rd(sys, 0x50) & ~(0xfu << 4) & ~(0xfu << 2)) | (3u << 2)) & ~2u);
+	hw_pulse(elbi, 0x288);
+	for (unsigned i = 0; i < sizeof(cmn); i++) {
+		hg_wr(phy, i * 4, cmn[i]);
+	}
+	for (unsigned i = 0; i < sizeof(trsv); i++) {
+		hg_wr(phy, (0x30 + i) * 4, trsv[i]);
+	}
+	hg_wr(phy, 0x5c * 4, 0x14);
+	hg_wr(pcs, 0xf8, 0x70);
+	hg_wr(pcs, 0xc, hg_rd(pcs, 0xc) | (1u << 4));
+	hw_pulse(elbi, 0x290);
+	hw_pulse(elbi, 0x28c);
+}
+
+/* What Samsung's table calls the PHY clocks' gates are these three muxes: the PHY's own outputs or the oscillator. */
+static void
+hw_phy_clocks(vm_offset_t cmu, bool on)
+{
+	static const unsigned mux[3] = { 0x240, 0x230, 0x234 };
+	for (unsigned i = 0; i < 3; i++) {
+		hg_wr(cmu, mux[i], on ? hg_rd(cmu, mux[i]) | (1u << 12) : hg_rd(cmu, mux[i]) & ~(1u << 12));
+	}
+}
+
+/* dw_pcie_setup_rc() */
+static void
+hw_setup_rc(vm_offset_t dbi)
+{
+	hg_wr(dbi, 0x8bc, 1);                                   /* read-only registers may be written */
+	hg_wr(dbi, 0x710, (hg_rd(dbi, 0x710) & ~(0x3fu << 16)) | (1u << 16));
+	hg_wr(dbi, 0x80c, (hg_rd(dbi, 0x80c) & ~(0x1ffu << 8)) | (1u << 8));
+	hg_wr(dbi, 0x7c, (hg_rd(dbi, 0x7c) & ~((7u << 15) | (0x3fu << 4) | 0xfu)) | (6u << 15) | (1u << 4) | 2u);
+	hg_wr(dbi, 0xb40, 0x1a);                                /* auxiliary clock: 26 MHz */
+	hg_wr(dbi, 0xb44, 0xd2);
+	hg_wr(dbi, 0x44, 0);                                    /* power management */
+	hg_wr(dbi, 0x10, 4);
+	hg_wr(dbi, 0x14, 0);
+	hg_wr(dbi, 0x18, (hg_rd(dbi, 0x18) & 0xff000000u) | 0x00010100u); /* buses: primary 0, secondary 1, subordinate 1 */
+	hg_wr(dbi, 0x20, 0x1df01c00u);                          /* memory window: 0x1c000000 to 0x1dffffff */
+	hg_wr(dbi, 0x04, (hg_rd(dbi, 0x04) & 0xffff0000u) | 0x107u);
+	hg_wr(dbi, 0x80, hg_rd(dbi, 0x80) | (1u << 5));         /* retrain */
+	hg_wr(dbi, 0xa0, (hg_rd(dbi, 0xa0) & ~0xfu) | 1u);      /* Gen1 */
+}
+
+static void
+hw_history(vm_offset_t elbi)
+{
+	for (unsigned i = 0; i < 32; i += 8) {
+		printf("HEROLTE WIFI: ltssm %#x %#x %#x %#x %#x %#x %#x %#x\n", (hg_rd(elbi, 0x138 + i * 4) >> 16) & 0x3f, (hg_rd(elbi, 0x13c + i * 4) >> 16) & 0x3f,
+		    (hg_rd(elbi, 0x140 + i * 4) >> 16) & 0x3f, (hg_rd(elbi, 0x144 + i * 4) >> 16) & 0x3f, (hg_rd(elbi, 0x148 + i * 4) >> 16) & 0x3f,
+		    (hg_rd(elbi, 0x14c + i * 4) >> 16) & 0x3f, (hg_rd(elbi, 0x150 + i * 4) >> 16) & 0x3f, (hg_rd(elbi, 0x154 + i * 4) >> 16) & 0x3f);
+	}
+}
