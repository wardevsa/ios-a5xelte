diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 177cb1b..10e01a9 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -388,6 +388,15 @@ sweet_amfi_dyld_syscall(__unused struct proc *p, int call, user_addr_t arg)
 	} args;
 	uint64_t flags;
 
+	/*
+	 * Request 0x60, the state of AMFI's boot-args: unless one of the bits 0x86 is set, ExtensionKit wants the signature of
+	 * /System/Library/xpc/extensions.plist checked by AMFI's IOKit service, which is not here. The table is then not read and
+	 * LaunchServices refuses every application extension (found by FiiO JM21's kernel, kern_minimac.c).
+	 */
+	if (call == 0x60) {
+		flags = 0x86;
+		return copyout(&flags, arg, sizeof(flags));
+	}
 	if (call != 90 || (flags = herolte_gl_dyld_flags()) == 0) {
 		return ENOPOLICY;
 	}
