+/*
+ * 0468 (D-0113): the scenario bench, heroscen=<settle seconds> with herogov=2. The kernel plays the same gestures every time through
+ * sweet_hid_touch (the entry point of the real touch driver) and measures each run, so one boot gives several A/B comparisons without a
+ * finger and with the order alternated to cancel drift: round 0 caps the big cluster at 2288, 1976, 1664 MHz, round 1 at 1664, 1976, 2288,
+ * and in each configuration it plays paging (10 swipes), spotlight (3 pull-downs) and 15 s of idle. After every run one line:
+ * duration, mean battery current while discharging (and its samples), frames presented, their spacing buckets, SoC/battery temperature,
+ * clock changes and saturated governor samples. Gestures stay inside the panel, away from the edges (no system gestures).
+ */
+static void
+hs_touch(int down, int x, int y)
+{
+	extern void sweet_hid_touch(int finger, int down, int x, int y);
+	if (down) {
+		herolte_touch_last_mach = mach_absolute_time();     /* the governor sees a finger, as with the real driver */
+	}
+	sweet_hid_touch(0, down, x, y);
+}
+
+static void
+hs_swipe(int x0, int y0, int x1, int y1, unsigned ms)
+{
+	unsigned steps = ms / 20 ? ms / 20 : 1;
+	hs_touch(1, x0, y0);
+	hg_msleep(20);
+	for (unsigned i = 1; i <= steps; i++) {
+		hs_touch(1, x0 + (x1 - x0) * (int)i / (int)steps, y0 + (y1 - y0) * (int)i / (int)steps);
+		hg_msleep(20);
+	}
+	hs_touch(0, x1, y1);
+}
+
+static void
+hs_play(unsigned scen)
+{
+	switch (scen) {
+	case 0:         /* paging: ten swipes, left and right */
+		for (unsigned i = 0; i < 10; i++) {
+			hs_swipe(i % 2 ? 230 : 850, 1200, i % 2 ? 850 : 230, 1200, 240);
+			hg_msleep(700);
+		}
+		break;
+	case 1:         /* spotlight: pull down, hold, push up, three times */
+		for (unsigned i = 0; i < 3; i++) {
+			hs_swipe(540, 700, 540, 1500, 300);
+			hg_msleep(800);
+			hs_swipe(540, 1500, 540, 500, 300);
+			hg_msleep(800);
+		}
+		break;
+	default:        /* idle */
+		hg_msleep(15000);
+		break;
+	}
+}
+
+static void
+hs_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const char *const names[] = { "paging", "spotlight", "idle" };
+	static const unsigned order[2][3] = { { 4, 3, 2 }, { 2, 3, 4 } };
+	uint32_t settle = 0;
+	extern volatile uint64_t herolte_screen_off_at;
+	extern volatile int herolte_fg_temp_dc;
+	PE_parse_boot_argn("heroscen", &settle, sizeof(settle));
+	if (!settle) {
+		return;
+	}
+	hg_msleep(settle * 1000);
+	printf("HEROLTE SCEN: bench starts: caps 2288 1976 1664 / 1664 1976 2288 MHz, scenarios paging spotlight idle\n");
+	for (unsigned r = 0; r < 2; r++) {
+		for (unsigned k = 0; k < 3; k++) {
+			g2_cap = order[r][k];
+			hg_msleep(2500);
+			for (unsigned s = 0; s < 3; s++) {
+				if (herolte_screen_off_at != 0) {
+					printf("HEROLTE SCEN: screen off, bench stops\n");
+					g2_cap = (unsigned)G2_N - 1;
+					return;
+				}
+				uint64_t fp0 = herolte_fb_presented, h0[6], ps0 = herolte_pwr_sum, pn0 = herolte_pwr_n, tr0 = g2_stat_trans, sa0 = g2_stat_sat, sm0 = g2_stat_samples;
+				for (unsigned b = 0; b < 6; b++) {
+					h0[b] = herolte_fb_gap_hist[b];
+				}
+				uint64_t t0 = mach_absolute_time(), ns = 0;
+				hs_play(s);
+				absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+				uint64_t pn = herolte_pwr_n - pn0;
+				printf("HEROLTE SCEN: end round %u cap %u MHz scen %s dur_ms %llu mA_mean %llu mA_n %llu frames %llu gaps %llu %llu %llu %llu %llu %llu temp_dc %d changes %llu saturated %llu of %llu\n",
+				    r, g2_lv[order[r][k]], names[s], ns / 1000000, pn ? (herolte_pwr_sum - ps0) / pn : 0, pn, herolte_fb_presented - fp0,
+				    herolte_fb_gap_hist[0] - h0[0], herolte_fb_gap_hist[1] - h0[1], herolte_fb_gap_hist[2] - h0[2], herolte_fb_gap_hist[3] - h0[3], herolte_fb_gap_hist[4] - h0[4],
+				    herolte_fb_gap_hist[5] - h0[5], herolte_fg_temp_dc, g2_stat_trans - tr0, g2_stat_sat - sa0, g2_stat_samples - sm0);
+				hg_msleep(1500);
+			}
+		}
+	}
+	g2_cap = (unsigned)G2_N - 1;
+	printf("HEROLTE SCEN: bench finished\n");
+}
