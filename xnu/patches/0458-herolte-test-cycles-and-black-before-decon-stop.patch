+/*
+ * 0458 (D-0096): the same state change as RequestPowerChange, for the herocycle test schedule in bsd/dev/herolte_gpu.c, so that a
+ * test needs no finger on the Power button. iOS is not told: it keeps its own idea of the screen and redraws on the next swap.
+ */
+extern "C" void
+herolte_fb_power(int off)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	if (fb == NULL) {
+		return;
+	}
+	if (!off) {
+		herolte_disp_restore();
+	}
+	IOLockLock(fb->fLock);
+	if ((bool)off != fb->fPowerOff) {
+		fb->fPowerOff = off;
+		fb->fFadeStep = 0;
+		fb->fDirty = true;
+		herolte_fb_dark = 0;
+	}
+	IOLockUnlock(fb->fLock);
+	herolte_screen_off_at = off ? mach_absolute_time() : 0;
+	IOLog("SWEET FB: display %s\n", off ? "off" : "on");
+}
+#endif
