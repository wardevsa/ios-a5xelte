herolte: breadcrumbs of a core waking from CPU_SUSPEND (0440)

min69: cpu 7 entered deep idle, the 2 ms virtual timer did not wake it, and PSCI CPU_ON on it returned 0 (it was OFF); it still never reached cpu_idle_exit. 0440 finds where it dies: MMU-off stores in start.s (sweet_secondary_entry: context id and CurrentEL; reset_vector: the reset handler found for the core; start_cpu: the CPU data address) to the trampoline page (slot 0x100 + 64 * (Aff0 + 8 * (Aff1 & 1)), cleared by the power thread before the test), and a cleaned counter in arm_init_idle_cpu. The watchdog prints them with the CPU_ON result. heroidle only (D-0089).

--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -122,6 +122,32 @@
 	.align	7
 	b		.
 
+
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * 0440: breadcrumbs of a core that wakes from PSCI CPU_SUSPEND (min68/min69: CPU_ON returned 0, so it was OFF, and it never
+ * reached cpu_idle_exit). MMU off, plain stores to the CPU_ON trampoline's page (0x8fffe000, written to by nothing else):
+ * slot = 0x100 + 64 * (Aff0 + 8 * (Aff1 & 1)), qword idx. idx0 = the context id at the entry, idx1 = the reset handler found
+ * for the core (reset_vector), idx2 = the CPU data physical address at start_cpu, idx3 = CurrentEL at the entry. The power
+ * thread clears the slot of the core under test and reads it back. Clobbers x16 and x17 only.
+ */
+.macro HEROLTE_CRUMB idx, val
+	mrs		x16, MPIDR_EL1
+	and		x17, x16, #0xff
+	ubfx	x16, x16, #8, #8
+	and		x16, x16, #1
+	lsl		x16, x16, #3
+	add		x17, x17, x16
+	lsl		x17, x17, #6
+	mov		x16, #0xe000
+	movk	x16, #0x8fff, lsl #16
+	add		x16, x16, x17
+	add		x16, x16, #0x100
+	str		\val, [x16, #(8 * \idx)]
+	dsb		sy
+.endmacro
+#endif
+
 	.align	7
 	.globl EXT(reset_vector)
 LEXT(reset_vector)
@@ -165,6 +191,9 @@
 	adrp	x20, EXT(const_boot_args)@page
 	add		x20, x20, EXT(const_boot_args)@pageoff
 	ldr		x0, [x21, CPU_RESET_HANDLER]		// Call CPU reset handler
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	HEROLTE_CRUMB 1, x0
+#endif
 	cbz		x0, Lskip_cpu_reset_handler
 
 	// Validate that our handler is one of the two expected handlers
@@ -288,6 +317,11 @@
 	.align 2
 	.globl EXT(sweet_secondary_entry)
 LEXT(sweet_secondary_entry)
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	HEROLTE_CRUMB 0, x0
+	mrs		x2, CurrentEL
+	HEROLTE_CRUMB 3, x2
+#endif
 	msr		DAIFSet, #0xf
 	mrs		x1, CurrentEL
 	cmp		x1, #0x4
@@ -348,6 +382,9 @@
 
 	.align 2
 start_cpu:
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	HEROLTE_CRUMB 2, x21
+#endif
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 	// This is done right away in reset vector for pre-KTRR devices
