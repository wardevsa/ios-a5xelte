diff --git a/bsd/dev/herolte_gl.c b/bsd/dev/herolte_gl.c
new file mode 100644
index 0000000..b2ef08b
--- /dev/null
+++ b/bsd/dev/herolte_gl.c
@@ -0,0 +1,63 @@
+/*
+ * HEROLTE GL: CoreAnimation's render server (backboardd) on the Mali.
+ *
+ * iOS 16's QuartzCore falls back to its OpenGL ES renderer when Metal makes
+ * no context; the EAGL shim (gpu/eagl, libheroeagl.dylib in the drop zone)
+ * gives it a working ES3 EAGLContext over Mesa's Panfrost. This puts the
+ * shim into backboardd without touching the root image: when launchd
+ * execs /usr/libexec/backboardd, exec_extract_strings() appends
+ *   DYLD_INSERT_LIBRARIES=/private/var/herolte/lib/libheroeagl.dylib
+ *   HERO_LOG_STDERR=1          (the shim's stderr goes to the kernel log)
+ * to its environment. Guards: boot-arg herogl=1 (2 also sets
+ * EAGL_SHIM_DEBUG=1), the dylib must exist, and only the first two
+ * launches of a boot get it: if backboardd dies twice, the next one is
+ * stock, so a broken shim costs two restarts and no more.
+ */
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <string.h>
+#include <pexpert/pexpert.h>
+
+int herolte_gl_env(const char *path, const char **extra, int max);
+
+#define HGL_TARGET      "/usr/libexec/backboardd"
+#define HGL_SHIM        "/private/var/herolte/lib/libheroeagl.dylib"
+#define HGL_MAX_LAUNCHES 2
+
+static int hgl_mode = -1;
+static int hgl_launches;
+
+int
+herolte_gl_env(const char *path, const char **extra, int max)
+{
+	if (hgl_mode < 0) {
+		hgl_mode = 0;
+		PE_parse_boot_argn("herogl", &hgl_mode, sizeof(hgl_mode));
+	}
+	if (hgl_mode == 0 || path == NULL || strcmp(path, HGL_TARGET) != 0 || max < 3) {
+		return 0;
+	}
+	int launch = ++hgl_launches;
+	if (launch > HGL_MAX_LAUNCHES) {
+		printf("HEROLTE GL: backboardd launch %d: stock (the shim had %d launches)\n",
+		    launch, HGL_MAX_LAUNCHES);
+		return 0;
+	}
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(HGL_SHIM, 0, &vp, vfs_context_kernel()) != 0) {
+		printf("HEROLTE GL: backboardd launch %d: no %s, stock\n", launch, HGL_SHIM);
+		return 0;
+	}
+	vnode_put(vp);
+	int n = 0;
+	extra[n++] = "DYLD_INSERT_LIBRARIES=" HGL_SHIM;
+	extra[n++] = "HERO_LOG_STDERR=1";
+	if (hgl_mode >= 2) {
+		extra[n++] = "EAGL_SHIM_DEBUG=1";
+	}
+	printf("HEROLTE GL: backboardd launch %d: EAGL shim inserted (herogl=%d)\n", launch, hgl_mode);
+	return n;
+}
+#endif /* ARM64_BOARD_CONFIG_HEROLTE */
