+/* The firmware's files are in place (hg_wifi_thread waits for them). Before the root is mounted there is nothing to look in. */
+bool
+herolte_wifi_files_ready(void)
+{
+	vnode_t vp = NULLVP;
+	if (rootvnode == NULLVP || vnode_lookup("/private/var/herolte/wifi/fw.bin", 0, &vp, vfs_context_kernel()) != 0) {
+		return false;
+	}
+	vnode_put(vp);
+	return true;
 }
