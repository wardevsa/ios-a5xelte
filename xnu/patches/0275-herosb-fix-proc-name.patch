  * nothing on the screen to show for it, and at BASEPRI_DEFAULT they had the fast cores before the UI.
  */
-extern char *proc_name_address(void *p);
+extern char *proc_name_address(struct proc *p);
 
 static inline bool
 sweet_is_hog(thread_t thread)
