herolte: deep idle for chosen cores through PSCI CPU_SUSPEND, off by default (0438)

E-0288: Linux idles this phone's cores with CPU_SUSPEND 0xc4000001, parameter 0x10000 (cpu-sleep, 560 s against 5 s of WFI), 25-35 mA with the screen off against iOS 540 mA. E-0289: the monitor is PSCI 0.1 (VERSION, FEATURES and AFFINITY_INFO return -1; CPU_ON works): the DTB names cpu_suspend/cpu_off/cpu_on. heroidle=<mask> (e.g. 128 = cpu 7; never cpu 0): 20 s after the power thread starts the cores of the mask may power down in cpu_idle (CleanPoC_Dcache, SMC CPU_SUSPEND, entry = the CPU_ON trampoline at 0x8fffe000, checked not written) and wake through sweet_secondary_entry -> reset_vector -> resume_idle_cpu -> arm_init_idle_cpu -> cpu_idle_exit(TRUE); SweetCPU::initCPU(false) calls pe_init_fiq() instead of panicking. A watchdog in the power thread sends a wake-up SGI to a core asleep for more than 150 ms (in case its timer does not survive) and switches deep idle off if one has not come back after 3 s. HEROLTE IDLE lines once a minute with the entry and resume counts. Needs the Director's written approval (D-0089) before an image with heroidle is written.

--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -481,6 +481,41 @@
  *	Routine:	cpu_idle
  *	Function:
  */
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * 0438: deep idle, one core at a time (boot-arg heroidle=<logical-CPU mask>, enabled by the power thread in
+ * bsd/dev/herolte_gpu.c; off by default). TWRP's Linux idles this phone's cores with PSCI CPU_SUSPEND, parameter 0x10000
+ * (state "cpu-sleep": 560 s against 5 s of WFI, E-0288); the monitor is PSCI 0.1 (E-0289). The core wakes through the
+ * trampoline of the CPU_ON path (sweet_secondary_entry -> reset_vector -> resume_idle_cpu -> arm_init_idle_cpu ->
+ * cpu_idle_exit(TRUE)), which XNU arms for every core in cpu_machine_idle_init.
+ */
+volatile uint32_t herolte_idle_mask;
+volatile uint64_t herolte_idle_entry_pa;
+volatile uint64_t herolte_idle_enter[MAX_CPUS], herolte_idle_resume[MAX_CPUS], herolte_idle_since[MAX_CPUS];
+
+static bool
+herolte_idle_suspend(cpu_data_t *cdp)
+{
+	unsigned c = (unsigned)cdp->cpu_number;
+	if (c == 0 || c >= MAX_CPUS || !(herolte_idle_mask & (1u << c)) || herolte_idle_entry_pa == 0) {
+		return false;
+	}
+	herolte_idle_enter[c]++;
+	herolte_idle_since[c] = mach_absolute_time();
+	CleanPoC_Dcache();
+	__builtin_arm_dsb(DSB_SY);
+	register uint64_t x0 __asm__("x0") = 0xC4000001ULL;     /* CPU_SUSPEND (the DTB's cpu_suspend) */
+	register uint64_t x1 __asm__("x1") = 0x10000ULL;        /* power state: power down (cpu-sleep) */
+	register uint64_t x2 __asm__("x2") = herolte_idle_entry_pa;
+	register uint64_t x3 __asm__("x3") = c;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	/* Only reached when the call returns: an error, or the core did not power down. */
+	herolte_idle_since[c] = 0;
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_HEROLTE */
+
 void __attribute__((noreturn))
 cpu_idle(void)
 {
@@ -587,6 +622,10 @@
 		__builtin_arm_dsb(DSB_SY);
 #if HAS_RETENTION_STATE
