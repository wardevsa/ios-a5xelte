+#elif defined(ARM64_BOARD_CONFIG_HEROLTE)
+		if (!herolte_idle_suspend(cpu_data_ptr)) {
+			__builtin_arm_wfi();
+		}
 #else
 		__builtin_arm_wfi();
 #endif
@@ -640,6 +679,12 @@
 
 	/* Back from WFI, unlock OSLAR and EDLAR. */
 	if (from_reset) {
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+		if ((unsigned)cpu_data_ptr->cpu_number < MAX_CPUS) {
+			herolte_idle_since[cpu_data_ptr->cpu_number] = 0;
+			herolte_idle_resume[cpu_data_ptr->cpu_number]++;
+		}
+#endif
 		configure_coresight_registers(cpu_data_ptr);
