+/*
+ * (0330) Sleep and heat. With the screen off (Power, SweetFramebuffer.cpp) for 3 s, or the battery at herohot degrees
+ * (42 by default; the MAX77854's TEMP, herolte_battery.c), the Mongoose cluster goes back to the bootloader's rate and
+ * voltage; with the screen on and the battery 3 degrees cooler, up to herocpu_mhz again. The A53s are left as they are.
+ * Boot-arg heropower=0: none of it. herotmu=0: the SoC's four TMUs are not read; by default they (BOOT DTB tmuctrl@1006x000, no clocks of their own)
+ * are read, nothing written, once a minute after the first two, for their calibration.
+ */
+volatile uint64_t herolte_screen_off_at;        /* mach time the display went off; 0 while it is on */
+volatile int herolte_fg_temp_dc = -10000;       /* the battery, tenths of a degree; -10000 not read */
+
+static const uint32_t hp_tmu_pa[] = { 0x10060000u, 0x10064000u, 0x10068000u, 0x1006c000u };   /* MNGS, APOLLO, GPU, ISP */
+
+static unsigned
+hp_boot_mhz(void)
+{
+	uint32_t m = (hc.boot_pll >> 16) & 0x3ff, p = (hc.boot_pll >> 8) & 0x3f, s = hc.boot_pll & 7;
+	return p ? 26 * m / (p << s) : 0;
+}
+
+static void
+hg_power_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	extern struct processor *cpu_to_processor(int cpu);
+	extern struct processor *thread_bind(struct processor *processor);
+	uint32_t hot = 42, tmu_on = 1;
+	PE_parse_boot_argn("herohot", &hot, sizeof(hot));
+	PE_parse_boot_argn("herotmu", &tmu_on, sizeof(tmu_on));
+	uint32_t cool = hot > 3 ? hot - 3 : 0;
+	for (unsigned i = 0; i < 300 && !hc.saved; i++) {
+		hg_msleep(1000);
+	}
+	if (!hc.saved) {
+		printf("HEROLTE POWER: the Mongoose cluster's boot state was not saved: left as it is\n");
+		return;
+	}
+	/* (the rate is changed from an A53, as at boot) */
+	thread_bind(cpu_to_processor(0));
+	hg_msleep(1);
+	printf("HEROLTE POWER: Mongoose to %u MHz with the screen off or the battery at %u C (back under %u C)\n", hp_boot_mhz(), hot, cool);
+	vm_offset_t tmu[4] = { 0 };
+	bool hot_now = false;
+	uint64_t last_log = 0;
+	unsigned logs = 0;
+	for (;;) {
+		hg_msleep(200);
+		uint64_t now = mach_absolute_time(), off = herolte_screen_off_at, ns = 0;
+		if (off != 0 && now > off) {
+			absolutetime_to_nanoseconds(now - off, &ns);
+		}
+		bool screen_off = off != 0 && ns > 3ull * NSEC_PER_SEC;
+		int t = herolte_fg_temp_dc;
+		if (t > -400 && t < 1000) {
+			if (t >= (int)hot * 10) {
+				hot_now = true;
+			} else if (t <= (int)cool * 10) {
+				hot_now = false;
+			}
+		}
+		bool want_low = screen_off || hot_now;
+		unsigned tenths = (unsigned)(t < 0 ? -t : t) % 10;
+		if (!hc.broken && want_low == hc.high) {
+			bool ok = want_low ? hc_go_low() : hc_go_high();
+			printf("HEROLTE POWER: Mongoose %s %u MHz (screen %s%s, battery %d.%u C)\n", ok ? "to" : "NOT to",
+			    want_low ? hp_boot_mhz() : hc.mhz, screen_off ? "off" : "on", hot_now ? ", hot" : "", t / 10, tenths);
+		}
+		uint64_t since = 0;
+		absolutetime_to_nanoseconds(now - last_log, &since);
+		if (last_log == 0 || since > 60ull * NSEC_PER_SEC) {
+			last_log = now;
+			printf("HEROLTE POWER: battery %d.%u C, Mongoose %s, screen %s\n", t / 10, tenths, hc.high ? "up" : "down",
+			    off ? "off" : "on");
+			if (tmu_on && ++logs > 2) {
+				for (unsigned i = 0; i < 4; i++) {
+					if (!tmu[i]) {
+						printf("HEROLTE TMU: reading %#x\n", hp_tmu_pa[i]);
+						tmu[i] = ml_io_map(hp_tmu_pa[i], 0x1000);
+					}
+					if (tmu[i]) {
+						printf("HEROLTE TMU: %#x: trim %#x %#x ctrl %#x %#x status %#x temp %#x %#x %#x\n", hp_tmu_pa[i],
+						    hg_rd(tmu[i], 0x0), hg_rd(tmu[i], 0x4), hg_rd(tmu[i], 0x20), hg_rd(tmu[i], 0x24),
+						    hg_rd(tmu[i], 0x28), hg_rd(tmu[i], 0x40), hg_rd(tmu[i], 0x44), hg_rd(tmu[i], 0x48));
+					}
+				}
+			}
+		}
+	}
 }
 
