-		{ 0x434, 1, 3 }, { 0x430, 5, 3 }, { 0x40c, 3, 6 }, { 0x410, 3, 4 }, { 0x414, 7, 4 }, { 0x418, 7, 4 },
-	};
+	uint8_t now = 0, set = 0;
+	if (!herolte_apm_pmic_read(0x1d, &now)) {
+		return false;
+	}
+	if (now < hc.volt) {
+		bool wrote = herolte_apm_mngs_voltage(hc.volt);
+		delay(200);
+		if (!wrote || !herolte_apm_pmic_read(0x1d, &set) || set != hc.volt) {
+			printf("HEROLTE CPU: vdd_mngs %#x -> %#x failed (now %#x), left alone\n", now, hc.volt, set);
+			return false;
+		}
+	}
+	hg_wr(hc.sysreg, 0x314, 0x001091b9);    /* MNGS_EMA_CON for 900 mV and more */
+	hg_wr(hc.sysreg, 0x1040, 0);            /* MNGS_ASSIST_CON */
+	for (unsigned i = 0; i < HC_NDIVS; i++) {
+		uint32_t mask = (1u << hc_divs[i].bits) - 1;
+		hg_wr(hc.mngs, hc_divs[i].off, (hg_rd(hc.mngs, hc_divs[i].off) & ~mask) |
+		    (hc_divs[i].off == 0x430 ? hc.promise : hc_divs[i].ratio));
+		delay(20);
+	}
+	hc_to_switch();
+	if (!hc_relock((hc.m << 16) | (3u << 8) | (1u << 5))) {
+		printf("HEROLTE CPU: MNGS_PLL did not lock (%#x): the cores stay on the switch\n", hg_rd(hc.mngs, 0x100));
+		hc.broken = true;
+		return false;
+	}
+	hc_from_switch();
+	hc.high = true;
+	return true;
+}
+
+/* Down to the bootloader's numbers: the switch, the PLL relocked as it was, its dividers, back to it, EMA, then the voltage. */
+static bool
+hc_go_low(void)
+{
+	extern bool herolte_apm_mngs_voltage(uint8_t value);
+	hc_to_switch();
+	if (!hc_relock(hc.boot_pll)) {
+		printf("HEROLTE CPU: MNGS_PLL did not lock at the boot rate (%#x)\n", hg_rd(hc.mngs, 0x100));
+		if (hc_relock((hc.m << 16) | (3u << 8) | (1u << 5))) {
+			hc_from_switch();
+		}
+		hc.broken = true;
+		return false;
+	}
+	for (unsigned i = 0; i < HC_NDIVS; i++) {
+		hg_wr(hc.mngs, hc_divs[i].off, hc.boot_div[i]);
+		delay(20);
+	}
+	hc_from_switch();
+	hc.high = false;
+	hg_wr(hc.sysreg, 0x314, hc.boot_ema);
+	hg_wr(hc.sysreg, 0x1040, hc.boot_assist);
+	uint8_t set = 0;
+	bool wrote = herolte_apm_mngs_voltage(hc.boot_volt);
+	delay(200);
+	if (!wrote || !herolte_apm_pmic_read(0x1d, &set) || set != hc.boot_volt) {
+		printf("HEROLTE CPU: vdd_mngs back to %#x failed (now %#x)\n", hc.boot_volt, set);
+	}
+	return true;
+}
