+/* Over to BUS_PLL / 2 (528 MHz) through the switch mux, the cores' own PLL stopped from feeding them. */
 static void
-hg_cpu_up(void)
+hc_to_switch(void)
+{
+	hg_wr(hc.top, 0x990, hg_rd(hc.top, 0x990) | 1);
+	hg_wr(hc.top, 0x4f0, (hg_rd(hc.top, 0x4f0) & ~0xfu) | 1);
+	hc_mux(hc.top, 0x380, 0);
+	hc_mux(hc.mngs, 0x204, 1);
+	hc_mux(hc.mngs, 0x208, 1);
+}
+
+static void
+hc_from_switch(void)
+{
+	hc_mux(hc.mngs, 0x208, 0);
+	hc_mux(hc.mngs, 0x204, 0);
+}
+
+/* MNGS_PLL relocked with these M/P/S (and bits 5, 26) while the cores run on the switch. */
+static bool
+hc_relock(uint32_t bits)
+{
+	uint32_t con0 = (hg_rd(hc.mngs, 0x100) & ~HC_PLL_BITS) | (bits & HC_PLL_BITS);
+	hg_wr(hc.mngs, 0x000, 3 * 150);         /* MNGS_PLL_LOCK */
+	hg_wr(hc.mngs, 0x100, con0);
+	for (unsigned i = 0; i < 10000; i++) {
+		delay(1);
+		if ((hg_rd(hc.mngs, 0x100) >> 29) & 1) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Voltage first (read back), then EMA, dividers, the switch, the PLL at the raised rate, back to it. */
+static bool
+hc_go_high(void)
 {
 	extern bool herolte_apm_mngs_voltage(uint8_t value);
-	static const struct {
