diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index d2462d8..a4a507c 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6893,7 +6893,10 @@ void
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	/* ptoa(), not pp << PAGE_SHIFT: that shift is done in 32 bits and
+	 * drops the high bits of RAM above 4 GiB (HEROLTE's bank 2 at
+	 * 0x880000000; a write-combined user mapping panicked in phystokv). */
+	flush_dcache((vm_offset_t) ptoa(pp), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP
