-	printf("HEROLTE AUDIO: tone: %u frames sent, %u waits, i2s con %#x, level %#x\n", sent, stuck, hg_rd(i2s, 0), hg_rd(i2s, 8));
+	printf("HEROLTE AUDIO: tone: %u frames sent in %llu ms, %u waits, i2s con %#x, level %#x\n", sent, (mach_absolute_time() - tone_start) / 26000, stuck, hg_rd(i2s, 0), hg_rd(i2s, 8));
 	hg_wr(i2s, 0x00, 1u << 31);
 	hg_wr(ha_wdt, 0, 0);
 }
@@ -2517,6 +2644,7 @@ hg_audio_thread(void *arg, __unused wait_result_t wr)
 		printf("HEROLTE AUDIO: codec register %#x = %#x (%s), SPI status %#x\n", regs[i], value, ok ? "read" : "TIMEOUT", hg_rd(ha_spi, 0x14));
 	}
 	if ((int)(uintptr_t)arg >= 2) {
+		ha_serve = (int)(uintptr_t)arg == 3;
 		ha_tone();
