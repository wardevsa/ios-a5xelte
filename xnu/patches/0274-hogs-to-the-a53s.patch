diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index 65af9c1..c81c6b6 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -152,10 +152,33 @@ bool sched_stats_active;
  */
 static cpumap_t sweet_fast_map = 0xf0;
 
+/*
+ * Herolte: Mongoose is three or four times an A53 here. launchd and mediaserverd alone use up to three CPUs, with
+ * nothing on the screen to show for it, and at BASEPRI_DEFAULT they had the fast cores before the UI.
+ */
+extern char *proc_name_address(void *p);
+
+static inline bool
+sweet_is_hog(thread_t thread)
+{
+	static const char *const hogs[] = { "launchd", "mediaserverd", "logd", "kernel_task", "xpcproxy", "cfprefsd" };
+	void *proc = get_bsdtask_info(get_threadtask(thread));
+	if (proc == NULL) {
+		return false;
+	}
+	const char *name = proc_name_address(proc);
+	for (unsigned i = 0; i < sizeof(hogs) / sizeof(hogs[0]); i++) {
+		if (strncmp(name, hogs[i], 17) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
 static inline bool
 sweet_wants_fast(thread_t thread)
 {
-	return thread->sched_pri >= BASEPRI_DEFAULT;
+	return thread->sched_pri >= BASEPRI_USER_INITIATED && !sweet_is_hog(thread);
 }
 
 /* Idle CPU from idle_map in the thread's preferred class, else any; -1 if none. */
@@ -5125,7 +5148,7 @@ choose_processor(
 					cpumap_t idle = pset->cpu_state_map[PROCESSOR_IDLE] & pset->primary_map &
 					    pset->recommended_bitmask;
 					bool fast = bit_test(sweet_fast_map, processor->cpu_id);
-					bool want = thread->sched_pri >= BASEPRI_RTQUEUES || sweet_wants_fast(thread);
+					bool want = sweet_wants_fast(thread);
 					if (fast != want && (idle & (want ? sweet_fast_map : ~sweet_fast_map)) != 0) {
 						processor = PROCESSOR_NULL;
 						break;
