diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 477f1ba..e5d0a6c 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2514,6 +2514,29 @@ hg_audio_thread(void *arg, __unused wait_result_t wr)
 	}
 }
 
+/*
+ * What the memory and the buses run at, as the bootloader left them: nothing here sets them (no DVFS). Read only. A PLL's
+ * CON0: M in bits 25:16, P in 13:8, S in 2:0, rate = 26 MHz * M / (P * 2^S).
+ */
+static void
+hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const struct { const char *name; uint32_t base, con0; } plls[] = {
+		{ "MIF0", 0x10850000u, 0x100 }, { "BUS0", 0x10570000u, 0x100 }, { "BUS1", 0x10570000u, 0x120 },
+		{ "BUS2", 0x10570000u, 0x140 }, { "BUS3", 0x10570000u, 0x160 },
+	};
+	hg_msleep(30000);
+	for (unsigned i = 0; i < sizeof(plls) / sizeof(plls[0]); i++) {
+		vm_offset_t cmu = ml_io_map(plls[i].base, 0x1000);
+		uint32_t con0 = cmu ? hg_rd(cmu, plls[i].con0) : 0;
+		uint32_t m = (con0 >> 16) & 0x3ff, p = (con0 >> 8) & 0x3f, s = con0 & 7;
+		printf("HEROLTE BUS: %s PLL con0 %#x = %u MHz\n", plls[i].name, con0, p ? 26 * m / (p << s) : 0);
+		if (plls[i].con0 == 0x100 && plls[i].base == 0x10850000u) {
+			printf("HEROLTE BUS: MIF0 mux %#x bus %#x aclk %#x\n", hg_rd(cmu, 0x200), hg_rd(cmu, 0x204), hg_rd(cmu, 0x208));
+		}
+	}
+}
+
 /*
  * Boot-arg herotwrp=SECONDS: after that long the phone restarts into recovery by itself, as Samsung's sec_reboot does
  * for "reboot recovery", so that a test runs with nobody at the buttons. The log has its last flush first.
@@ -2541,6 +2564,9 @@ herolte_gpu_probe(void)
 	uint32_t twrp = 0;
 
 	PE_parse_boot_argn("herogpu_flush", &hg_flush_mode, sizeof(hg_flush_mode));
+	if (kernel_thread_start(hg_bus_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	if (PE_parse_boot_argn("herotwrp", &twrp, sizeof(twrp)) && twrp > 0 &&
 	    kernel_thread_start(hg_twrp_thread, (void *)(uintptr_t)twrp, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
