+/* The PTE of a user VA (0: none): for the log. */
+static uint64_t
+hgu_pte(uint64_t va)
+{
+	if (va < HGU_VA_BASE || va >= HGU_VA_END || !hgp_scr) {
+		return 0;
+	}
+	unsigned l2i = (unsigned)((va >> 21) & 0x1ff);
+	if (hgu_l3_of[l2i] == 0) {
+		return 0;
+	}
+	return ((volatile uint64_t *)(hgp_scr + HGU_L3_OFF + (hgu_l3_of[l2i] - 1u) * 0x1000))[(va >> 12) & 0x1ff];
+}
