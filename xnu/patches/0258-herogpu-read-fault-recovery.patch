@@ -447,6 +447,35 @@ hg_clock_set(void)
  * Without this one MMU fault left the job stalled on its slot, and every
  * later job of every client timed out behind it ("slot busy").
  */
+static uint64_t hgu_pte(uint64_t va);
+static unsigned hg_read_faults;         /* in a row; hg_run() clears it */
+
+/* What the state is when a job gets a read fault: the first few of them in a row, and now and then after. */
+static void
+hg_read_fault_report(void)
+{
+	static vm_offset_t pmu, top;
+	static unsigned told;
+
+	if (hg_read_faults > 4 && hg_read_faults % 4096 != 0) {
+		return;
+	}
+	if (told++ > 64) {
+		return;
+	}
+	if (!pmu) {
+		pmu = ml_io_map(0x105c4000u, 0x1000);
+		top = ml_io_map(0x10570000u, 0x1000);
+	}
+	uint64_t pte = hgu_pte(hg_job_va);
+	printf("HEROLTE GPU: read fault %u in a row: job %#llx pte %#llx | status %#x faultstatus %#x@%#x%08x "
+	    "| ready shader %#x tiler %#x l2 %#x | as status %#x | PMU G3D %#x/%#x | G3D_PLL %#x\n", hg_read_faults,
+	    hg_job_va, pte, hg_rd(hg_gpu, 0x034), hg_rd(hg_gpu, GPU_FAULTSTATUS), hg_rd(hg_gpu, GPU_FAULTADDR_LO + 4),
+	    hg_rd(hg_gpu, GPU_FAULTADDR_LO), hg_rd(hg_gpu, SHADER_READY_LO), hg_rd(hg_gpu, TILER_READY_LO),
+	    hg_rd(hg_gpu, L2_READY_LO), hg_rd(hg_gpu, AS0 + 0x28), pmu ? hg_rd(pmu, 0x60) : 0, pmu ? hg_rd(pmu, 0x64) : 0,
+	    top ? hg_rd(top, 0x1e0) : 0);
+}
