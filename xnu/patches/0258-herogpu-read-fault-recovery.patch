-	if ((hg_rd(hg_gpu, JS_BASE(0) + 0x24) & 0xff) != 0x08 &&
+	/*
+	 * JOB_READ_FAULT (0x42) with no MMU fault: seen with more than 1 GiB of
+	 * RAM, once it starts every later job of the boot fails the same way
+	 * with nothing left active on a slot. Reset for it too (backing off if
+	 * the reset does not help, a reset per job would stall everything).
+	 */
+	bool read_fault = (hg_last_js_status & 0xff) == 0x42;
+	if (read_fault) {
+		hg_read_faults++;
+		hg_read_fault_report();
+	}
+	if (!(read_fault && (hg_read_faults <= 16 || hg_read_faults % 64 == 0)) &&
+	    (hg_rd(hg_gpu, JS_BASE(0) + 0x24) & 0xff) != 0x08 &&
