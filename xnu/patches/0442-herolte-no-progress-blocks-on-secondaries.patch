herolte: the early progress blocks and text are drawn by the boot CPU only (0442)

min71 (0441): deep idle works on cpu 7 (enter 13534, resume 6677 in 13 minutes, the system lived 780 s, ~44 mA less with the screen off), but every wake-up goes through start_cpu, which draws the blue, cyan and pink blocks and "XNU MMU ON" (and the others) at fixed places of the framebuffer: they stayed over iOS. The six post-MMU blocks of start.s now skip themselves unless MPIDR_EL1 is the boot CPU (0x100).

--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -934,6 +934,13 @@
 	isb		sy
 
 #if defined(A5XELTE)
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	/* 0442: the progress blocks are for the boot CPU only: a core back from deep idle (0438) went through here thousands of times and left them over iOS */
+	mrs		x15, MPIDR_EL1
+	and		x15, x15, #0xffff
+	cmp		x15, #0x100
+	b.ne		Lherolte_nomark_1
+#endif
 	/* Blue block: the 4 KiB MMU is active and the framebuffer alias works. */
 	MOV64	x10, (A5XELTE_FB_PA+120*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xff0000ff
@@ -957,6 +964,9 @@
 	mov	x2, #288
 	bl	La5_draw_text
 	mov	lr, x17
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+Lherolte_nomark_1:
+#endif
 #endif
 
