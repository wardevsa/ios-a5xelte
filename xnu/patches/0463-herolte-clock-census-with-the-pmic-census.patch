 hg_pmic_census(const char *when)
 {
 	printf("HEROLTE PMIC: census %s\n", when);
+	hg_cmu_census();
 	for (unsigned base = 0; base < 0x80; base += 16) {
 		char line[16 * 3 + 1];
 		unsigned n = 0;
