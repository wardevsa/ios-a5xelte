+		{
+			static int told;
+			if (told < 12) {
+				const uint32_t *in = (const uint32_t *)args->structureInput;
+				told++;
+				IOLog("SWEET SURF: wrap sel %u refused: scalars %u [0x%llx 0x%llx] struct %u [%x %x %x %x %x %x %x %x]\n",
