 			ret = kIOReturnNoMemory;
 		} else {
 			bzero(mem->getBytesNoCopy(), s->allocSize);
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+			/*
+			 * A surface over the client's own memory: not mapped here, but it
+			 * must at least start with those pixels. Ignored, the surface
+			 * stayed empty for good (CoreAnimation's 180x180 icons).
+			 */
+			OSNumber *address = OSDynamicCast(OSNumber, props->getObject("IOSurfaceAddress"));
+			if (address != NULL && address->unsigned64BitValue() != 0) {
+				uint64_t want = (uint64_t)s->bytesPerRow * s->height;
+				int err = copyin((user_addr_t)address->unsigned64BitValue(), mem->getBytesNoCopy(),
+				    (vm_size_t)MIN(want, (uint64_t)s->allocSize));
+				IOLog("SWEET SURF: pixels of %ux%u taken from client address 0x%llx -> %d\n",
+				    s->width, s->height, address->unsigned64BitValue(), err);
+			}
+#endif
 			s->memory = mem;
 			s->mapCache = kIOMapDefaultCache;
 			if (!sweet_surface_publish(s)) {
@@ -733,6 +750,18 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 		IOLog("SWEET SURF: %s create id %u %ux%u fmt 0x%x bpe %u bpr %u planes %u size %u keys %u -> 0x%x\n",
