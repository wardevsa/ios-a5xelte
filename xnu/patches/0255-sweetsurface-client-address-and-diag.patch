 		    s->bytesPerRow, s->planeCount, s->allocSize, props->getCount(), ret);
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+		/* which keys a surface is asked for with, to tell who is meant to fill it */
+		OSCollectionIterator *keys = OSCollectionIterator::withCollection(props);
+		if (keys != NULL) {
+			while (OSSymbol *key = OSDynamicCast(OSSymbol, keys->getNextObject())) {
+				OSNumber *value = OSDynamicCast(OSNumber, props->getObject(key));
+				IOLog("SWEET SURF:   id %u key %s = 0x%llx\n", s->id, key->getCStringNoCopy(),
+				    value != NULL ? value->unsigned64BitValue() : 0);
+			}
+			keys->release();
+		}
+#endif
 	}
