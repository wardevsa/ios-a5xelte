+/* The A5's fragment clear: target pixels VA, size, row stride, color. */
+static bool
+hg_job_fragment(uint64_t pixels_va, uint32_t size, uint32_t stride, uint32_t color,
+    bool panel)
+{
+	hg_tables(panel);
+	uint64_t fb_va = HG_TEST_VA + HG_FBD_OFF;
+	uint64_t poly_va = HG_TEST_VA + HG_POLY_OFF;
+	volatile uint32_t *hdr = (volatile uint32_t *)(hg_mem + HG_DATA_OFF);
+	hdr[4] = 0x00010013;            /* 64-bit | FRAGMENT(9) << 1 | index 1 << 16 */
+	*(volatile uint64_t *)(hdr + 10) = fb_va;       /* payload at +40 */
+	volatile uint32_t *fb = (volatile uint32_t *)(hg_mem + HG_DATA_OFF + HG_FBD_OFF);
+	fb[1] = 31;                     /* LOCAL_STORAGE: no workgroup memory */
+	fb[8] = 0xb84da201;             /* RGBA8, identity swizzle, linear, clear/write */
+	fb[9] = 0x00141000;             /* tie-break 2, default ZS D24S8 */
+	fb[11] = ((size - 1) << 16) | (size - 1);       /* max pixel x, y */
+	*(volatile uint64_t *)(fb + 20) = pixels_va;    /* RT base at +80 */
+	fb[22] = stride;
+	for (unsigned i = 0; i < 4; i++) {
+		fb[32 + i] = color;     /* clear color at +128 */
+	}
+	fb[48] = 516;                   /* polygon list: 512-byte header + 4 */
+	fb[49] = 4095;                  /* hierarchical tiling disabled */
+	*(volatile uint64_t *)(fb + 50) = poly_va;
+	*(volatile uint64_t *)(fb + 52) = poly_va + 512;
+	*(volatile uint64_t *)(fb + 54) = poly_va;
+	*(volatile uint64_t *)(fb + 56) = poly_va;
+	volatile uint32_t *poly = (volatile uint32_t *)(hg_mem + HG_DATA_OFF + HG_POLY_OFF);
+	poly[128] = 0xa0000000;         /* empty-list body */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return hg_run(0, panel ? "FRAGMENT panel square" : "FRAGMENT private 16x16");
+}
