diff --git a/bsd/vm/vm_unix.c b/bsd/vm/vm_unix.c
index 64d187a..52df13e 100644
--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -1860,6 +1860,52 @@ done:
 	return error;
 }
 
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * HEROLTE (9201): the routine island of the dyld cache (osfmk/vm/vm_shared_region.c herolte_island_map), read into
+ * kernel memory here, where vnodes are at hand; vm_shared_region_map_file() maps it and frees the buffer.
+ */
+#define HEROLTE_ISLAND_PATH     "/System/Library/Caches/com.apple.herolte/routines.bin"
+extern void     *herolte_island_buf;
+extern vm_size_t herolte_island_size;
+
+static void
+herolte_island_load(void)
+{
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	off_t fs = 0;
+	int resid = 0, error;
+	void *buf;
+
+	if (herolte_island_buf != NULL) {
+		return;
+	}
+	if (vnode_lookup(HEROLTE_ISLAND_PATH, 0, &vp, ctx) != 0) {
+		return;
+	}
+	error = vnode_size(vp, &fs, ctx);
+	if (error == 0 && fs > 0 && fs <= (16 << 20) && (fs & PAGE_MASK) == 0) {
+		buf = kalloc_data((vm_size_t)fs, Z_WAITOK);
+		if (buf != NULL) {
+			error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)fs, 0, UIO_SYSSPACE, IO_NODELOCKED,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (error == 0 && resid == 0) {
+				herolte_island_buf = buf;
+				herolte_island_size = (vm_size_t)fs;
+			} else {
+				printf("HEROLTE ISLAND: read failed %d (resid %d)\n", error, resid);
+				kfree_data(buf, (vm_size_t)fs);
+			}
+		}
+	} else {
+		printf("HEROLTE ISLAND: %s has size %lld, not used\n", HEROLTE_ISLAND_PATH, (long long)fs);
+	}
+	vnode_put(vp);
+}
+#endif /* ARM64_BOARD_CONFIG_HEROLTE */
+
