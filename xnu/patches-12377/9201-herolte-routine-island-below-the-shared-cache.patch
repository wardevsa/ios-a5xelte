+	vm_size_t               island_size = herolte_island_size;
+
+	herolte_island_buf = NULL;
+	herolte_island_size = 0;
+#endif
 
 	vmlp_api_start(VM_SHARED_REGION_MAP_FILE);
 
@@ -2021,6 +2097,11 @@ vm_shared_region_map_file(
 		goto done;
 	}
 	assert(vmsr_num_slides == mappings_to_slide_cnt);
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
