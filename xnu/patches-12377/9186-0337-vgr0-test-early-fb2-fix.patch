diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 29d195a..5117ab9 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -1709,7 +1709,11 @@ static void
 hfb_give_up(const char *why)
 {
 	hfb_state = -1;
-	if (hfb_idma && hg_rd(hfb_idma, 0xb74) != (uint32_t)HG_FB_PA) {
+	/*
+	 * Always: the shadow (0xb74) can already say FB while a flip to FB2 waits in 0x74 (boot-0336: G1 off the window
+	 * for the VGR0 test, the flip not taken; once G1 was back it took that flip and showed FB2's old frame for good).
+	 */
+	if (hfb_idma) {
 		hg_wr(hfb_idma, 0x74, (uint32_t)HG_FB_PA);
 		hg_wr(hfb_idma, 0x1c, 1);
 	}
@@ -3196,12 +3200,54 @@ hg_vgr0_test(vm_offset_t decon, vm_offset_t vg, vm_offset_t mmu)
 	    wc, hg_rd(decon, 0x130));
 	for (unsigned s = 0; s < 8; s++) {
 		hg_msleep(1000);
-		printf("HEROLTE VGR0: %u s: enable %#x irq %#x shadow base %#x update req %#x\n", s + 1, hg_rd(vg, 0x00),
-		    hg_rd(vg, 0x04), hg_rd(vg, 0xb74), hg_rd(decon, 0x60));
+		printf("HEROLTE VGR0: %u s: enable %#x irq %#x shadow base %#x update req %#x | decon %#x pend %#x occ %#x %#x\n", s + 1,
+		    hg_rd(vg, 0x00), hg_rd(vg, 0x04), hg_rd(vg, 0xb74), hg_rd(decon, 0x60), hg_rd(decon, 0x0), hg_rd(decon, 0x48),
+		    hg_rd(decon, 0x10), hg_rd(decon, 0x14));
+		if (s == 0) {
+			hg_decon_measure(decon, "window 0 on VGR0");
+		}
 	}
 	hg_wr(decon, 0x130, wc);                                        /* back to G1 */
 	hg_wr(decon, 0x60, hg_rd(decon, 0x60) | 1u);
 	printf("HEROLTE VGR0: window 0 back to %#x (G1)\n", hg_rd(decon, 0x130));
+	hg_msleep(100);
+	hg_decon_measure(decon, "window 0 back on G1");
+}
+
+/*
+ * (0337) The test runs a few seconds into the boot, before backboardd presents: at 40 s (0336) it took G1 off the
+ * window while the two-buffer flips ran, and the panel kept FB2's old frame. Not run once the flips have begun.
+ */
+static void
+hg_vgr0_early(void)
+{
+	uint32_t vgr_test = 1;
+	PE_parse_boot_argn("herovgr", &vgr_test, sizeof(vgr_test));
+	vm_offset_t pmu1 = ml_io_map(0x105c4000u, 0x1000);
+	if (!vgr_test || !pmu1) {
+		return;
+	}
+	uint32_t st1 = hg_rd(pmu1, 0x1a4);
+	if ((st1 & 0xfu) != 0xfu) {
+		printf("HEROLTE VGR0: DISP1 off (status %#x): no test\n", st1);
+		return;
+	}
+	vm_offset_t decon = ml_io_map(0x13960000u, 0x1000), vgr0 = ml_io_map(0x13e03000u, 0x1000), mmu1 = ml_io_map(0x13e30000u, 0x1000);
+	if (!decon || !vgr0 || !mmu1) {
+		return;
+	}
+	if (hfb_state != 0) {
+		printf("HEROLTE VGR0: the panel flips have begun: no test\n");
+		return;
+	}
+	uint32_t wc = hg_rd(decon, 0x130);
+	printf("HEROLTE VGR0: before: window 0 %#x, decon %#x pend %#x occ %#x %#x sel %#x %#x\n", wc, hg_rd(decon, 0x0),
+	    hg_rd(decon, 0x48), hg_rd(decon, 0x10), hg_rd(decon, 0x14), hg_rd(decon, 0x18), hg_rd(decon, 0x1c));
+	if (!(wc & 1u) || ((wc >> 12) & 7u) != 0) {
+		printf("HEROLTE VGR0: window 0 is not on G1: no test\n");
+		return;
+	}
+	hg_vgr0_test(decon, vgr0, mmu1);
 }
 
 static void
@@ -3226,7 +3272,9 @@ hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 		hg_wr(mux_cmu, 0x200, hg_rd(mux_cmu, 0x200) | (1u << 12));
 		printf("HEROLTE DISP: vclk on DISP_PLL, status %#x\n", hg_rd(mux_cmu, 0x600));
 	}
-	hg_msleep(30000);
+	hg_msleep(3000);
+	hg_vgr0_early();
+	hg_msleep(27000);
 	/*
 	 * The panel takes a frame in command mode on its TE pulse, 60 times a second, but DECON_F as the bootloader leaves it
 	 * reads a frame in 35.8 ms: one TE in three, 20 Hz. Boot-arg herodisp=N: its clocks up, one step at a time and measured.
@@ -3291,13 +3339,6 @@ hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 					printf("HEROLTE DISP1: sysmmu ctrl %#x cfg %#x status %#x version %#x\n", hg_rd(mmu1, 0x0),
 					    hg_rd(mmu1, 0x4), hg_rd(mmu1, 0x8), hg_rd(mmu1, 0x34));
 				}
-				/* (0336) boot-arg herovgr=0 leaves VGR0 alone */
-				uint32_t vgr_test = 1;
-				PE_parse_boot_argn("herovgr", &vgr_test, sizeof(vgr_test));
-				if (vgr_test && vgr0 && mmu1) {
-					hg_msleep(10000);
-					hg_vgr0_test(decon, vgr0, mmu1);
-				}
 			} else {
 				printf("HEROLTE DISP1: domain off: VGR0 not read\n");
 			}
