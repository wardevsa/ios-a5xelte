diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 961f7e3..099526b 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -3162,6 +3162,30 @@ hg_bus_thread(__unused void *arg, __unused wait_result_t wr)
 				    hg_rd(dma, 0x78), hg_rd(dma, 0x7c), hg_rd(dma, 0x80), hg_rd(dma, 0xb74));
 			}
 		}
+		/*
+		 * (0335) Read only, for scaling in hardware: on the 8890 only the VGR channels scale (Samsung's
+		 * vpp_reg_set_in_format: "Unsupported Scaling in (V)G"), and VGR0 (0x13E03000, behind SysMMU 0x13E30000) is in
+		 * DISP1, whose power domain is PMU 0x105c41a0 (exynos8890.dtsi pd-disp1: CONFIG +0, STATUS +4). The block's
+		 * registers are read only when the domain says it is on: a gated block's registers are an external abort.
+		 */
+		vm_offset_t pmu1 = ml_io_map(0x105c4000u, 0x1000);
+		if (pmu1) {
+			uint32_t cfg1 = hg_rd(pmu1, 0x1a0), st1 = hg_rd(pmu1, 0x1a4), opt1 = hg_rd(pmu1, 0x1a8);
+			printf("HEROLTE DISP1: power domain config %#x status %#x option %#x\n", cfg1, st1, opt1);
+			if ((st1 & 0xfu) == 0xfu) {
+				vm_offset_t vgr0 = ml_io_map(0x13e03000u, 0x1000), mmu1 = ml_io_map(0x13e30000u, 0x1000);
+				for (unsigned o = 0; vgr0 && o < 0x50; o += 0x10) {
+					printf("HEROLTE DISP1: vgr0 +%#x: %#x %#x %#x %#x\n", o, hg_rd(vgr0, o), hg_rd(vgr0, o + 4),
+					    hg_rd(vgr0, o + 8), hg_rd(vgr0, o + 12));
+				}
+				if (mmu1) {
+					printf("HEROLTE DISP1: sysmmu ctrl %#x cfg %#x status %#x version %#x\n", hg_rd(mmu1, 0x0),
+					    hg_rd(mmu1, 0x4), hg_rd(mmu1, 0x8), hg_rd(mmu1, 0x34));
+				}
+			} else {
+				printf("HEROLTE DISP1: domain off: VGR0 not read\n");
+			}
+		}
 		vm_offset_t dsim = ml_io_map(0x13900000u, 0x1000);
 		for (unsigned o = 0; dsim && o < 0x80; o += 0x20) {
 			printf("HEROLTE DISP: dsim +%#x: %#x %#x %#x %#x %#x %#x %#x %#x\n", o, hg_rd(dsim, o), hg_rd(dsim, o + 4), hg_rd(dsim, o + 8), hg_rd(dsim, o + 12),
