+/*
+ * (0339) The vibration motor, for iOS. As on the Galaxy S9 (Scion's hakios.max77705.c, APSL, whose rules this follows):
+ * the MAX77854's haptic block (the MFD's PMIC, 0x66 on this bus) drives the motor and its strength is the duty of a PWM
+ * of the SoC. From the phone's own device tree (TWRP /proc/device-tree): /haptic pwm_id 1, period 37950 ns, duty 32500 ns
+ * (Samsung's strength), reg2 0x82 (MCONFIG: bit 7 the motor type, divide by 128), regulator VDD_MOT_3.3V = S2MPS16
+ * LDO34; pwm@136c0000 (samsung,s3c6400-pwm), TOUT1 on gpd0-5 function 2 (pinctrl@136D0000 pwm-tout1, pull-down); the
+ * PWM's clocks in CMU_PERIC0 (0x13610000; clk-exynos8890.c, Linux): PCLK gate +0x800 bit 8, SCLK (26 MHz) +0x844 bit 0.
+ * MAINCTRL1 (0x02) bit 7 the bias, MCONFIG (0x10) bit 6 the motor on (as the MAX77843's in Linux).
+ *
+ * THE CHIP IS THE PHONE'S CHARGER as well: only MAINCTRL1 bit 7 and MCONFIG bits 7, 6 and 1 are ever written, each change
+ * read back; one that does not read back ends the motor for the run.
+ *
+ * iOS (with /product/haptics closed-loop in the ADT) plays its vibrations and feedbacks as a waveform on the audio
+ * plug-in's "Actuator" (gpu/hakios-audio), which writes its samples (16-bit, one channel) to /dev/hakios-haptic: a
+ * write that is not silence keeps the motor going for 30 ms, at a strength from its loudness; a run is cut at a second.
+ * Boot-arg herohaptic=0: no motor (the node is still made: the plug-in's writes go nowhere).
+ */
+#define MFD_ADDR                0x66u
+#define MFD_MAINCTRL1           0x02
+#define MFD_MCONFIG             0x10
+#define HAP_PWM_PA              0x136c0000u
+#define HAP_CMU_PERIC0_PA       0x13610000u
+#define HAP_GPD0                0x20            /* pinctrl@136D0000: GPD0 con +0x20, dat +0x24, pud +0x28 */
+#define HAP_PIN                 5
+#define PWM_TCFG0               0x00
+#define PWM_TCFG1               0x04
+#define PWM_TCON                0x08
+#define PWM_TCNTB1              0x18
+#define PWM_TCMPB1              0x1c
+#define TCON1_START             (1u << 8)
+#define TCON1_UPDATE            (1u << 9)
+#define TCON1_INVERT            (1u << 10)
+#define TCON1_RELOAD            (1u << 11)
+#define HAP_PERIOD_NS           37950u
+#define HAP_MAX_DUTY_NS         32500u
+#define HAP_OSC_HZ              26000000u
+#define HAP_ACTIVE_US           30000u
+#define HAP_SILENT_BELOW        256u
+#define HAP_MAX_MS              1000u
+#define S2MPS16_L34CTRL         0x5e            /* LDO32 0x5c, LDO33 0x5d (herolte_touch.c) */
+
+extern bool herolte_apm_pmic_read(uint8_t reg, uint8_t *value);
+extern bool herolte_apm_pmic_write(uint8_t reg, uint8_t value);
+
+static vm_offset_t hap_pwm;
+static uint32_t hap_count;                      /* the period in the PWM's ticks */
+static bool hap_broken, hap_on;
+static volatile uint64_t hap_heard_us;
+static volatile uint32_t hap_heard_peak;
+static uint64_t hap_since_us;
+static unsigned hap_buzzes, hap_capped, hap_writes;
+
+static uint64_t
+hap_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+static void
+hap_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline((event_t)&hap_sleep_ms, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+mfd_read(uint8_t reg, uint8_t *value)
+{
+	lck_mtx_lock(&fg_bus_mtx);
+	fg_addr = MFD_ADDR;
+	bool ok = fg_message(false, &reg, 1, false) && fg_message(true, value, 1, true);
+	fg_addr = FG_ADDR;
+	lck_mtx_unlock(&fg_bus_mtx);
+	return ok;
+}
+
+/* A change of the haptic block's own bits, read back. */
+static bool
+hap_bits(uint8_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t now = 0, back = 0, buf[2];
+	if (hap_broken || !((reg == MFD_MAINCTRL1 && (mask & ~0x80u) == 0) || (reg == MFD_MCONFIG && (mask & ~0xC2u) == 0))) {
+		return false;
+	}
+	bool ok = mfd_read(reg, &now);
+	if (ok) {
+		buf[0] = reg;
+		buf[1] = (uint8_t)((now & ~mask) | (value & mask));
+		lck_mtx_lock(&fg_bus_mtx);
+		fg_addr = MFD_ADDR;
+		ok = fg_message(false, buf, 2, true);
+		fg_addr = FG_ADDR;
+		lck_mtx_unlock(&fg_bus_mtx);
+		ok = ok && mfd_read(reg, &back) && back == buf[1];
+	}
+	if (!ok) {
+		printf("HEROLTE HAPTIC: register %#x did not take %#x (read %#x, then %#x): the motor stays still\n",
+		    reg, value & mask, now, back);
+		hap_broken = true;
+	}
+	return ok;
+}
+
+static void
+hap_duty(uint32_t strength)                     /* 0 (50 %, still) to 10000 (Samsung's duty) */
+{
+	uint32_t duty_ns = HAP_PERIOD_NS / 2 + (HAP_MAX_DUTY_NS - HAP_PERIOD_NS / 2) * strength / 10000u;
+	uint32_t duty = (uint32_t)(((uint64_t)duty_ns * hap_count + HAP_PERIOD_NS / 2) / HAP_PERIOD_NS);
+	fg_wr(hap_pwm, PWM_TCNTB1, hap_count - 1);
+	fg_wr(hap_pwm, PWM_TCMPB1, hap_count - duty - 1);
+}
+
+static void
+hap_go(uint32_t strength)
+{
+	hap_duty(strength);
+	if (hap_on) {
+		return;
+	}
+	uint32_t tcon = fg_rd(hap_pwm, PWM_TCON);
+	fg_wr(hap_pwm, PWM_TCON, (tcon & ~TCON1_START) | TCON1_UPDATE | TCON1_INVERT);
+	tcon = fg_rd(hap_pwm, PWM_TCON);
+	fg_wr(hap_pwm, PWM_TCON, (tcon & ~TCON1_UPDATE) | TCON1_START | TCON1_RELOAD);
+	if (!hap_bits(MFD_MCONFIG, 0xC0, 0xC0)) {
+		fg_wr(hap_pwm, PWM_TCON, fg_rd(hap_pwm, PWM_TCON) & ~(TCON1_START | TCON1_RELOAD));
+		return;
+	}
+	hap_on = true;
+	hap_since_us = hap_now_us();
+	hap_buzzes++;
+}
+
+static void
+hap_still(void)
+{
+	if (!hap_on) {
+		return;
+	}
+	(void)hap_bits(MFD_MCONFIG, 0xC0, 0x00);
+	hap_duty(0);
+	fg_wr(hap_pwm, PWM_TCON, fg_rd(hap_pwm, PWM_TCON) & ~(TCON1_START | TCON1_RELOAD));
+	hap_on = false;
+}
+
+/* From the audio server's I/O thread: never waits. */
+static int
+hap_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+		bytes = bytes > (user_ssize_t)sizeof(samples) ? (user_ssize_t)sizeof(samples) : (bytes & ~(user_ssize_t)1);
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < (unsigned)(bytes / 2); i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)(-(int32_t)samples[i]) : (uint32_t)samples[i];
+			peak = v > peak ? v : peak;
+		}
+		if (peak > HAP_SILENT_BELOW) {
+			hap_heard_us = hap_now_us();
+			hap_heard_peak = peak;
+			if (hap_writes++ < 8) {
+				printf("HEROLTE HAPTIC: iOS plays on the motor: peak %u of 32768\n", peak);
+			}
+		}
+	}
+	return error;
+}
+
+static int
+hap_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw hap_cdevsw = {
+	.d_open = hap_open, .d_close = hap_open, .d_read = eno_rdwrt, .d_write = hap_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* The PWM, its pin and clocks, the motor's supply and the haptic block. False: no motor this run. */
+static bool
+hap_setup(void)
+{
+	hap_pwm = ml_io_map(HAP_PWM_PA, 0x1000);
+	vm_offset_t cmu = ml_io_map(HAP_CMU_PERIC0_PA, 0x3000);
+	if (!hap_pwm || !cmu || !fg_bus_setup()) {
+		printf("HEROLTE HAPTIC: the PWM, its clocks or the bus could not be mapped\n");
+		return false;
+	}
+	printf("HEROLTE HAPTIC: peric0 gates %#x %#x man %#x %#x qch %#x | gpd0 con %#x pud %#x\n", fg_rd(cmu, 0x800), fg_rd(cmu, 0x844),
+	    fg_rd(cmu, 0x1800), fg_rd(cmu, 0x1844), fg_rd(cmu, 0x2410), fg_rd(fg_pins, HAP_GPD0), fg_rd(fg_pins, HAP_GPD0 + 8));
+	fg_wr(cmu, 0x800, fg_rd(cmu, 0x800) | (1u << 8));              /* PCLK_PWM */
+	fg_wr(cmu, 0x844, fg_rd(cmu, 0x844) | 1u);                     /* SCLK_PWM */
+	/* gpd0-5: TOUT1 (function 2), pull-down, as the phone's pwm-tout1 */
+	fg_wr(fg_pins, HAP_GPD0 + 8, (fg_rd(fg_pins, HAP_GPD0 + 8) & ~(3u << (HAP_PIN * 2))) | (1u << (HAP_PIN * 2)));
+	fg_wr(fg_pins, HAP_GPD0, (fg_rd(fg_pins, HAP_GPD0) & ~(0xfu << (HAP_PIN * 4))) | (2u << (HAP_PIN * 4)));
+
+	/* channel 1's clock as it is set (timers 0 and 1 share prescaler 0: left alone), its own divider 1 */
+	fg_wr(hap_pwm, PWM_TCFG1, fg_rd(hap_pwm, PWM_TCFG1) & ~(0xfu << 4));
+	uint32_t tcfg0 = fg_rd(hap_pwm, PWM_TCFG0), tcfg1 = fg_rd(hap_pwm, PWM_TCFG1);
+	uint32_t tick_hz = HAP_OSC_HZ / ((tcfg0 & 0xffu) + 1) / (1u << ((tcfg1 >> 4) & 7u));
+	hap_count = (uint32_t)(((uint64_t)HAP_PERIOD_NS * tick_hz + 500000000ull) / 1000000000ull);
+	printf("HEROLTE HAPTIC: pwm tcfg0 %#x tcfg1 %#x tcon %#x: %u ticks of %u Hz a period\n", tcfg0, tcfg1,
+	    fg_rd(hap_pwm, PWM_TCON), hap_count, tick_hz);
+	if (hap_count < 16) {
+		printf("HEROLTE HAPTIC: the PWM's tick is too slow for its period: no motor\n");
+		return false;
+	}
+	hap_duty(0);
+	fg_wr(hap_pwm, PWM_TCON, (fg_rd(hap_pwm, PWM_TCON) & ~(TCON1_START | TCON1_RELOAD)) | TCON1_UPDATE | TCON1_INVERT);
+	fg_wr(hap_pwm, PWM_TCON, fg_rd(hap_pwm, PWM_TCON) & ~TCON1_UPDATE);
+
+	/* VDD_MOT_3.3V: S2MPS16 LDO34 (3.3 V is selector 0x3c, as LDO33's; bits 7:6 on), through the APM */
+	uint8_t l34 = 0;
+	bool ldo = false;
+	for (unsigned t = 0; t < 60 && !ldo; t++) {
+		ldo = herolte_apm_pmic_read(S2MPS16_L34CTRL, &l34);
+		if (!ldo) {
+			hap_sleep_ms(1000);             /* the touch thread starts the APM */
+		}
+	}
+	if (!ldo) {
+		printf("HEROLTE HAPTIC: the PMIC (LDO34) does not answer: no motor\n");
+		return false;
+	}
+	if ((l34 & 0x3fu) != 0x3cu && (l34 & 0x3fu) != 0) {
+		printf("HEROLTE HAPTIC: LDO34 is %#x, not 3.3 V: left alone, no motor\n", l34);
+		return false;
+	}
+	if ((l34 & 0xc0u) != 0xc0u || (l34 & 0x3fu) != 0x3cu) {
+		bool w = herolte_apm_pmic_write(S2MPS16_L34CTRL, 0xc0u | 0x3cu);
+		uint8_t now = 0;
+		(void)herolte_apm_pmic_read(S2MPS16_L34CTRL, &now);
+		printf("HEROLTE HAPTIC: VDD_MOT_3.3V (LDO34) %#x -> %#x%s\n", l34, now, w ? "" : " (the write was refused)");
+		if ((now & 0xc0u) != 0xc0u) {
+			return false;
+		}
+	}
+	uint8_t main1 = 0, mconfig = 0;
+	if (!mfd_read(MFD_MAINCTRL1, &main1) || !mfd_read(MFD_MCONFIG, &mconfig)) {
+		printf("HEROLTE HAPTIC: the MFD does not answer at 0x66: no motor\n");
+		return false;
+	}
+	printf("HEROLTE HAPTIC: MAINCTRL1 %#x MCONFIG %#x (as found)\n", main1, mconfig);
+	if (!hap_bits(MFD_MAINCTRL1, 0x80, 0x80) || !hap_bits(MFD_MCONFIG, 0xC2, 0x82)) {
+		return false;
+	}
+	return true;
+}
+
+static void
+hap_thread(__unused void *arg, __unused wait_result_t result)
+{
+	hap_sleep_ms(15000);    /* after the touch thread's PMIC start and the fuel gauge */
+	if (!hap_setup()) {
+		return;
+	}
+	printf("HEROLTE HAPTIC: the motor is ready for iOS (/dev/hakios-haptic), up to %u ms a run\n", HAP_MAX_MS);
+	uint32_t test = 1;              /* (0339, the first trial) herohaptictest=0: no buzz at start */
+	PE_parse_boot_argn("herohaptictest", &test, sizeof(test));
+	if (test) {
+		hap_go(10000);          /* half a second at full strength once ready: felt, the motor's path is good */
+		hap_sleep_ms(500);
+		hap_still();
+		printf("HEROLTE HAPTIC: test buzz done\n");
+	}
+	for (unsigned tick = 1;; tick++) {
+		uint64_t now = hap_now_us();
+		bool wanted = hap_heard_us != 0 && now - hap_heard_us < HAP_ACTIVE_US;
+		if (wanted && hap_on && now - hap_since_us >= HAP_MAX_MS * 1000ull) {
+			hap_capped++;
+			hap_still();
+			hap_heard_us = 0;       /* until iOS plays anew */
+		} else if (wanted && !hap_broken) {
+			/* the strength from iOS's loudness, with a floor a tap can be felt at */
+			uint32_t strength = hap_heard_peak * 10000u / 32768u;
+			hap_go(strength < 3000 ? 3000 : strength);
+		} else {
+			hap_still();
+		}
+		if (tick % (60 * 500) == 0 && hap_buzzes) {
+			printf("HEROLTE HAPTIC: a minute: %u buzzes, %u cut at %u ms\n", hap_buzzes, hap_capped, HAP_MAX_MS);
+		}
+		hap_sleep_ms(2);
+	}
+}
+
+/* /dev/hakios-haptic before user space (the audio plug-in opens it once) and the motor's thread. */
+void herolte_haptic_start(void);
+void
+herolte_haptic_start(void)
+{
+	int major = cdevsw_add(-1, &hap_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-haptic") == NULL) {
+		printf("HEROLTE HAPTIC: no /dev/hakios-haptic\n");
+		return;
+	}
+	uint32_t on = 1;
+	PE_parse_boot_argn("herohaptic", &on, sizeof(on));
+	thread_t thread;
+	if (on && kernel_thread_start(hap_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
