+	a5_gic_write32(a5_gicd_base, 0x280 + word, 1U << bit);                  /* ICPENDR */
+	a5_gic_write32(a5_gicd_base, 0x100 + word, 1U << bit);                  /* ISENABLER */
+	__builtin_arm_dsb(DSB_SY);
+	return (a5_gic_read32(a5_gicd_base, 0x100 + word) & (1U << bit)) != 0;
+}
 #endif
 
