+	char path[208];
+} hcont[HCONT_SLOTS];
+static unsigned hcont_next;
+static LCK_GRP_DECLARE(hcont_grp, "notefe-container");
+static LCK_SPIN_DECLARE(hcont_spin, &hcont_grp);
+
+void herolte_note_container(int pid, const char *env, size_t len);
+void
+herolte_note_container(int pid, const char *env, size_t len)
+{
+	const char *end = env + len;
+	for (const char *e = env; e < end && *e;) {
+		size_t l = strnlen(e, (size_t)(end - e));
+		if (l > 5 && strncmp(e, "HOME=", 5) == 0 && strnstr(e, "/Containers/", l) != NULL && l - 5 < sizeof(hcont[0].path)) {
+			lck_spin_lock(&hcont_spin);
+			unsigned slot = HCONT_SLOTS;
+			for (unsigned i = 0; i < HCONT_SLOTS; i++) {
+				if (hcont[i].pid == pid) {
+					slot = i;
+				}
+			}
+			if (slot == HCONT_SLOTS) {
+				slot = hcont_next++ % HCONT_SLOTS;
+			}
+			hcont[slot].pid = pid;
+			strlcpy(hcont[slot].path, e + 5, sizeof(hcont[slot].path));
+			lck_spin_unlock(&hcont_spin);
+			static unsigned noted;
+			if (noted++ < 30) {
+				printf("NOTEFE CONTAINER: pid %d %s\n", pid, e + 5);
+			}
+			return;
+		}
+		e += l + 1;
+	}
+}
+
+int herolte_container_for_pid(int pid, char *out, size_t size);
+int
+herolte_container_for_pid(int pid, char *out, size_t size)
+{
+	int found = 0;
+	lck_spin_lock(&hcont_spin);
+	for (unsigned i = 0; i < HCONT_SLOTS && !found; i++) {
+		if (hcont[i].pid == pid && hcont[i].path[0]) {
+			strlcpy(out, hcont[i].path, size);
+			found = 1;
+		}
+	}
+	lck_spin_unlock(&hcont_spin);
+	return found;
+}
