+static errno_t
+nbt_ring_init(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, __unused kern_channel_t channel,
+    kern_channel_ring_t ring, boolean_t is_tx_ring, __unused void **ring_ctx)
+{
