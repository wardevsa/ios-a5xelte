+static int herolte_gl_env_base(const char *path, int pid, const char **extra, int max);
+
+/*
+ * Note FE 0405: boot-arg herolog=name,name (default tccd,assetsd; - for none). The named programs (matched on the file
+ * name, and on the 15-character process name for the /dev/null tee in bsd/dev/mem.c) start with OS_ACTIVITY_DT_MODE=YES:
+ * libtrace then also writes their os_log lines to stderr, which launchd points at /dev/null, and the tee puts them in
+ * this log as "|name| ...". It is how we read what tccd answers and why (iOS keeps its unified log on the phone only).
+ */
+static char hlog_names[192];
+static int hlog_read;
+
+static bool
+herolte_name_in(const char *list, const char *name, size_t n)
+{
+	for (const char *t = list; *t != '\0';) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl > 0 && n > 0 && (tl == n || (n >= 15 && tl > n)) && strncmp(t, name, n) == 0) {
+			return true;        /* p_comm keeps 16 characters: CalendarWidgetEx... */
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+bool herolte_log_name(const char *name);
+bool
+herolte_log_name(const char *name)
+{
+	if (!hlog_read) {
+		hlog_read = 1;
+		if (!PE_parse_boot_argn("herolog", hlog_names, sizeof(hlog_names))) {
+			strlcpy(hlog_names, "tccd,assetsd", sizeof(hlog_names));
+		}
+		if (hlog_names[0] == '-') {
+			hlog_names[0] = '\0';
+		}
+		if (hlog_names[0] != '\0') {
+			printf("NOTEFE LOG: os_log of %s goes to this log (herolog)\n", hlog_names);
+		}
+	}
+	return name != NULL && herolte_name_in(hlog_names, name, strlen(name));
+}
+
+/*
+ * Note FE 0465: boot-arg herocap=name:percent,name:percent: those programs get XNU's task-wide CPU limit (THROTTLE, as
+ * 0324's herowidgetcap does for widget extensions). coreduetd spun at ~190% all boot long (cc-base1). A thread looks
+ * every 10 s for new processes of those names (the limit set at exec could be reset by the image's activation).
+ */
+extern int proc_set_task_ruse_cpu(task_t task, uint16_t policy, uint8_t percentage, uint64_t interval, uint64_t deadline,
+    int cpumon_entitled);
+static char hcap_arg[128];
+static int hcap_done_pid[32];
+static unsigned hcap_done_n;
+
+static int
+hcap_percent(const char *name)
+{
+	size_t nl = strlen(name);
+	for (const char *c = hcap_arg; *c != '\0';) {
+		const char *colon = strchr(c, ':');
+		if (colon == NULL) {
+			break;
+		}
+		size_t l = (size_t)(colon - c);
+		int pct = 0;
+		const char *d = colon + 1;
+		while (*d >= '0' && *d <= '9') {
+			pct = pct * 10 + (*d++ - '0');
+		}
+		if (l == nl && strncmp(c, name, l) == 0) {
+			return pct;
+		}
+		c = *d == ',' ? d + 1 : d;
+	}
+	return 0;
+}
+
+static int
+hcap_each(proc_t p, __unused void *arg)
+{
+	int pid = proc_getpid(p), pct = hcap_percent(p->p_comm);
+	if (pct <= 0 || pct > 100) {
+		return PROC_RETURNED;
+	}
+	for (unsigned i = 0; i < hcap_done_n && i < 32; i++) {
+		if (hcap_done_pid[i] == pid) {
+			return PROC_RETURNED;
+		}
+	}
+	int err = proc_set_task_ruse_cpu(proc_task(p), 0x01, (uint8_t)pct, 0, 0, 1);
+	hcap_done_pid[hcap_done_n++ % 32] = pid;
+	printf("NOTEFE CAP: %s[%d] limited to %d%% of a core: %d\n", p->p_comm, pid, pct, err);
+	return PROC_RETURNED;
+}
+
+static void
+hcap_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		proc_iterate(PROC_ALLPROCLIST, hcap_each, NULL, NULL, NULL);
+		delay(10 * 1000 * 1000);
+	}
+}
+
+static void
+hcap_start(void)
+{
+	static int started;
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (!PE_parse_boot_argn("herocap", hcap_arg, sizeof(hcap_arg)) || hcap_arg[0] == '\0') {
+		return;
+	}
+	thread_t th;
+	if (kernel_thread_start(hcap_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+		printf("NOTEFE CAP: herocap=%s\n", hcap_arg);
+	}
+}
+
 int
 herolte_gl_env(const char *path, int pid, const char **extra, int max)
+{
+	hcap_start();
+	int n = herolte_gl_env_base(path, pid, extra, max);
+	if (n < 0 || path == NULL || n >= max) {
+		return n;
+	}
+	const char *base = strrchr(path, '/');
+	base = base ? base + 1 : path;
+	if (herolte_log_name(base)) {
+		extra[n++] = "OS_ACTIVITY_DT_MODE=YES";
+		if (n < max) {
+			extra[n++] = "ACTIVITY_LOG_STDERR=1";      /* 0407: the other stderr switch libsystem_trace reads */
+		}
+		static unsigned announced;
+		if (announced++ < 40) {
+			printf("NOTEFE LOG: %s (pid %d) logs to the console\n", base, pid);
+		}
+	}
+	return n;
+}
