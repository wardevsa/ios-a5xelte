+/*
+ * Note FE (0415): wait for a client's job on the Mali's interrupt instead of polling. The polling loop read three
+ * registers every 10 us for the whole job (delay() sleeps and wakes on a timer each time here): backboardd's
+ * submitting thread was on a CPU for as long as the GPU worked, 31 % of all its samples (HERO_PROF, boot 11). Now:
+ * a short spin (most vertex/tiler jobs end within it), then the job's done/fail bits, any MMU fault and the GPU fault
+ * bits are unmasked, the GIC line (INTID 256-258, TWRP's /proc/interrupts) wakes the thread, and the handler masks
+ * them again (level-triggered: the line drops). A 2 ms timeout re-reads the status, so a missing interrupt costs
+ * time, not a hang; 200 ms in all, as before. Boot-arg herogpuirq=0: polling as before.
+ */
+#define JOB_IRQ_MASK    0x1008
+#define MMU_IRQ_MASK    0x2008
+#define GPU_IRQ_MASK    0x028
+static int hg_irq_state;                /* 0 not tried, 1 routed, -1 off */
+static volatile uint32_t hg_irq_armed;
+static uint32_t hg_irq_count, hg_irq_slept, hg_irq_timeouts, hg_irq_waits;
+static uint64_t hg_irq_sleep_us;
+static char hg_irq_event;
+
+extern bool herolte_gic_route_spi(uint32_t intid, unsigned int logical);
+
+void herolte_gpu_irq(uint32_t intid);
+void
+herolte_gpu_irq(uint32_t intid)
+{
+	(void)intid;
+	hg_irq_count++;
+	if (hg_irq_armed && hg_gpu) {
+		hg_irq_armed = 0;
+		hg_wr(hg_gpu, JOB_IRQ_MASK, 0);
+		hg_wr(hg_gpu, MMU_IRQ_MASK, 0);
+		hg_wr(hg_gpu, GPU_IRQ_MASK, 0);
+	}
+	thread_wakeup((event_t)&hg_irq_event);
+}
+
+static bool
+hg_irq_ready(void)
+{
+	if (hg_irq_state == 0) {
+		uint32_t on = 1;
+		PE_parse_boot_argn("herogpuirq", &on, sizeof(on));
+		hg_irq_state = -1;
+		if (on && hg_gpu) {
+			hg_wr(hg_gpu, JOB_IRQ_MASK, 0);
+			hg_wr(hg_gpu, MMU_IRQ_MASK, 0);
+			hg_wr(hg_gpu, GPU_IRQ_MASK, 0);
+			bool ok = herolte_gic_route_spi(256, 0) && herolte_gic_route_spi(257, 0) &&
+			    herolte_gic_route_spi(258, 0);
+			hg_irq_state = ok ? 1 : -1;
+		}
+		printf("NOTEFE GPUIRQ: %s\n", hg_irq_state == 1 ? "job waits on INTID 256-258 (CPU 0)" :
+		    on ? "routing failed, polling" : "off (herogpuirq=0), polling");
+	}
+	return hg_irq_state == 1;
+}
+
+static bool
+hg_job_ended(unsigned js, uint32_t *jirq, uint32_t *mirq, uint32_t *girq)
+{
+	*jirq = hg_rd(hg_gpu, JOB_IRQ_RAWSTAT);
+	*mirq = hg_rd(hg_gpu, MMU_IRQ_RAWSTAT);
+	*girq = hg_rd(hg_gpu, GPU_IRQ_RAWSTAT);
+	return (*jirq & ((1u << js) | (1u << (js + 16)))) || *mirq || (*girq & 0x81);
+}
+
+static void
+hg_wait_irq(unsigned js, uint32_t *jirq, uint32_t *mirq, uint32_t *girq)
+{
+	uint64_t start = mach_absolute_time(), spin, limit, now;
+	nanoseconds_to_absolutetime(30 * NSEC_PER_USEC, &spin);
+	nanoseconds_to_absolutetime(200 * NSEC_PER_MSEC, &limit);
+	hg_irq_waits++;
+	while (!hg_job_ended(js, jirq, mirq, girq)) {
+		now = mach_absolute_time();
+		if (now - start >= limit) {
+			hg_irq_timeouts++;
+			break;
+		}
+		if (now - start < spin) {
+			continue;
+		}
+		assert_wait_timeout((event_t)&hg_irq_event, THREAD_UNINT, 2000, NSEC_PER_USEC);
+		hg_irq_armed = 1;
+		hg_wr(hg_gpu, JOB_IRQ_MASK, (1u << js) | (1u << (js + 16)));
+		hg_wr(hg_gpu, MMU_IRQ_MASK, 0xffffffffu);
+		hg_wr(hg_gpu, GPU_IRQ_MASK, 0x81);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (hg_job_ended(js, jirq, mirq, girq)) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+		} else {
+			uint64_t t0 = mach_absolute_time();
+			hg_irq_slept++;
+			(void)thread_block(THREAD_CONTINUE_NULL);
+			hg_irq_sleep_us += hg_us_since(t0);
+		}
+		hg_irq_armed = 0;
+		hg_wr(hg_gpu, JOB_IRQ_MASK, 0);
+		hg_wr(hg_gpu, MMU_IRQ_MASK, 0);
+		hg_wr(hg_gpu, GPU_IRQ_MASK, 0);
+	}
+	if (hg_irq_slept >= 200 && hg_irq_count == 0) {
+		hg_irq_state = -1;      /* the line never fired: back to polling rather than 2 ms a job */
+		printf("NOTEFE GPUIRQ: no interrupt after %u sleeps: polling from now on\n", hg_irq_slept);
+	}
+	if ((hg_irq_waits & 0x1fff) == 0) {
+		printf("NOTEFE GPUIRQ: %u jobs waited for, %u slept (%llu us asleep), %u interrupts, %u timeouts\n",
+		    hg_irq_waits, hg_irq_slept, hg_irq_sleep_us, hg_irq_count, hg_irq_timeouts);
+	}
+}
