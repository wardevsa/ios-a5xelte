+#define NC_BUF          0xd0800000u
+#define NC_FULL_W       2608u
+#define NC_FULL_H       1960u
+#define NC_MAP_LEN      0xa00000u       /* 0457: the mapping covers a full frame and the stream's ring of 4 x 0x280000 */
+/* 0455: the frame's size by mode (0 full 2608x1960, 1 2x2 binned 1304x980, 2 centred 1280x720 crop), and the options
+ * that were boot-args (the line is nearly full): sysctl kern.notefe_cam_{tp,skip,pll,settle,mode} (root), set by the bot
+ * from the drop zone's cam.opts; a boot-arg of the same name (notefe_cam_tp ...) still wins. */
+extern vm_offset_t notefe_physmap(uint64_t pa, uint64_t len);
+extern vm_offset_t notefe_physmap_cached(uint64_t pa, uint64_t len);       /* 0467 */
+extern void flush_dcache(vm_offset_t addr, unsigned count, int phys);
