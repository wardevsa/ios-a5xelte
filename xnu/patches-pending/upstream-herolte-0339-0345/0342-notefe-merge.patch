+static bool
+nc_sensor_write(uint8_t a7, uint16_t reg, uint16_t val, int bits)
+{
+	nc_start();
+	bool ok = nc_byte_out((uint8_t)(a7 << 1)) && nc_byte_out((uint8_t)(reg >> 8)) && nc_byte_out((uint8_t)reg);
+	if (ok && bits == 16) {
+		ok = nc_byte_out((uint8_t)(val >> 8));
+	}
+	if (ok) {
+		ok = nc_byte_out((uint8_t)val);
+	}
+	nc_stop();
+	return ok;
+}
+
+static uint16_t
+nc_sensor_rd16(uint16_t reg)
+{
+	uint8_t b[2] = { 0xff, 0xff };
+	nc_sensor_read(0x35, reg, b, 2);
+	return (uint16_t)(b[0] << 8 | b[1]);
+}
+
+static void
+nc_csis_report(vm_offset_t csis, vm_offset_t mmu, const char *when)
+{
+	uint8_t fc = 0xee;
+	nc_sensor_read(0x35, 0x0005, &fc, 1);
+	uint32_t s0 = notefe_rd(csis, 0x14), s1 = notefe_rd(csis, 0x1c);
+	printf("NOTEFE CAM: frame %s: ch0 start %u end %u; errors: SOT_HS %u lost FS %u lost FE %u overflow %u wrong cfg %u "
+	    "ECC %u CRC %u ID %u; DMA start %u end %u error %u\n", when, (s0 >> 24) & 1, (s0 >> 20) & 1, (s0 >> 16) & 1,
+	    (s0 >> 12) & 1, (s0 >> 8) & 1, (s0 >> 4) & 1, (s0 >> 3) & 1, (s0 >> 2) & 1, (s0 >> 1) & 1, s0 & 1, (s1 >> 4) & 1,
+	    (s1 >> 8) & 1, (s1 >> 12) & 1);
+	printf("NOTEFE CAM: frame %s: sensor frame count %#x; CSIS2 DPHY_STATUS %#x INT_SRC0 %#x INT_SRC1 %#x FRM_CNT_CH0 %u "
+	    "DMA0 ctrl %#x act %#x bytes %u; SysMMU status %#x\n", when, fc, notefe_rd(csis, 0x20), notefe_rd(csis, 0x14),
+	    notefe_rd(csis, 0x1c), notefe_rd(csis, 0x100), notefe_rd(csis, 0x1000), notefe_rd(csis, 0x1030),
+	    notefe_rd(csis, 0x1040), notefe_rd(mmu, 8));
+}
+
+/* 0447: CSIS2 reset and set up for the 4E6's mode at a given settle (Samsung's csi_stream_on order), then enabled */
+static void
+nc_csis_setup(vm_offset_t csis, uint32_t settle)
+{
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) & ~1u);
+	notefe_wr(csis, 0x24, notefe_rd(csis, 0x24) & ~1u);
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | 2u);
+	for (unsigned n = 0; n < 100 && (notefe_rd(csis, 0x4) & 2u); n++) {
+		delay(10);
+	}
+	for (unsigned vc = 0; vc < 4; vc++) {
+		notefe_wr(csis, 0x1000 + vc * 0x100, (notefe_rd(csis, 0x1000 + vc * 0x100) | 1u) & ~2u);
+	}
+	notefe_wr(csis, 0x24, (notefe_rd(csis, 0x24) & ~(0xffu << 24) & ~(0xfu << 1)) | ((settle & 0xff) << 24) | (3u << 1));
+	notefe_wr(csis, 0x4, (notefe_rd(csis, 0x4) & ~(3u << 8) & ~(1u << 12) & ~(3u << 10)) | (1u << 8));
+	notefe_wr(csis, 0x40, (notefe_rd(csis, 0x40) & ~0x1fffu) | (0x2bu << 2) | (1u << 12));
+	notefe_wr(csis, 0x44, (nc_h << 16) | nc_w);
+	notefe_wr(csis, 0x1004, notefe_rd(csis, 0x1004) & ~(3u << 14));
+	for (uint32_t a = 0x1010; a <= 0x102c; a += 4) {
+		notefe_wr(csis, a, NC_BUF);
+	}
+	notefe_wr(csis, 0x1000, (notefe_rd(csis, 0x1000) & ~1u) | 2u);
+	notefe_wr(csis, 0x14, notefe_rd(csis, 0x14));
+	notefe_wr(csis, 0x1c, notefe_rd(csis, 0x1c));
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | (0xfu << 16));
+	notefe_wr(csis, 0x24, notefe_rd(csis, 0x24) | 1u);
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | 1u);
+}
+
+/*
+ * Note FE (0450, 0455): the last frame, binned for the Mac: every other 2x2 Bayer cell, so (w/2) x (h/2) with the Bayer
+ * pattern kept, 8 bits (value >> 2), after an 8-byte header (width, height). Read through the frame's one permanent
+ * mapping (notefe_physmap). sysctl kern.notefe_cam_pic (root) hands it out; the bot writes it to the drop zone.
+ */
+static uint8_t *nc_pic;
+static uint32_t nc_pic_len;
+static vm_offset_t nc_frame;            /* NC_BUF, a whole full-size frame, mapped once */
+
+static void
+nc_make_picture(void)
+{
+	uint32_t pw = nc_w / 2, ph = nc_h / 2;
+	if (!nc_pic) {
+		nc_pic = kalloc_data(8 + (NC_FULL_W / 2) * (NC_FULL_H / 2), Z_WAITOK);
+	}
+	if (!nc_pic || !nc_frame) {
+		printf("NOTEFE CAM: picture: no buffer\n");
+		return;
+	}
+	((uint32_t *)nc_pic)[0] = pw;
+	((uint32_t *)nc_pic)[1] = ph;
+	const uint32_t row = nc_w * 2;
+	for (uint32_t y = 0; y < nc_h; y++) {
+		if ((y & 3) >= 2) {
+			continue;                       /* rows 0,1 of every 4: one 2x2 cell row in two */
+		}
+		volatile uint16_t *src = (volatile uint16_t *)(nc_frame + y * row);
+		uint8_t *dst = nc_pic + 8 + ((y >> 2) * 2 + (y & 1)) * pw;
+		for (uint32_t x = 0; x + 1 < nc_w; x += 4) {
+			dst[x / 2] = (uint8_t)((src[x] & 0x3ff) >> 2);
+			dst[x / 2 + 1] = (uint8_t)((src[x + 1] & 0x3ff) >> 2);
+		}
+	}
+	nc_pic_len = 8 + pw * ph;
+	printf("NOTEFE CAM: picture: %u x %u Bayer, 8 bits: ready (kern.notefe_cam_pic)\n", pw, ph);
+}
+
+static int
+notefe_cam_pic_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (!nc_pic || !nc_pic_len) {
+		return ENOENT;
+	}
+	return SYSCTL_OUT(req, nc_pic, nc_pic_len);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, notefe_cam_pic, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, notefe_cam_pic_sysctl, "S", "Note FE: the front camera's last frame, binned Bayer 8-bit, 8-byte header");
+
+static void
+notefe_cam_frame(vm_offset_t pins)
+{
+	static vm_offset_t top, csis, phy, pmu, mmu, cam1;
+	if (!top) {
+		top = ml_io_map(0x10570000u, 0x1000);
+		csis = ml_io_map(0x14100000u, 0x2000);
+		phy = ml_io_map(0x145f1000u, 0x1000);
+		pmu = ml_io_map(0x105c0000u, 0x1000);
+		mmu = ml_io_map(0x141e0000u, 0x1000);
+		cam1 = ml_io_map(0x145d0000u, 0x1000);
+		nc_frame = notefe_physmap(NC_BUF, NC_MAP_LEN);
+	}
+	if (!top || !csis || !phy || !pmu || !mmu || !cam1 || !nc_frame) {
+		printf("NOTEFE CAM: frame: map failed\n");
+		return;
+	}
+	nc_pins = pins;
+	NC_BANK = 0x140; NC_SDA = 2; NC_SCL = 3;
+	uint32_t mode = nc_o_mode;
+	PE_parse_boot_argn("notefe_cam_mode", &mode, sizeof(mode));
+	nc_w = mode == 1 ? 1304 : mode == 2 ? 1280 : NC_FULL_W;
+	nc_h = mode == 1 ? 980 : mode == 2 ? 720 : NC_FULL_H;
+	const uint32_t fbytes = nc_w * nc_h * 2;
+	for (uint32_t o = 0; o < NC_FULL_W * NC_FULL_H * 2; o += 4) {
+		*(volatile uint32_t *)(nc_frame + o) = 0xa5a5a5a5u;
+	}
+	/* power, as stage 3 */
+	uint8_t l5 = 0, l6 = 0, l7 = 0, l13 = 0;
+	if (!nc_read(0x59, 0x22, &l5, 1) || !nc_read(0x59, 0x23, &l6, 1) || !nc_read(0x59, 0x24, &l7, 1) ||
+	    !nc_read(0x59, 0x2a, &l13, 1)) {
+		printf("NOTEFE CAM: frame: the S2MPB02 does not answer\n");
+		return;
+	}
+	nc_pin(pins, 0x120, 1, 1, -1, 0);
+	nc_pin(pins, 0x100, 4, 1, -1, 0);
+	nc_line(NC_SDA, 1);
+	nc_line(NC_SCL, 1);
+	nc_pmic_write(0x2a, 0x80 | 0x5c);
+	nc_pmic_write(0x23, 0x80 | 0x30);
+	nc_pmic_write(0x22, 0x80 | 0x30);
+	nc_pmic_write(0x24, 0x80 | 0x30);
+	delay(1000);
+	nc_pin(pins, 0x100, 4, 1, -1, 1);
+	delay(40);
+	uint32_t div = notefe_rd(top, 0xb24), mux = notefe_rd(top, 0xb20);
+	notefe_wr(top, 0xb20, mux & ~(7u << 12));
+	delay(100);
+	notefe_wr(top, 0xb24, div & ~0xffu);
+	nc_pin(pins, 0x180, 2, 2, -1, -1);
+	delay(10000);
+	uint16_t id = nc_sensor_rd16(0x0000);
+	uint32_t mmu_ctrl = notefe_rd(mmu, 0), iso = notefe_rd(pmu, 0x714), phyc = notefe_rd(phy, 0x50);
+	unsigned bad = 0;
+	if (id != 0x4e60) {
+		printf("NOTEFE CAM: frame: model ID %#x, not the 4E6: stopped\n", id);
+		goto power_down;
+	}
+	/* the sensor's mode */
+	nc_sensor_write(0x35, 0x0100, 0, 8);
+	/* 0446: the table's PLL (0x0306 = 180, /6 at 0x0304) assumes a 24 MHz MCLK; ours is 26 MHz (OSCCLK only): 166 keeps
+	 * the lane rate (26 / 6 x 166 = 719 MHz, 24 / 6 x 180 = 720). cam-5 at 180: ECC, ID, lost FS/FE errors. */
+	uint32_t pll = nc_o_pll, settle = nc_o_settle;
+	PE_parse_boot_argn("notefe_cam_pll", &pll, sizeof(pll));
+	PE_parse_boot_argn("notefe_cam_settle", &settle, sizeof(settle));
+	for (unsigned i = 0; i < sizeof(nc_4e6_mode) / sizeof(nc_4e6_mode[0]); i++) {
+		uint16_t v = nc_4e6_mode[i].reg == 0x0306 ? (uint16_t)pll : nc_4e6_mode[i].val;
+		bad += !nc_sensor_write(0x35, nc_4e6_mode[i].reg, v, nc_4e6_mode[i].bits);
+	}
+	if (mode == 1) {        /* SMIA 2x2 binning (0x0900 enable, 0x0901 type 0x22), output 1304 x 980 */
+		bad += !nc_sensor_write(0x35, 0x0900, 0x01, 8);
+		bad += !nc_sensor_write(0x35, 0x0901, 0x22, 8);
+		bad += !nc_sensor_write(0x35, 0x034c, 1304, 16);
+		bad += !nc_sensor_write(0x35, 0x034e, 980, 16);
+	} else if (mode == 2) { /* SMIA crop: x 664-1943, y 620-1339, output 1280 x 720 */
+		bad += !nc_sensor_write(0x35, 0x0344, 664, 16);
+		bad += !nc_sensor_write(0x35, 0x0346, 620, 16);
+		bad += !nc_sensor_write(0x35, 0x0348, 1943, 16);
+		bad += !nc_sensor_write(0x35, 0x034a, 1339, 16);
+		bad += !nc_sensor_write(0x35, 0x034c, 1280, 16);
+		bad += !nc_sensor_write(0x35, 0x034e, 720, 16);
+	}
+	printf("NOTEFE CAM: frame: mode %u (%u x %u, %u bytes a frame)\n", mode, nc_w, nc_h, fbytes);
+	printf("NOTEFE CAM: frame: settle %u; sensor mode written (%u writes, %u not acknowledged); read back: output %u x %u, "
+	    "line %u, frame %u lines, PLL %u/%u\n", settle, (unsigned)(sizeof(nc_4e6_mode) / sizeof(nc_4e6_mode[0])), bad, nc_sensor_rd16(0x034c),
+	    nc_sensor_rd16(0x034e), nc_sensor_rd16(0x0342), nc_sensor_rd16(0x0340), nc_sensor_rd16(0x0306), nc_sensor_rd16(0x0304));
+	/* the receiver */
+	notefe_wr(mmu, 0, 0);
+	notefe_wr(pmu, 0x714, iso | 1);
+	notefe_wr(phy, 0x50, phyc & ~2u);
+	notefe_wr(phy, 0x50, phyc | 2u);
+	/* 0449 (the advisor, from cam-4's rxbyte0 0x200000): CSIS2's four lane byte clocks were muxed to OSCCLK (select 0);
+	 * select 1 is the PHY's RXBYTECLKHSn (Linux's cam1_phyN_csis2), gates 0x850-0x85c bit 0 */
+	uint32_t rx_mux[4], rx_gate[4];
+	for (unsigned n = 0; n < 4; n++) {
+		rx_mux[n] = notefe_rd(cam1, 0x22c + 4 * n);
+		rx_gate[n] = notefe_rd(cam1, 0x850 + 4 * n);
+		notefe_wr(cam1, 0x22c + 4 * n, rx_mux[n] | (1u << 12));
+		notefe_wr(cam1, 0x850 + 4 * n, rx_gate[n] | 1u);
+	}
+	printf("NOTEFE CAM: frame: lane byte clocks: mux %#x %#x %#x %#x -> %#x %#x %#x %#x (status %#x), gates %#x %#x %#x %#x\n",
+	    rx_mux[0], rx_mux[1], rx_mux[2], rx_mux[3], notefe_rd(cam1, 0x22c), notefe_rd(cam1, 0x230), notefe_rd(cam1, 0x234),
+	    notefe_rd(cam1, 0x238), notefe_rd(cam1, 0x62c), notefe_rd(cam1, 0x850), notefe_rd(cam1, 0x854), notefe_rd(cam1, 0x858),
+	    notefe_rd(cam1, 0x85c));
+	nc_csis_setup(csis, settle);
+	printf("NOTEFE CAM: frame: CSIS2 set: CMN %#x DPHY_CMN %#x CH0 %#x/%#x DMA0 ctrl %#x fmt %#x addr %#x; PHY %#x iso %#x; "
+	    "SysMMU ctrl %#x (was %#x)\n", notefe_rd(csis, 0x4), notefe_rd(csis, 0x24), notefe_rd(csis, 0x40), notefe_rd(csis, 0x44),
+	    notefe_rd(csis, 0x1000), notefe_rd(csis, 0x1004), notefe_rd(csis, 0x1010), notefe_rd(phy, 0x50),
+	    notefe_rd(pmu, 0x714), notefe_rd(mmu, 0), mmu_ctrl);
+	/* 0454: notefe_cam_tp=N: the sensor's test pattern (SMIA 0x0600: 1 solid colour, 2 colour bars, 3 fade, 4 PN9),
+	 * a check of layout, row order and Bayer order with no light needed; AE is skipped then */
+	uint32_t tp = nc_o_tp;
+	PE_parse_boot_argn("notefe_cam_tp", &tp, sizeof(tp));
+	if (tp) {
+		nc_sensor_write(0x35, 0x0600, (uint16_t)tp, 16);
+		printf("NOTEFE CAM: frame: test pattern %u (0x0600 reads %#x)\n", tp, nc_sensor_rd16(0x0600));
+	}
+	/* stream */
+	nc_sensor_write(0x35, 0x0100, 1, 8);
+	if (notefe_cam_last == 6) {
+		/* 0447: settle sweep, the sensor streaming throughout: 300 ms a value (about 9 of its frames) */
+		static const uint8_t settles[] = { 4, 8, 12, 16, 20, 22, 24, 28, 32, 40 };
+		uint32_t best = settle, best_err = 0xffffffffu;
+		for (unsigned i = 0; i < sizeof(settles); i++) {
+			/* 0448: the sensor off around each setup, so the lanes go LP -> HS again (cam-6: a reset mid-stream left
+			 * the receiver with nothing) */
+			nc_sensor_write(0x35, 0x0100, 0, 8);
+			delay(60000);
+			nc_csis_setup(csis, settles[i]);
+			nc_sensor_write(0x35, 0x0100, 1, 8);
+			delay(300000);
+			uint32_t s0 = notefe_rd(csis, 0x14), s1 = notefe_rd(csis, 0x1c), fr = notefe_rd(csis, 0x100);
+			uint32_t errs = ((s0 >> 12) & 1) + ((s0 >> 8) & 1) + ((s0 >> 2) & 1) + ((s0 >> 1) & 1) + (s0 & 1) + ((s0 >> 16) & 1);
+			printf("NOTEFE CAM: sweep settle %u: frames %u, INT_SRC0 %#x (errors %u), INT_SRC1 %#x, DMA bytes %u, DPHY %#x\n",
+			    settles[i], fr, s0, errs, s1, notefe_rd(csis, 0x1040), notefe_rd(csis, 0x20));
+			if (errs < best_err || (errs == best_err && fr >= 5 && fr <= 15)) {
+				best_err = errs;
+				best = settles[i];
+			}
+		}
+		printf("NOTEFE CAM: sweep: best settle %u (%u error kinds)\n", best, best_err);
+		settle = best;
+		nc_sensor_write(0x35, 0x0100, 0, 8);
+		delay(60000);
+		for (uint32_t o = 0; o < fbytes; o += 4) {
+			*(volatile uint32_t *)(nc_frame + o) = 0xa5a5a5a5u;
+		}
+		nc_csis_setup(csis, settle);
+		nc_sensor_write(0x35, 0x0100, 1, 8);
+	}
+	delay(100000);
+	nc_csis_report(csis, mmu, "after 100 ms");
+	delay(400000);
+	nc_csis_report(csis, mmu, "after 500 ms");
+	delay(1000000);
+	nc_csis_report(csis, mmu, "after 1.5 s");
+	/* 0450: a crude auto-exposure on the +6 MB window (the frame's middle rows; the DMA rewrites the same buffer every
+	 * frame): the mean above black (64) aimed at 18 % of 959; exposure 0x0202 (lines, up to frame - 4 = 2036) first,
+	 * then analogue gain 0x0204 (0x20 = 1x .. 0x200 = 16x), under the grouped hold 0x0104. Six steps, 200 ms each. */
+	uint32_t exp_l = 0x3fc, gain = 0x20, skip = nc_o_skip;
+	PE_parse_boot_argn("notefe_cam_skip", &skip, sizeof(skip));        /* 0452: 1 no AE, 2 no picture (bisecting) */
+	if (tp) {
+		skip |= 1;
+	}
+	printf("NOTEFE CAM: frame: AE %s, picture %s\n", skip & 1 ? "skipped" : "on", skip & 2 ? "skipped" : "on");
+	for (unsigned step = 0; step < ((skip & 1) ? 0u : 6u); step++) {
+		uint64_t sum = 0;
+		volatile uint16_t *px = (volatile uint16_t *)(nc_frame + (nc_h / 2) * nc_w * 2);
+		for (uint32_t i = 0; i < 0x20000; i += 8) {
+			sum += px[i] & 0x3ff;
+		}
+		uint32_t mean = (uint32_t)(sum / (0x20000 / 8)), above = mean > 64 ? mean - 64 : 0;
+		uint32_t want = 172;
+		printf("NOTEFE CAM: ae step %u: mean %u (above black %u), exposure %u lines, gain %#x\n", step, mean, above, exp_l, gain);
+		if (above > want * 8 / 10 && above < want * 12 / 10) {
+			break;
+		}
+		uint32_t f = above ? (want * 256) / above : 256 * 16;       /* x256 */
+		uint64_t total = (uint64_t)exp_l * gain * f / 256;
+		exp_l = (uint32_t)MIN(MAX(total / gain, 4), 2036);
+		gain = (uint32_t)MIN(MAX(total / exp_l, 0x20), 0x200);
+		nc_sensor_write(0x35, 0x0104, 1, 8);
+		nc_sensor_write(0x35, 0x0202, (uint16_t)exp_l, 16);
+		nc_sensor_write(0x35, 0x0204, (uint16_t)gain, 16);
+		nc_sensor_write(0x35, 0x0104, 0, 8);
+		delay(200000);
+	}
+	nc_sensor_write(0x35, 0x0100, 0, 8);
+	delay(50000);
+	if (!(skip & 2)) {
+		nc_make_picture();
+	}
+	if (tp) {
+		nc_sensor_write(0x35, 0x0600, 0, 16);
+	}
+	/* receiver down, as found */
+	notefe_wr(csis, 0x1000, notefe_rd(csis, 0x1000) | 1u);
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) & ~1u);
+	notefe_wr(csis, 0x24, notefe_rd(csis, 0x24) & ~1u);
+	notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | 2u);
+	delay(100);
+	for (unsigned n = 0; n < 4; n++) {
+		notefe_wr(cam1, 0x22c + 4 * n, rx_mux[n]);
+		notefe_wr(cam1, 0x850 + 4 * n, rx_gate[n]);
+	}
+	notefe_wr(phy, 0x50, phyc & ~2u);
+	notefe_wr(phy, 0x50, phyc);
+	notefe_wr(pmu, 0x714, iso);
+	notefe_wr(mmu, 0, mmu_ctrl);
+	{
+		uint32_t changed = 0, last = 0;
+		for (uint32_t o = 0; o < NC_FULL_W * NC_FULL_H * 2; o += 4) {
+			if (*(volatile uint32_t *)(nc_frame + o) != 0xa5a5a5a5u) {
+				changed++;
+				last = o;
+			}
+		}
+		volatile uint32_t *w = (volatile uint32_t *)nc_frame;
+		printf("NOTEFE CAM: frame: buffer: %u words changed (a frame is %u), the last at +%#x (a frame ends at +%#x); "
+		    "first %08x %08x %08x %08x\n", changed, fbytes / 4, last, fbytes - 4, w[0], w[1], w[2], w[3]);
+	}
+power_down:
+	nc_pin(pins, 0x180, 2, 0, -1, -1);
+	notefe_wr(top, 0xb24, div);
+	notefe_wr(top, 0xb20, mux);
+	nc_pin(pins, 0x100, 4, 1, -1, 0);
+	nc_pin(pins, 0x120, 1, 1, -1, 0);
+	nc_pmic_write(0x24, l7 & 0x7f);
+	nc_pmic_write(0x22, l5 & 0x7f);
+	delay(2000);
+	nc_pmic_write(0x2a, l13 & 0x7f);
+	delay(2000);
+	nc_pmic_write(0x23, l6 & 0x7f);
+	nc_pin(pins, 0x140, NC_SDA, 0, -1, -1);
+	nc_pin(pins, 0x140, NC_SCL, 0, -1, -1);
+	printf("NOTEFE CAM: frame: powered down, receiver and SysMMU as found (ctrl %#x)\n", notefe_rd(mmu, 0));
+}
+
+/*
+ * Note FE (0456): /dev/hakios-camera, the S9 ports' protocol (danstronics/ios-s9plus-exynos bsd/sys/hakios.camera.h,
+ * APSL), for the front camera: made by `sysctl kern.notefe_cam=7` (root). The first open powers the sensor in the
+ * binned mode (1304 x 980, ~30 a second; nc_o_tp gives the test pattern), DMA0's eight frame pointers over a ring of
+ * four 2.5 MB slots from 0xd0800000; the last close puts everything down as found. read() waits (at most a second) for
+ * CSIS2's frame counter to move, then hands the frame just finished (the pointer before DMA0's active one) as a struct
+ * hakios_camera_frame and MIPI RAW10 (four pixels in five bytes, packed here from the DMA's 16 bits a pixel), GRBG,
+ * black 64. Exposure: every third frame the middle's mean is aimed at 18 % (as stage 5), unless a write() of
+ * HAKIOS_CAMERA_EXPOSURE set it in the last two seconds. Other commands are read and ignored (one camera, no motor).
+ */
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#define NC_SLOT         0x280000u
+#define NC_SW           1304u
+#define NC_SH           980u
+#define NC_STRIDE       (NC_SW * 5 / 4)
+struct nc_cam_frame {
+	char magic[8];
+	uint32_t header_bytes, width, height, stride, format, bayer, black;
+	uint64_t sequence, time;
+	uint32_t exposure_lines, line_ns, gain, gain_unity, gain_max, frame_lines, frame_lines_min, frame_lines_max, margin;
+	uint32_t sensor, focus, reserved[5];
+};
+struct nc_cam_cmd {
+	uint32_t command, bytes, a, b, c, d;
+};
+static int nc_opens;
+static bool nc_streaming;
+static uint32_t nc_last_frm, nc_exp = 1020, nc_gain = 0x20, nc_reads, nc_torn;
+static uint16_t *nc_copy;               /* 0457: the finished slot copied out at once (reading the uncached ring pixel by pixel
+                                         * took 0.3-0.45 s, and the ring wraps every ~133 ms) */
+static uint64_t nc_seq, nc_user_exp_until;
+static uint32_t nc_sensor_id = 2;       /* 0463: the number the frames carry: whatever HAKIOS_CAMERA_SENSOR asked for (one camera
+                                         * here, so the back and the front streams both get its frames, as on the S9) */
+static struct {
+	vm_offset_t top, csis, phy, pmu, mmu, cam1, pins;
+	uint8_t l5, l6, l7, l13;
+	uint32_t div, mux, mmu_ctrl, iso, phyc, rx_mux[4], rx_gate[4];
+} nc_s;
+
+static bool
+nc_stream_maps(void)
+{
+	if (!nc_s.top) {
+		nc_s.top = ml_io_map(0x10570000u, 0x1000);
+		nc_s.csis = ml_io_map(0x14100000u, 0x2000);
+		nc_s.phy = ml_io_map(0x145f1000u, 0x1000);
+		nc_s.pmu = ml_io_map(0x105c0000u, 0x1000);
+		nc_s.mmu = ml_io_map(0x141e0000u, 0x1000);
+		nc_s.cam1 = ml_io_map(0x145d0000u, 0x1000);
+		nc_s.pins = ml_io_map(0x136d0000u, 0x1000);
+	}
+	if (!nc_i2c) {
+		nc_i2c = ml_io_map(0x13680000u, 0x1000);
+	}
+	if (!nc_frame) {
+		nc_frame = notefe_physmap(NC_BUF, NC_MAP_LEN);
+	}
+	return nc_s.top && nc_s.csis && nc_s.phy && nc_s.pmu && nc_s.mmu && nc_s.cam1 && nc_s.pins && nc_i2c && nc_frame;
+}
+
+static void
+nc_set_exposure(uint32_t lines, uint32_t gain)
+{
+	nc_exp = MIN(MAX(lines, 4), 2036);
+	nc_gain = MIN(MAX(gain, 0x20), 0x200);
+	nc_sensor_write(0x35, 0x0104, 1, 8);
+	nc_sensor_write(0x35, 0x0202, (uint16_t)nc_exp, 16);
+	nc_sensor_write(0x35, 0x0204, (uint16_t)nc_gain, 16);
+	nc_sensor_write(0x35, 0x0104, 0, 8);
+}
+
+static void nc_stream_down(void);
+
+static int
+nc_stream_up(void)
+{
+	if (!nc_stream_maps()) {
+		printf("NOTEFE CAM: stream: map failed\n");
+		return ENXIO;
+	}
+	vm_offset_t pins = nc_s.pins;
+	nc_pins = pins;
+	NC_BANK = 0x140; NC_SDA = 2; NC_SCL = 3;
+	uint32_t con = notefe_rd(pins, 0x40);
+	if (((con >> 16) & 0xf) != 2 || ((con >> 20) & 0xf) != 2) {
+		nc_pin(pins, 0x40, 4, 2, -1, -1);
+		nc_pin(pins, 0x40, 5, 2, -1, -1);
+	}
+	nc_bus_init();
+	if (!nc_read(0x59, 0x22, &nc_s.l5, 1) || !nc_read(0x59, 0x23, &nc_s.l6, 1) || !nc_read(0x59, 0x24, &nc_s.l7, 1) ||
+	    !nc_read(0x59, 0x2a, &nc_s.l13, 1)) {
+		printf("NOTEFE CAM: stream: the S2MPB02 does not answer\n");
+		return EIO;
+	}
+	nc_pin(pins, 0x120, 1, 1, -1, 0);
+	nc_pin(pins, 0x100, 4, 1, -1, 0);
+	nc_line(NC_SDA, 1);
+	nc_line(NC_SCL, 1);
+	nc_pmic_write(0x2a, 0x80 | 0x5c);
+	nc_pmic_write(0x23, 0x80 | 0x30);
+	nc_pmic_write(0x22, 0x80 | 0x30);
+	nc_pmic_write(0x24, 0x80 | 0x30);
+	delay(1000);
+	nc_pin(pins, 0x100, 4, 1, -1, 1);
+	delay(40);
+	nc_s.div = notefe_rd(nc_s.top, 0xb24);
+	nc_s.mux = notefe_rd(nc_s.top, 0xb20);
+	notefe_wr(nc_s.top, 0xb20, nc_s.mux & ~(7u << 12));
+	delay(100);
+	notefe_wr(nc_s.top, 0xb24, nc_s.div & ~0xffu);
+	nc_pin(pins, 0x180, 2, 2, -1, -1);
+	delay(10000);
+	nc_streaming = true;            /* from here nc_stream_down() undoes everything */
+	uint16_t id = nc_sensor_rd16(0x0000);
+	if (id != 0x4e60) {
+		printf("NOTEFE CAM: stream: model ID %#x, not the 4E6\n", id);
+		nc_stream_down();
+		return EIO;
+	}
+	nc_sensor_write(0x35, 0x0100, 0, 8);
+	unsigned bad = 0;
+	for (unsigned i = 0; i < sizeof(nc_4e6_mode) / sizeof(nc_4e6_mode[0]); i++) {
+		uint16_t v = nc_4e6_mode[i].reg == 0x0306 ? (uint16_t)nc_o_pll : nc_4e6_mode[i].val;
+		bad += !nc_sensor_write(0x35, nc_4e6_mode[i].reg, v, nc_4e6_mode[i].bits);
+	}
+	bad += !nc_sensor_write(0x35, 0x0900, 0x01, 8);
+	bad += !nc_sensor_write(0x35, 0x0901, 0x22, 8);
+	bad += !nc_sensor_write(0x35, 0x034c, NC_SW, 16);
+	bad += !nc_sensor_write(0x35, 0x034e, NC_SH, 16);
+	if (nc_o_tp) {
+		nc_sensor_write(0x35, 0x0600, (uint16_t)nc_o_tp, 16);
+	}
+	nc_set_exposure(nc_exp, nc_gain);
+	nc_w = NC_SW;
+	nc_h = NC_SH;
+	nc_s.mmu_ctrl = notefe_rd(nc_s.mmu, 0);
+	nc_s.iso = notefe_rd(nc_s.pmu, 0x714);
+	nc_s.phyc = notefe_rd(nc_s.phy, 0x50);
+	notefe_wr(nc_s.mmu, 0, 0);
+	notefe_wr(nc_s.pmu, 0x714, nc_s.iso | 1);
+	notefe_wr(nc_s.phy, 0x50, nc_s.phyc & ~2u);
+	notefe_wr(nc_s.phy, 0x50, nc_s.phyc | 2u);
+	for (unsigned n = 0; n < 4; n++) {
+		nc_s.rx_mux[n] = notefe_rd(nc_s.cam1, 0x22c + 4 * n);
+		nc_s.rx_gate[n] = notefe_rd(nc_s.cam1, 0x850 + 4 * n);
+		notefe_wr(nc_s.cam1, 0x22c + 4 * n, nc_s.rx_mux[n] | (1u << 12));
+		notefe_wr(nc_s.cam1, 0x850 + 4 * n, nc_s.rx_gate[n] | 1u);
+	}
+	nc_csis_setup(nc_s.csis, nc_o_settle);
+	for (unsigned k = 0; k < 8; k++) {
+		notefe_wr(nc_s.csis, 0x1010 + 4 * k, NC_BUF + (k & 3) * NC_SLOT);
+	}
+	nc_last_frm = notefe_rd(nc_s.csis, 0x100);
+	nc_seq = 0;
+	nc_reads = 0;
+	nc_torn = 0;
+	nc_sensor_write(0x35, 0x0100, 1, 8);
+	printf("NOTEFE CAM: stream: up, %u x %u binned, test pattern %u, %u writes not acknowledged\n", NC_SW, NC_SH, nc_o_tp, bad);
+	return 0;
+}
+
+static void
+nc_stream_down(void)
+{
+	if (!nc_streaming) {
+		return;
+	}
+	vm_offset_t pins = nc_s.pins, csis = nc_s.csis;
+	nc_sensor_write(0x35, 0x0100, 0, 8);
+	nc_sensor_write(0x35, 0x0600, 0, 16);
+	delay(50000);
+	if (nc_s.cam1 && notefe_rd(nc_s.cam1, 0x22c) != nc_s.rx_mux[0]) {     /* the receiver was set up */
+		notefe_wr(csis, 0x1000, notefe_rd(csis, 0x1000) | 1u);
+		notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) & ~1u);
+		notefe_wr(csis, 0x24, notefe_rd(csis, 0x24) & ~1u);
+		notefe_wr(csis, 0x4, notefe_rd(csis, 0x4) | 2u);
+		delay(100);
+		for (unsigned n = 0; n < 4; n++) {
+			notefe_wr(nc_s.cam1, 0x22c + 4 * n, nc_s.rx_mux[n]);
+			notefe_wr(nc_s.cam1, 0x850 + 4 * n, nc_s.rx_gate[n]);
+		}
+		notefe_wr(nc_s.phy, 0x50, nc_s.phyc & ~2u);
+		notefe_wr(nc_s.phy, 0x50, nc_s.phyc);
+		notefe_wr(nc_s.pmu, 0x714, nc_s.iso);
+		notefe_wr(nc_s.mmu, 0, nc_s.mmu_ctrl);
+	}
+	nc_pin(pins, 0x180, 2, 0, -1, -1);
+	notefe_wr(nc_s.top, 0xb24, nc_s.div);
+	notefe_wr(nc_s.top, 0xb20, nc_s.mux);
+	nc_pin(pins, 0x100, 4, 1, -1, 0);
+	nc_pin(pins, 0x120, 1, 1, -1, 0);
+	nc_pmic_write(0x24, nc_s.l7 & 0x7f);
+	nc_pmic_write(0x22, nc_s.l5 & 0x7f);
+	delay(2000);
+	nc_pmic_write(0x2a, nc_s.l13 & 0x7f);
+	delay(2000);
+	nc_pmic_write(0x23, nc_s.l6 & 0x7f);
+	nc_pin(pins, 0x140, NC_SDA, 0, -1, -1);
+	nc_pin(pins, 0x140, NC_SCL, 0, -1, -1);
+	nc_streaming = false;
+	printf("NOTEFE CAM: stream: down after %llu frames read (%u overwritten while copied), as found (SysMMU %#x)\n", nc_seq,
+	    nc_torn, notefe_rd(nc_s.mmu, 0));
+}
+
+static int
+nc_dev_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	int error = 0;
+	if (nc_opens++ == 0) {
+		error = nc_stream_up();
+		if (error) {
+			nc_opens = 0;
+		}
+	}
+	return error;
+}
+
+static int
+nc_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (nc_opens > 0 && --nc_opens == 0) {
+		nc_stream_down();
+	}
+	return 0;
+}
+
+static int
+nc_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!nc_streaming) {
+		return EIO;
+	}
+	vm_offset_t csis = nc_s.csis;
+	uint32_t f = nc_last_frm;
+	for (unsigned i = 0; i < 500 && f == nc_last_frm; i++) {
+		ns_sleep_ms(2);
+		f = notefe_rd(csis, 0x100);
+	}
+	if (f == nc_last_frm) {
+		return ETIMEDOUT;
+	}
+	nc_last_frm = f;
+	nc_seq++;
+	uint32_t act = (notefe_rd(csis, 0x1030) >> 2) & 7, slot = ((act + 7) & 7) & 3;
+	if (!nc_copy) {
+		nc_copy = kalloc_data(NC_SW * NC_SH * 2, Z_WAITOK);
+		if (!nc_copy) {
+			return ENOMEM;
+		}
+	}
+	/*
+	 * 0467: from a cacheable mapping of the ring, after cleaning and invalidating the slot's lines (the DMA wrote it),
+	 * and packed from there: the copy out of the write-combined mapping (2.5 MB, uncached reads) and the copy itself
+	 * took most of a read's ~45 ms (cam-bin2, 13.9 fps).
+	 */
+	vm_offset_t src0;
+	if (!nc_frame_c) {
+		nc_frame_c = notefe_physmap_cached(NC_BUF, NC_MAP_LEN);
+	}
+	if (nc_frame_c) {
+		src0 = nc_frame_c + slot * NC_SLOT;
+		flush_dcache(src0, NC_SW * NC_SH * 2, 0);
+	} else {
+		bcopy((const void *)(nc_frame + slot * NC_SLOT), nc_copy, NC_SW * NC_SH * 2);
+		src0 = (vm_offset_t)nc_copy;
+	}
+	uint32_t after = notefe_rd(csis, 0x100);
+	if (after - f >= 3) {
+		nc_torn++;
+	}
+	struct nc_cam_frame h = { .magic = "RWFRAME", .header_bytes = sizeof(h), .width = NC_SW, .height = NC_SH,
+		                  .stride = NC_STRIDE, .format = 1, .bayer = 1, .black = 64, .sequence = nc_seq,
+		                  .time = mach_absolute_time(), .exposure_lines = nc_exp, .line_ns = 16340, .gain = nc_gain,
+		                  .gain_unity = 0x20, .gain_max = 0x200, .frame_lines = 2040, .frame_lines_min = 2040,
+		                  .frame_lines_max = 2040, .margin = 4, .sensor = nc_sensor_id, .focus = 0xffffffffu,
+		                  .reserved = { slot, act, f, 0, 0 } };      /* 0457: the slot read, DMA0's active pointer, FRM_CNT */
+	memcpy(h.magic, "RWFRAME1", 8);
+	int error = uiomove((caddr_t)&h, (int)MIN(sizeof(h), (size_t)uio_resid(uio)), uio);
+	static uint8_t line[NC_STRIDE];
+	for (uint32_t y = 0; !error && y < NC_SH && uio_resid(uio) > 0; y++) {
+		const uint16_t *src = (const uint16_t *)(src0 + y * NC_SW * 2);
+		for (uint32_t x = 0, o = 0; x < NC_SW; x += 4, o += 5) {
+			uint16_t a = src[x] & 0x3ff, b = src[x + 1] & 0x3ff, c = src[x + 2] & 0x3ff, d = src[x + 3] & 0x3ff;
+			line[o] = (uint8_t)(a >> 2);
+			line[o + 1] = (uint8_t)(b >> 2);
+			line[o + 2] = (uint8_t)(c >> 2);
+			line[o + 3] = (uint8_t)(d >> 2);
+			line[o + 4] = (uint8_t)((a & 3) | (b & 3) << 2 | (c & 3) << 4 | (d & 3) << 6);
+		}
+		error = uiomove((caddr_t)line, (int)MIN((size_t)NC_STRIDE, (size_t)uio_resid(uio)), uio);
+	}
+	/* exposure, every third frame, unless the reader set it lately */
+	if (!nc_o_tp && ++nc_reads % 3 == 0 && mach_absolute_time() > nc_user_exp_until) {
+		uint64_t sum = 0;
+		volatile uint16_t *px = (volatile uint16_t *)(src0 + (NC_SH / 2 - 64) * NC_SW * 2);
+		for (uint32_t i = 0; i < 128 * NC_SW; i += 16) {
+			sum += px[i] & 0x3ff;
+		}
+		uint32_t mean = (uint32_t)(sum / (128 * NC_SW / 16)), above = mean > 64 ? mean - 64 : 0, want = 172;
+		if (above < want * 8 / 10 || above > want * 12 / 10) {
+			uint32_t fct = above ? (want * 256) / above : 256 * 4;
+			fct = MIN(MAX(fct, 128), 512);                 /* half to twice a step */
+			uint64_t total = (uint64_t)nc_exp * nc_gain * fct / 256;
+			uint32_t lines = (uint32_t)MIN(MAX(total / 0x20, 4), 2036);
+			nc_set_exposure(lines, (uint32_t)(total / lines));
+		}
+	}
+	return error;
+}
+
+static int
+nc_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	while (uio_resid(uio) >= (user_ssize_t)sizeof(struct nc_cam_cmd)) {
+		struct nc_cam_cmd c;
+		int error = uiomove((caddr_t)&c, sizeof(c), uio);
+		if (error) {
+			return error;
+		}
+		if (c.command == 3) {                          /* HAKIOS_CAMERA_SENSOR: taken, the frames carry it */
+			nc_sensor_id = c.a;
+		}
+		if (c.command == 1 && nc_streaming) {           /* HAKIOS_CAMERA_EXPOSURE */
+			nc_set_exposure(c.a, c.b);
+			clock_interval_to_deadline(2, NSEC_PER_SEC, &nc_user_exp_until);
+		}
+		uint8_t skipbuf[256];
+		for (uint32_t left = c.bytes; left && uio_resid(uio) > 0;) {
+			uint32_t n = MIN(left, (uint32_t)sizeof(skipbuf));
+			error = uiomove((caddr_t)skipbuf, (int)n, uio);
+			if (error) {
+				return error;
+			}
+			left -= n;
+		}
+	}
+	return 0;
+}
+
+static const struct cdevsw nc_cdevsw = {
+	.d_open = nc_dev_open, .d_close = nc_dev_close, .d_read = nc_dev_read, .d_write = nc_dev_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+nc_dev_make(void)
+{
+	static bool made;
+	if (made) {
+		return;
+	}
+	int major = cdevsw_add(-1, &nc_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-camera") == NULL) {
+		printf("NOTEFE CAM: no /dev/hakios-camera\n");
+		return;
+	}
+	made = true;
+	printf("NOTEFE CAM: /dev/hakios-camera made (major %d)\n", major);
+}
+
+static int
+notefe_cam_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = notefe_cam_last;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (value < 1 || value > 7) {
+		return EINVAL;
+	}
+	notefe_cam_last = value;
+	notefe_cam_probe(value);
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, notefe_cam, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, notefe_cam_sysctl, "I", "Note FE: camera (1 read only, 2 + the S2MPB02 PMIC read, 3 + front sensor ID, 4 CSIS2 look, 5 one frame, 6 + settle sweep, 7 /dev/hakios-camera)");
+
+SYSCTL_PROC(_kern, OID_AUTO, notefe_brightness, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, notefe_brightness_sysctl, "I", "Note FE: panel brightness 0-255");
+
+SYSCTL_PROC(_kern, OID_AUTO, notefe_hid, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, notefe_hid_sysctl, "A", "Note FE: synthetic touches and keys (boot-arg herobot=1)");
