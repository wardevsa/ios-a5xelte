+/*
+ * Note FE 0409: boot-arg herobot=1 makes sysctl kern.notefe_hid writable by root: "t FINGER DOWN X Y" (panel pixels,
+ * 1440x2560; DOWN 1 again is a move, 0 lifts) and "k KEY DOWN" (0 power, 1 volume up, 2 volume down, 3 home) go to the
+ * same HID services as the real touch screen and keys (sweet_hid_touch / sweet_hid_key). notefe/bot (the drop zone's
+ * test program) uses it to open apps, swipe and scroll unattended, so a boot can be measured without anyone holding it.
+ */
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_hid_key(int key, int down);
+
+static int
+notefe_parse_int(const char **p, int *out)
+{
+	const char *s = *p;
+	while (*s == ' ') {
+		s++;
+	}
+	int sign = 1, v = 0, digits = 0;
+	if (*s == '-') {
+		sign = -1;
+		s++;
+	}
+	while (*s >= '0' && *s <= '9') {
+		v = v * 10 + (*s++ - '0');
+		digits++;
+	}
+	*p = s;
+	*out = v * sign;
+	return digits > 0;
+}
+
+static int
+notefe_hid_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static int enabled = -1;
+	if (enabled < 0) {
+		enabled = 0;
+		PE_parse_boot_argn("herobot", &enabled, sizeof(enabled));
+	}
+	char cmd[64] = "";
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, enabled ? "on" : "off", enabled ? 3 : 4);
+	}
+	if (!enabled || !kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	size_t len = MIN(req->newlen, sizeof(cmd) - 1);
+	int error = SYSCTL_IN(req, cmd, len);
+	if (error) {
+		return error;
+	}
+	cmd[len] = '\0';
+	const char *p = cmd + 1;
+	int a, b, c, d;
+	if (cmd[0] == 't' && notefe_parse_int(&p, &a) && notefe_parse_int(&p, &b) && notefe_parse_int(&p, &c) &&
+	    notefe_parse_int(&p, &d) && a >= 0 && a < 10 && c >= 0 && c < 1440 && d >= 0 && d < 2560) {
+		sweet_hid_touch(a, b, c, d);
+		return 0;
+	}
+	if (cmd[0] == 'k' && notefe_parse_int(&p, &a) && notefe_parse_int(&p, &b) && a >= 0 && a <= 3) {
+		sweet_hid_key(a, b);
+		return 0;
+	}
+	if (cmd[0] == 'r' && notefe_parse_int(&p, &a) && a >= 0 && a <= 600) {
+		extern void herolte_twrp_soon(unsigned seconds);   /* Note FE 0416: back to TWRP when the bot is done */
+		herolte_twrp_soon((unsigned)a);
+		return 0;
+	}
+	return EINVAL;
+}
+
+/*
+ * Note FE (0419): kern.notefe_brightness, 0-255 (12 at least). SpringBoard's bridge (notefe/herosb) writes iOS's
+ * brightness here, as Scion's brightness_bridge does on the Galaxy S9; read it back with sysctl.
+ */
+extern void notefe_brightness_set(uint32_t level, const char *why);
+extern uint32_t notefe_brightness_get(void);
+
+static int
+notefe_brightness_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = (int)notefe_brightness_get();
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (value < 0 || value > 255) {
+		return EINVAL;
+	}
+	notefe_brightness_set((uint32_t)value, "sysctl");
+	return 0;
+}
+
+/*
+ * Note FE (0432): Bluetooth step 1, read only. The BCM4359's Bluetooth half sits on UART1 (0x14c20000, "btdefault"
+ * pins gpe0-0..3 function 2, IRQ SPI 0x1b0) with BT_REG_ON on gpj1-7 (PERIC1 pins 0x14cc0000, bank +0x60), BT_WAKE on
+ * gpi2-3 (0x10e60000 +0x20) and HOST_WAKE on gpa2-3 (ALIVE 0x10580000 +0x40), from the phone's own DTB (bluetooth node,
+ * compatible broadcom,bcm4359). Bank stride 0x20 as 0211/heroaudio's GPE6 0x40 / GPE2 0xa0. Clocks (Samsung's pwrcal for
+ * the 8890): CMU_TOP 0x10570000 mux 0x354 / div 0x4b4 / enable 0x960 of SCLK_PERIC1_UART1; CMU_PERIC1 0x14c80000 mux
+ * 0x224 (SCLK_UART1_USER), CG_CTRL_VAL 0x800 bit 13 (PCLK_UART1) and 0x860 bit 0 (SCLK_UART1), manual 0x1800/0x1860,
+ * Q-state 0x2424. `sysctl kern.notefe_bt=1` (root) logs the clocks and pins; =2 also the UART's registers, but only
+ * when both of its clocks read as on (a gated block can stop the bus). Nothing is written. Klog `NOTEFE BT:`.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+static int notefe_bt_last;
+
+static uint32_t
+notefe_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+notefe_bt_bank(const char *name, vm_offset_t base, uint32_t off, unsigned pin)
+{
+	uint32_t con = notefe_rd(base, off), dat = notefe_rd(base, off + 4), pud = notefe_rd(base, off + 8);
+	printf("NOTEFE BT: %s con %#x dat %#x pud %#x drv %#x conpdn %#x pudpdn %#x; pin %u: func %u level %u pull %u\n",
+	    name, con, dat, pud, notefe_rd(base, off + 0xc), notefe_rd(base, off + 0x10), notefe_rd(base, off + 0x14), pin,
+	    (con >> (4 * pin)) & 0xf, (dat >> pin) & 1, (pud >> (4 * pin)) & 0xf);
+}
+
+/*
+ * Note FE (0433): Bluetooth steps 2 and 3, on `sysctl kern.notefe_bt=3..5` (root). The writes are UART1's own registers,
+ * the four UART pins and the chip's BT_WAKE / BT_REG_ON pins (read-modify-write of the one pin's fields each).
+ *   3  UART1 up: its clock rate worked out from BUS0_PLL (PLL_CON0 M/P/S from the 26 MHz crystal, the TOP muxes, the
+ *      UART1 divider), gpe0-0..3 to function 2 with pull-up (the DTB's "btdefault"), 115200 8N1 by polling (UBRDIV
+ *      div/16-1, UFRACVAL div&15, Samsung's samsung.c), every interrupt masked, and 16 bytes through the UART's own
+ *      loopback (UCON bit 5): no chip involved
+ *   4  ... the chip powered as Samsung's bcm43xx.c does: BT_WAKE (gpi2-3) output high, BT_REG_ON (gpj1-7) output low,
+ *      10 ms, high, 100 ms, then RTS/CTS flow control on (UMCON bit 4); what it sends by itself is logged
+ *   5  ... HCI over H4 at 115200: HCI_Reset, Read Local Version (Broadcom is manufacturer 0x000f), Read Local Name: the
+ *      chip's ROM answering. No firmware is sent yet.
+ * kern.notefe_bt=6 powers the chip off again (BT_REG_ON low).
+ */
+static uint64_t
+notefe_bt_rate(vm_offset_t top)
+{
+	uint32_t con0 = notefe_rd(top, 0x100), m = (con0 >> 16) & 0x3ff, pdiv = (con0 >> 8) & 0x3f, sdiv = con0 & 7;
+	uint64_t pll = pdiv ? 26000000ull * m / ((uint64_t)pdiv << sdiv) : 0;
+	uint64_t r = (notefe_rd(top, 0x200) >> 12) & 1 ? pll : 26000000ull;          /* TOP_MUX_BUS0_PLL: OSC or the PLL */
+	if ((notefe_rd(top, 0x220) >> 12) & 1) {                                     /* TOP_MUX_SCLK_BUS0_PLL: /2 */
+		r /= 2;
+	}
+	uint32_t sel = (notefe_rd(top, 0x354) >> 12) & 3;                            /* 0 BUS0, 1 BUS1, 2-3 OSC */
+	if (sel >= 2) {
+		r = 26000000ull;
+	} else if (sel == 1) {
+		r = 0;                                                               /* BUS1: not worked out here */
+	}
+	r /= (notefe_rd(top, 0x4b4) & 0xf) + 1;
+	printf("NOTEFE BT: BUS0_PLL con0 %#x (M %u P %u S %u) = %llu Hz; mux %#x sclk mux %#x uart1 sel %u -> %llu Hz\n",
+	    con0, m, pdiv, sdiv, pll, notefe_rd(top, 0x200), notefe_rd(top, 0x220), sel, r);
+	return r;
+}
+
+static void
+notefe_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+notefe_pin(vm_offset_t base, uint32_t bank, unsigned pin, int func, int pud, int level)
+{
+	if (level >= 0) {
+		uint32_t dat = notefe_rd(base, bank + 4);
+		notefe_wr(base, bank + 4, level ? (dat | (1u << pin)) : (dat & ~(1u << pin)));
+	}
+	if (pud >= 0) {
+		uint32_t v = notefe_rd(base, bank + 8);
+		notefe_wr(base, bank + 8, (v & ~(0xfu << (4 * pin))) | ((uint32_t)pud << (4 * pin)));
+	}
+	if (func >= 0) {
+		uint32_t v = notefe_rd(base, bank);
+		notefe_wr(base, bank, (v & ~(0xfu << (4 * pin))) | ((uint32_t)func << (4 * pin)));
+	}
+}
+
+static unsigned
+notefe_uart_read(vm_offset_t uart, uint8_t *buf, unsigned max, unsigned wait_us, unsigned want)
+{
+	unsigned n = 0;
+	for (unsigned t = 0; t < wait_us && n < max; ) {
+		uint32_t st = notefe_rd(uart, 0x18);
+		if ((st & 0xff) || (st & (1u << 8))) {
+			buf[n++] = (uint8_t)notefe_rd(uart, 0x24);
+			if (want && n >= want) {
+				break;
+			}
+			continue;
+		}
+		delay(20);
+		t += 20;
+	}
+	return n;
+}
+
+static bool
+notefe_uart_write(vm_offset_t uart, const uint8_t *buf, unsigned n)
+{
+	for (unsigned i = 0; i < n; i++) {
+		unsigned t = 0;
+		while (notefe_rd(uart, 0x18) & (1u << 24)) {
+			if ((t += 10) > 100000) {
+				return false;
+			}
+			delay(10);
+		}
+		notefe_wr(uart, 0x20, buf[i]);
+	}
+	return true;
+}
+
+static void
+notefe_hex(const char *what, const uint8_t *b, unsigned n)
+{
+	char line[3 * 48 + 1];
+	unsigned k = 0;
+	for (unsigned i = 0; i < n && i < 48; i++) {
+		static const char hx[] = "0123456789abcdef";
+		line[k++] = hx[b[i] >> 4];
+		line[k++] = hx[b[i] & 15];
+		line[k++] = ' ';
+	}
+	line[k] = 0;
+	printf("NOTEFE BT: %s (%u bytes): %s%s\n", what, n, line, n > 48 ? "..." : "");
+}
+
+/* One HCI command, its Command Complete back (event 0x0e for this opcode); returns the event's length or 0. */
+static unsigned
+notefe_hci(vm_offset_t uart, uint16_t opcode, uint8_t *ev, unsigned max)
+{
+	uint8_t cmd[4] = { 0x01, (uint8_t)opcode, (uint8_t)(opcode >> 8), 0 };
+	if (!notefe_uart_write(uart, cmd, 4)) {
+		printf("NOTEFE BT: HCI %#06x: TX stuck (CTS low?)\n", opcode);
+		return 0;
+	}
+	unsigned n = notefe_uart_read(uart, ev, 3, 2000000, 3);
+	if (n == 3 && ev[0] == 0x04) {
+		n += notefe_uart_read(uart, ev + 3, MIN((unsigned)ev[2], max - 3), 500000, ev[2]);
+	}
+	char what[40];
+	snprintf(what, sizeof(what), "HCI %#06x ->", opcode);
+	notefe_hex(what, ev, n);
+	return n;
+}
+
+static void notefe_bt_patch(vm_offset_t uart);
+
+static void
+notefe_bt_up(int level, vm_offset_t top, vm_offset_t pins, vm_offset_t pins_i, vm_offset_t uart)
+{
+	if (level == 6) {
+		notefe_pin(pins, 0x60, 7, 1, -1, 0);
+		printf("NOTEFE BT: BT_REG_ON low (chip off)\n");
+		return;
+	}
+	uint64_t rate = notefe_bt_rate(top);
+	if (rate < 1843200 || rate > 1000000000ull) {
+		printf("NOTEFE BT: clock rate %llu Hz unusable, stopping\n", rate);
+		return;
+	}
+	for (unsigned pin = 0; pin < 4; pin++) {
+		notefe_pin(pins, 0x00, pin, 2, 3, -1);
+	}
+	notefe_wr(uart, 0x38, 0xf);                     /* UINTM: all masked */
+	notefe_wr(uart, 0x30, 0xf);                     /* UINTP: cleared */
+	notefe_wr(uart, 0x08, 0x7);                     /* UFCON: FIFO on, both reset */
+	delay(100);
+	notefe_wr(uart, 0x08, 0x1);
+	notefe_wr(uart, 0x00, 0x3);                     /* ULCON: 8N1 */
+	notefe_wr(uart, 0x0c, 0);                       /* UMCON: no flow control yet */
+	uint64_t div = rate / 115200;
+	notefe_wr(uart, 0x28, (uint32_t)(div / 16 - 1));
+	notefe_wr(uart, 0x2c, (uint32_t)(div & 15));
+	notefe_wr(uart, 0x04, 0x5 | (1u << 5));         /* UCON: RX/TX by the CPU, loopback */
+	printf("NOTEFE BT: uart1 115200 from %llu Hz: UBRDIV %u UFRACVAL %u\n", rate, (unsigned)(div / 16 - 1),
+	    (unsigned)(div & 15));
+	uint8_t out[16], in[64];
+	for (unsigned i = 0; i < 16; i++) {
+		out[i] = (uint8_t)(0xa5 ^ (i * 17));
+	}
+	bool tx = notefe_uart_write(uart, out, 16);
+	unsigned got = notefe_uart_read(uart, in, sizeof(in), 50000, 16);
+	printf("NOTEFE BT: loopback: tx %s, %u of 16 back, %s\n", tx ? "ok" : "stuck", got,
+	    got == 16 && !memcmp(in, out, 16) ? "MATCH" : "mismatch");
+	notefe_wr(uart, 0x04, 0x5);                     /* loopback off */
+	notefe_wr(uart, 0x08, 0x7);
+	delay(100);
+	notefe_wr(uart, 0x08, 0x1);
+	if (level < 4) {
+		return;
+	}
+	notefe_pin(pins_i, 0x20, 3, 1, -1, 1);          /* BT_WAKE output high */
+	notefe_pin(pins, 0x60, 7, 1, -1, 0);            /* BT_REG_ON output low */
+	delay(10000);
+	notefe_pin(pins, 0x60, 7, -1, -1, 1);           /* BT_REG_ON high */
+	delay(100000);
+	notefe_wr(uart, 0x0c, 1u << 4);                 /* UMCON: auto RTS/CTS */
+	printf("NOTEFE BT: chip powered: BT_REG_ON dat %#x, UMSTAT %#x (bit 0 = CTS)\n", notefe_rd(pins, 0x64),
+	    notefe_rd(uart, 0x1c));
+	got = notefe_uart_read(uart, in, sizeof(in), 200000, 0);
+	notefe_hex("chip said by itself", in, got);
+	if (level < 5) {
+		return;
+	}
+	uint8_t ev[260];
+	notefe_hci(uart, 0x0c03, ev, sizeof(ev));                       /* HCI_Reset */
+	unsigned n = notefe_hci(uart, 0x1001, ev, sizeof(ev));           /* Read Local Version */
+	if (n >= 15 && ev[1] == 0x0e) {
+		printf("NOTEFE BT: version: status %u hci %u rev %#x lmp %u manufacturer %#x lmp_sub %#x\n", ev[6], ev[7],
+		    ev[8] | ev[9] << 8, ev[10], ev[11] | ev[12] << 8, ev[13] | ev[14] << 8);
+	}
+	n = notefe_hci(uart, 0x0c14, ev, sizeof(ev));                    /* Read Local Name */
+	if (n > 7 && ev[1] == 0x0e) {
+		char name[64];
+		unsigned k = 0;
+		for (unsigned i = 7; i < n && k < sizeof(name) - 1 && ev[i]; i++) {
+			name[k++] = (ev[i] >= 32 && ev[i] < 127) ? (char)ev[i] : '?';
+		}
+		name[k] = 0;
+		printf("NOTEFE BT: local name \"%s\"\n", name);
+	}
+	if (level >= 7) {
+		notefe_bt_patch(uart);
+	}
+}
+
+/*
+ * Note FE (0434): Bluetooth step 4, the chip's patch. The bot writes the phone's own bcm4359C0_murata.hcd (VENDOR
+ * firmware/, put in the drop zone) to kern.notefe_bt_fw; kern.notefe_bt=7 then does steps 3-5 and sends it as Linux's
+ * btbcm.c does: Download Minidriver (0xfc2e), 50 ms, every record of the file (u16 opcode, u8 length, data) as one HCI
+ * command answered before the next (the last is Launch_RAM, 0xfc4e), 250 ms, HCI_Reset, Read Local Version / Name
+ * again: the LMP subversion and name are then the patch's. Still 115200 (about 6 s for 59 KB).
+ */
+static uint8_t *notefe_bt_fw_buf;
+static uint32_t notefe_bt_fw_len;
+
+static void
+notefe_bt_patch(vm_offset_t uart)
+{
+	uint8_t ev[260];
+	if (!notefe_bt_fw_buf || notefe_bt_fw_len < 3) {
+		printf("NOTEFE BT: no patch loaded (kern.notefe_bt_fw)\n");
+		return;
+	}
+	/* check the file first: records must end exactly at its end */
+	uint32_t at = 0, records = 0;
+	while (at + 3 <= notefe_bt_fw_len) {
+		at += 3 + notefe_bt_fw_buf[at + 2];
+		records++;
+	}
+	if (at != notefe_bt_fw_len) {
+		printf("NOTEFE BT: patch malformed (%u records, ends at %u of %u)\n", records, at, notefe_bt_fw_len);
+		return;
+	}
+	if (notefe_hci(uart, 0xfc2e, ev, sizeof(ev)) < 7 || ev[6] != 0) {
+		printf("NOTEFE BT: Download Minidriver refused\n");
+		return;
+	}
+	delay(50000);
+	uint32_t sent = 0, bad = 0;
+	for (at = 0; at + 3 <= notefe_bt_fw_len; ) {
+		uint16_t op = (uint16_t)(notefe_bt_fw_buf[at] | notefe_bt_fw_buf[at + 1] << 8);
+		uint8_t len = notefe_bt_fw_buf[at + 2];
+		uint8_t hdr = 0x01;
+		if (!notefe_uart_write(uart, &hdr, 1) || !notefe_uart_write(uart, notefe_bt_fw_buf + at, 3u + len)) {
+			printf("NOTEFE BT: patch TX stuck at record %u\n", sent);
+			return;
+		}
+		unsigned n = notefe_uart_read(uart, ev, 3, 2000000, 3);
+		if (n == 3 && ev[0] == 0x04) {
+			n += notefe_uart_read(uart, ev + 3, ev[2], 500000, ev[2]);
+		}
+		if (n < 7 || ev[1] != 0x0e || (ev[4] | ev[5] << 8) != op || ev[6] != 0) {
+			if (bad++ < 3) {
+				char what[48];
+				snprintf(what, sizeof(what), "patch record %u op %#06x ->", sent, op);
+				notefe_hex(what, ev, n);
+			}
+			if (n == 0) {
+				printf("NOTEFE BT: no answer, stopping the patch at record %u of %u\n", sent, records);
+				return;
+			}
+		}
+		at += 3u + len;
+		sent++;
+	}
+	printf("NOTEFE BT: patch sent: %u of %u records, %u odd answers\n", sent, records, bad);
+	delay(250000);
+	notefe_hci(uart, 0x0c03, ev, sizeof(ev));
+	unsigned n = notefe_hci(uart, 0x1001, ev, sizeof(ev));
+	if (n >= 15 && ev[1] == 0x0e) {
+		printf("NOTEFE BT: after patch: hci %u rev %#x lmp %u manufacturer %#x lmp_sub %#x\n", ev[7],
+		    ev[8] | ev[9] << 8, ev[10], ev[11] | ev[12] << 8, ev[13] | ev[14] << 8);
+	}
+	n = notefe_hci(uart, 0x0c14, ev, sizeof(ev));
+	if (n > 7 && ev[1] == 0x0e) {
+		char name[64];
+		unsigned k = 0;
+		for (unsigned i = 7; i < n && k < sizeof(name) - 1 && ev[i]; i++) {
+			name[k++] = (ev[i] >= 32 && ev[i] < 127) ? (char)ev[i] : '?';
+		}
+		name[k] = 0;
+		printf("NOTEFE BT: after patch: local name \"%s\"\n", name);
+	}
+}
+
+static int
+notefe_bt_fw_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
