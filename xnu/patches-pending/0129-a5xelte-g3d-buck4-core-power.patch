+
+/* GPU service runs before the early touch probe. Reuse this single HSI2C3
+ * implementation rather than racing a second controller owner. BUCK4's
+ * externally-controlled enable is left unchanged; only its voltage selector
+ * is set to the Linux-verified 900 mV OPP (400000 + 80 * 6250 uV).
+ */
+bool
+a5xelte_gpu_prepare_buck4(void)
+{
+	vm_offset_t pins, hsi;
+	uint32_t old_con, old_pud;
+	uint8_t id = 0xff, selector = 0xff, enable = 0xff, check = 0xff;
+	bool ok = false;
+	if (a5_touch_hsi) {
+		printf("A5XELTE G3D: PMIC already owned by touch; BUCK4 unchanged\n");
+		return false;
+	}
+	pins = ml_io_map(0x104e0000, 0x1000);
+	hsi = ml_io_map(0x104c0000, 0x2000);
+	if (!pins || !hsi)
+		return false;
+	old_con = a5touch_read(pins, 0);
+	old_pud = a5touch_read(pins, 8);
+	a5touch_write(pins, 8, (old_pud & ~0xfu) | 0xfu);
+	a5touch_write(pins, 0, (old_con & ~0xffu) | 0x22u);
+	delay(100);
+	a5pmic_bus_init(hsi);
+	if (!a5pmic_read(hsi, 0x00, &id) || id != 0x02 ||
+	    !a5pmic_read(hsi, 0x21, &selector) ||
+	    !a5pmic_read(hsi, 0x20, &enable)) {
+		printf("A5XELTE G3D: PMIC BUCK4 identity/read failed id=%#x\n", id);
+		goto out;
+	}
+	printf("A5XELTE G3D: BUCK4 selector=%#x (%u uV) enable=%#x\n",
+	    selector, 400000u + (unsigned)selector * 6250u, enable);
+	/* The reference regulator allows changing selector only. Do not touch
+	 * the external-enable bits or any other PMIC rail. */
+	if (selector != 0x50 && !a5pmic_write(hsi, 0x21, 0x50))
+		goto out;
+	if (!a5pmic_read(hsi, 0x21, &check) || check != 0x50) {
+		printf("A5XELTE G3D: BUCK4 900mV readback failed %#x\n", check);
+		goto out;
+	}
+	delay(1000);
+	printf("A5XELTE G3D: BUCK4 readback 900000 uV; enable unchanged\n");
+	ok = true;
+out:
+	a5touch_write(pins, 0, old_con);
+	a5touch_write(pins, 8, old_pud);
+	return ok;
 }
 
