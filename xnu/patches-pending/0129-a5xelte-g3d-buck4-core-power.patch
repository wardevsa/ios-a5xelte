+a5g3d_power_cores(IOService *service, vm_offset_t gpu, vm_offset_t cmu)
+{
+    const uint32_t mux = a5g3d_read32(cmu, 0x208);
+    const uint32_t divider = a5g3d_read32(cmu, 0x600);
+    const uint32_t shader = a5g3d_read32(gpu, 0x100);
+    const uint32_t tiler = a5g3d_read32(gpu, 0x110);
+    const uint32_t l2 = a5g3d_read32(gpu, 0x120);
+    IOLog("A5XELTE G3D: core gate mux=%08x div=%08x present shader=%08x tiler=%08x l2=%08x\n",
+        mux, divider, shader, tiler, l2);
+    /* Native Linux's first verified OPP is TOP 400 MHz / 3, 900 mV.
+     * Refuse to run if firmware left a faster or unknown core clock.
+     */
+    if ((mux & 1) != 1 || (divider & 7) < 2 ||
+        !shader || !tiler || !l2 || (l2 & (l2 - 1))) {
+        service->setProperty("A5G3DJobResult", "clock-or-core-mask-unverified");
+        return false;
+    }
+    if (!a5xelte_gpu_prepare_buck4()) {
+        service->setProperty("A5G3DJobResult", "buck4-unverified");
+        return false;
+    }
+    /* Match panfrost_gpu_power_on: L2, shader, then tiler. The domain
+     * and CMU gates were verified in a5g3d_probe_existing_power().
+     */
+    const struct { uint32_t on, ready, mask, timeout_us; } steps[] = {
+        { 0x1a0, 0x160, l2, 20000 },
+        { 0x180, 0x140, shader, 20000 },
+        { 0x190, 0x150, tiler, 1000 },
+    };
+    for (const auto &step : steps) {
+        a5g3d_write32(gpu, step.on, step.mask);
+        uint32_t ready = 0;
+        for (unsigned us = 0; us < step.timeout_us; us += 10) {
+            ready = a5g3d_read32(gpu, step.ready);
+            if ((ready & step.mask) == step.mask)
+                break;
+            IODelay(10);
+        }
+        IOLog("A5XELTE G3D: core power on=%03x mask=%08x ready=%08x\n",
+            step.on, step.mask, ready);
+        if ((ready & step.mask) != step.mask) {
+            service->setProperty("A5G3DJobResult", "core-power-timeout");
+            return false;
+        }
+    }
+    return true;
+}
