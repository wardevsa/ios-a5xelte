 	/* No CPU/thread/debugger state is required for this first panic copy. */
 	sweet_early_panic(panic_format_str, panic_args);
+	{
+		/* 0430: the same text into the persistent log (bsd/dev/herolte_ufs.c) */
+		extern void herolte_log_panic(const char *, va_list *, unsigned long);
+		herolte_log_panic(panic_format_str, panic_args, panic_caller);
+	}
 #endif
 
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
