+static bool
+a5g3d_submit_fenced(IOService *service, vm_offset_t gpu,
+    IOBufferMemoryDescriptor *storage, uint8_t *bytes, uint32_t slot,
+    uint32_t shader, bool fragment, bool scanout, uint32_t expectedColor)
+{
+    /* The ADT has no usable GPU interrupt parent yet. Keep one job in flight
+     * and use finite polling. A timed-out job retains AS0 and its pages.
+     */
+    if (!__sync_bool_compare_and_swap(&gA5G3DQueueState, 0u, 1u)) {
+        service->setProperty("A5G3DFenceResult", "queue-busy-or-halted");
+        return false;
+    }
+    const uint32_t slotBase = 0x1800 + slot * 0x80;
+    const uint32_t slotMask = (1u << slot) | (1u << (slot + 16));
+    /* Linux Panfrost: clearing an IRQ refreshes the sampled JS_STATE. */
+    a5g3d_write32(gpu, 0x1004, slotMask);
+    if ((a5g3d_read32(gpu, 0x1010) & slotMask) ||
+        a5g3d_read32(gpu, slotBase + 0x60) ||
+        a5g3d_read32(gpu, slotBase + 0x24) ||
+        (a5g3d_read32(gpu, 0x2428) & 1)) {
+        service->setProperty("A5G3DFenceResult", "slot-or-as-busy");
+        gA5G3DQueueState = 2;
+        return false;
+    }
+    const uint64_t fence = ++gA5G3DNextFence;
+    service->setProperty("A5G3DSubmittedFence", fence, 64);
+    if (storage->performOperation(kIOMemoryIncoherentIOStore, 0,
+        kA5G3DTestBytes) != kIOReturnSuccess) {
+        service->setProperty("A5G3DFenceResult", "cache-store-failed");
+        gA5G3DQueueState = 0; /* no GPU job was submitted */
+        return false;
+    }
+    __sync_synchronize();
+    a5g3d_write32(gpu, slotBase + 0x40, static_cast<uint32_t>(kA5G3DTestVA));
+    a5g3d_write32(gpu, slotBase + 0x44, 0);
+    a5g3d_write32(gpu, slotBase + 0x50, shader);
+    a5g3d_write32(gpu, slotBase + 0x54, 0);
+    a5g3d_write32(gpu, slotBase + 0x58, (8 << 16) | (3 << 8) | (3 << 12));
+    __sync_synchronize();
+    a5g3d_write32(gpu, slotBase + 0x60, 1); /* JS_COMMAND_NEXT = START */
+
+    uint32_t jobIRQ = 0, mmuIRQ = 0, gpuIRQ = 0;
+    for (unsigned i = 0; i < 20000; ++i) {
+        jobIRQ = a5g3d_read32(gpu, 0x1000);
+        mmuIRQ = a5g3d_read32(gpu, 0x2000);
+        gpuIRQ = a5g3d_read32(gpu, 0x20);
+        if ((jobIRQ & ((1u << slot) | (1u << (slot + 16)))) ||
+            mmuIRQ || (gpuIRQ & 0x81))
+            break;
+        IODelay(10);
+    }
+    const bool terminalIRQ = (jobIRQ & ((1u << slot) | (1u << (slot + 16)))) ||
+        mmuIRQ || (gpuIRQ & 0x81);
+    if (!terminalIRQ) {
+        IOLog("A5XELTE G3D: fence=%llu slot=%u timed out; AS0/pages pinned\n",
+            fence, slot);
+        service->setProperty("A5G3DFenceResult", "poll-timeout-pinned");
+        gA5G3DQueueState = 2;
+        return false;
+    }
+
+    /* A done IRQ alone is insufficient: wait for the slot to quiesce, then
+     * invalidate CPU caches and check the hardware-written job header.
+     */
+    uint32_t slotStatus = 0, pending = 0;
+    bool slotIdle = false;
+    for (unsigned i = 0; i < 1000; ++i) {
+        slotStatus = a5g3d_read32(gpu, slotBase + 0x24);
+        pending = a5g3d_read32(gpu, slotBase + 0x60);
+        if (!slotStatus && !pending) {
+            slotIdle = true;
+            break;
+        }
+        IODelay(10);
+    }
+    const uint32_t resultOffset = fragment ? kA5G3DFragmentOutputOffset :
+        kA5G3DOutputOffset;
+    const uint32_t resultLength = fragment ? kA5G3DFragmentPixels * 4 :
+        sizeof(uint64_t);
+    const bool headerFlushed = storage->performOperation(
+        kIOMemoryIncoherentIOFlush, kA5G3DDataOffset, 16) == kIOReturnSuccess;
+    const bool outputFlushed = scanout || storage->performOperation(
+        kIOMemoryIncoherentIOFlush, kA5G3DDataOffset + resultOffset,
+        resultLength) == kIOReturnSuccess;
+    __sync_synchronize();
+    const uint32_t *header = reinterpret_cast<const uint32_t *>(
+        bytes + kA5G3DDataOffset);
+    bool validOutput = false;
+    unsigned matchingPixels = 0;
+    if (fragment) {
+        if (scanout) {
+            validOutput = true; /* screen pixels require device observation */
+        } else if (outputFlushed) {
+            const uint32_t *pixels = reinterpret_cast<const uint32_t *>(
+                bytes + kA5G3DDataOffset + kA5G3DFragmentOutputOffset);
+            for (unsigned i = 0; i < kA5G3DFragmentPixels; ++i)
+                matchingPixels += pixels[i] == expectedColor;
+            validOutput = matchingPixels == kA5G3DFragmentPixels;
+        }
+    } else if (outputFlushed) {
+        const uint64_t *output = reinterpret_cast<const uint64_t *>(
+            bytes + kA5G3DDataOffset + kA5G3DOutputOffset);
+        validOutput = *output == 0;
+    }
+    if (jobIRQ)
+        a5g3d_write32(gpu, 0x1004, jobIRQ);
+    if (mmuIRQ)
+        a5g3d_write32(gpu, 0x2004, mmuIRQ);
+    const uint32_t jsState = a5g3d_read32(gpu, 0x1010);
+    const bool complete = !(jsState & slotMask) &&
+        (jobIRQ & (1u << slot)) &&
+        !(jobIRQ & (1u << (slot + 16))) && !mmuIRQ && !(gpuIRQ & 0x81) &&
+        slotIdle && headerFlushed && outputFlushed &&
+        (header[0] & 0xff) == 1 && validOutput;
+    IOLog("A5XELTE G3D: fence=%llu slot=%u irq=%08x mmu=%08x gpu=%08x js=%08x state=%08x pending=%08x header=%08x pixels=%u/256 complete=%u\n",
+        fence, slot, jobIRQ, mmuIRQ, gpuIRQ, slotStatus, jsState, pending,
+        headerFlushed ? header[0] : 0xffffffffu, matchingPixels, complete);
+    if (complete) {
+        gA5G3DCompletedFence = fence;
+        service->setProperty("A5G3DCompletedFence", fence, 64);
+        service->setProperty("A5G3DFenceResult", "completed");
+        __sync_synchronize();
+        gA5G3DQueueState = 0;
+    } else {
+        service->setProperty("A5G3DFenceResult", "fault-or-incomplete-pinned");
+        gA5G3DQueueState = 2;
+    }
+    return complete;
 }
 
